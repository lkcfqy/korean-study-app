dio/96fe52db2531c9e73e53.mp3"}],"sources":[{"entryId":"62595","senseId":"3","lemma":"있다","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"있으니","audio":"/audio/ef60efcf38deedc61094.mp3"}},{"text":"문제없어!","meaning":"没问题，不成问题，不在话下","explanation":"문제없다：没问题，不成问题，不在话下；어：非敬语句末；与熟悉的人或晚辈交谈，语调决定陈述、询问等语气。","readings":[{"term":"문제없다","audio":"/audio/4b2977f308746adaa5b6.mp3"}],"sources":[{"entryId":"56922","senseId":"1","lemma":"문제없다","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"문제없어","audio":"/audio/08f50046a310e4a2a497.mp3"}}],"words":[{"id":"6a61aed9582a5903","term":"약도","zh":"略图，简图，示意图","audio":"/audio/6a61aed9582a5903bd25.mp3","entryId":"66971","definition":"简略地只描绘重要东西的地图。","pronunciation":["약또"]},{"id":"a072ebb77d96a166","term":"자세히","zh":"仔细地，详细地","audio":"/audio/a072ebb77d96a16624a4.mp3","entryId":"71196","definition":"连很细小的部分都具体而明确地。","pronunciation":["자세히"]},{"id":"038a8038eb817ffe","term":"나오다","zh":"到，来到","audio":"/audio/038a8038eb817ffef26e.mp3","entryId":"62233","definition":"为了一定目的来某处。","pronunciation":["나오다"]},{"id":"96fe52db2531c9e7","term":"있다","zh":"某种结果状态持续着（-아/어 있다）","audio":"/audio/96fe52db2531c9e73e53.mp3","entryId":"62595","definition":"某种结果状态持续着（-아/어 있다）","pronunciation":["읻따"]},{"id":"4b2977f308746ada","term":"문제없다","zh":"没问题，不成问题，不在话下","audio":"/audio/4b2977f308746adaa5b6.mp3","entryId":"56922","definition":"没有可以成为问题的事情。","pronunciation":["문ː제업따"]}],"audio":"/audio/aecae69371ee3355c39a.mp3","speakerIndex":1}],"difficulty":2.527,"source":{"url":"https://krdict.korean.go.kr/chn/dicSearch/SearchView?ParaWordNo=66971","label":"国立国语院韩国语—汉语学习词典","license":"https://creativecommons.org/licenses/by-sa/2.0/kr/"},"sourceSenseId":"1","sourceLevel":"중급","day":86,"sequenceScore":2.3537,"questions":[{"lineIndex":0,"options":["地图上标得很详细，不会有问题的！","这是我第一次走这条路，没问题吧？","生意好，收入应该涨了吧？"],"answer":1},{"lineIndex":1,"options":["这是我第一次走这条路，没问题吧？","生意好，收入应该涨了吧？","地图上标得很详细，不会有问题的！"],"answer":2}]}
