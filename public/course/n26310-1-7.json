.mp3"}}],"words":[{"id":"b039867287707963","term":"너무","zh":"太","audio":"/audio/b0398672877079631cf2.mp3","entryId":"28183","definition":"已超过一定的程度或限度的状态。","pronunciation":["너무"]},{"id":"68de24edc341fabd","term":"힘","zh":"力量，力气","audio":"/audio/68de24edc341fabd21d4.mp3","entryId":"28633","definition":"人或动物自己运动或使其他事物移动的肌肉作用。","pronunciation":["힘"]},{"id":"1b43f195318e9604","term":"주다","zh":"加（力）、用力","audio":"/audio/1b43f195318e9604abd7.mp3","entryId":"82136","definition":"加（力）、用力","pronunciation":["주다"]},{"id":"510fc81ede633cdb","term":"글씨","zh":"字体，字迹，笔迹","audio":"/audio/510fc81ede633cdb436d.mp3","entryId":"60239","definition":"书写的字的模样。","pronunciation":["글씨"]},{"id":"e5721a077be2e027","term":"쓰다","zh":"写","audio":"/audio/e5721a077be2e027ff8c.mp3","entryId":"65172","definition":"用铅笔或其它笔等书写工具在纸张等上划线而书写一定的字。","pronunciation":["쓰다"]},{"id":"ffcedfda7558e5dc","term":"거","zh":"所说的事情、情况（것 的口语形式）","audio":"/audio/ffcedfda7558e5dc31fe.mp3","entryId":"62331","definition":"所说的事情、情况（것 的口语形式）","pronunciation":["거"]}],"audio":"/audio/3d74bff355f79bb61f06.mp3","speakerIndex":1}],"difficulty":2.871,"source":{"url":"https://krdict.korean.go.kr/chn/dicSearch/SearchView?ParaWordNo=26310","label":"国立国语院韩国语—汉语学习词典","license":"https://creativecommons.org/licenses/by-sa/2.0/kr/"},"sourceSenseId":"1","sourceLevel":"중급","day":94,"sequenceScore":2.5244,"questions":[{"lineIndex":0,"options":["该不会是你写字时用力太大了吧？","就这么随便扔纸，怎么行呢？","铅笔芯怎么老是断啊。"],"answer":2},{"lineIndex":1,"options":["该不会是你写字时用力太大了吧？","铅笔芯怎么老是断啊。","就这么随便扔纸，怎么行呢？"],"answer":0}]}
