/47a337529350ca3ed26b.mp3"}],"sources":[{"entryId":"25132","senseId":"2","lemma":"일단","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"일단","audio":"/audio/47a337529350ca3ed26b.mp3"}},{"text":"조금만","meaning":"片刻，一会儿","explanation":"조금：片刻，一会儿；만：表示“只、仅”。","readings":[{"term":"조금","audio":"/audio/b4049b7414b62d9bee5d.mp3"}],"sources":[{"entryId":"61176","senseId":"2","lemma":"조금","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"조금만","audio":"/audio/61e4375f0847dd284eb0.mp3"}},{"text":"기다리시라고","meaning":"等，等待","explanation":"기다리다：等，等待；시：主语敬语，尊敬动作或状态的主体。；라고：引用命令或名词判断；要与前后引用表达连用。","readings":[{"term":"기다리다","audio":"/audio/1f9765247406d52d5aaa.mp3"}],"sources":[{"entryId":"62264","senseId":"1","lemma":"기다리다","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"기다리시라고","audio":"/audio/df1b1680b72e41f68614.mp3"}},{"text":"해","meaning":"表示引用。","explanation":"하다：表示引用。；어：连接后续动作或辅助表达；常与前面的词干缩合。","readings":[{"term":"하다","audio":"/audio/505de0a2f6be73fa7758.mp3"}],"sources":[{"entryId":"73277","senseId":"22","lemma":"하다","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"해","audio":"/audio/b4ec4274b7799f1f17e5.mp3"}},{"text":"주세요.","meaning":"为别人做某事（-아/어 주다）","explanation":"주다：为别人做某事（-아/어 주다）；세요：包含尊敬形式的礼貌句末，可表示请求、劝告或询问等。","readings":[{"term":"주다","audio":"/audio/1b43f195318e9604abd7.mp3"}],"sources":[{"entryId":"77245","senseId":"1","lemma":"주다","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"주세요","audio":"/audio/97f2a1d4f468faba426d.mp3"}}],"words":[{"id":"47a337529350ca3e","term":"일단","zh":"暂时","audio":"/audio/47a337529350ca3ed26b.mp3","entryId":"25132","definition":"先在短时间内。","pronunciation":["일딴"]},{"id":"b4049b7414b62d9b","term":"조금","zh":"片刻，一会儿","audio":"/audio/b4049b7414b62d9bee5d.mp3","entryId":"61176","definition":"短暂时间。","pronunciation":["조금"]},{"id":"1f9765247406d52d","term":"기다리다","zh":"等，等待","audio":"/audio/1f9765247406d52d5aaa.mp3","entryId":"62264","definition":"直到人、