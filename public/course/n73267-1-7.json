ese dictionary"}],"surfaceReading":{"term":"때","audio":"/audio/43bc9c47e0f938b11288.mp3"}},{"text":"쓰려고.","meaning":"用，使用","explanation":"쓰다：用，使用；려고：非敬语地表达打算，或根据语调询问意图。","readings":[{"term":"쓰다","audio":"/audio/e5721a077be2e027ff8c.mp3"}],"sources":[{"entryId":"71285","senseId":"1","lemma":"쓰다","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"쓰려고","audio":"/audio/d44cfb66af0aa43d231e.mp3"}}],"words":[{"id":"7e3f2549e2c8bc8f","term":"벽지","zh":"壁纸，墙纸","audio":"/audio/7e3f2549e2c8bc8f122c.mp3","entryId":"58211","definition":"裱糊墙面的时候在墙上贴的纸。","pronunciation":["벽찌"]},{"id":"06c6c05757e97038","term":"새로","zh":"重新","audio":"/audio/06c6c05757e97038ad2a.mp3","entryId":"67896","definition":"与以前不同，全新地；或用新的。","pronunciation":["새로"]},{"id":"3b42ecf8717cc7fd","term":"바르다","zh":"抹，搽","audio":"/audio/3b42ecf8717cc7fd3927.mp3","entryId":"62652","definition":"把液体或粉末等置于物体表面揉擦，使其被均匀涂抹。","pronunciation":["바르다"]},{"id":"43bc9c47e0f938b1","term":"때","zh":"时机，机会","audio":"/audio/43bc9c47e0f938b11288.mp3","entryId":"74123","definition":"合适做某事的时间段。","pronunciation":["때"]},{"id":"e5721a077be2e027","term":"쓰다","zh":"用，使用","audio":"/audio/e5721a077be2e027ff8c.mp3","entryId":"71285","definition":"做某事时利用材料、工具等。","pronunciation":["쓰다"]}],"audio":"/audio/77c4af290518e4a41272.mp3","speakerIndex":1}],"difficulty":3.149,"source":{"url":"https://krdict.korean.go.kr/chn/dicSearch/SearchView?ParaWordNo=73267","label":"国立国语院韩国语—汉语学习词典","license":"https://creativecommons.org/licenses/by-sa/2.0/kr/"},"sourceSenseId":"1","sourceLevel":"중급","day":103,"sequenceScore":2.7011,"questions":[{"lineIndex":0,"options":["打算重新贴墙纸时用。","你都被敏俊影响了，变得这么差劲啊！","你用面粉熬浆糊，打算做什么？"],"answer":2},{"lineIndex":1,"options":["打算重新贴墙纸时用。","你用面粉熬浆糊，打算做什么？","你都被敏俊影响了，变得这么差劲啊！"],"answer":0}]}
