Id":"3","lemma":"있다","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"있었나요","audio":"/audio/649a44473af254104b23.mp3"}}],"words":[{"id":"b6412a92e8c6393c","term":"공지","zh":"公告，通知","audio":"/audio/b6412a92e8c6393c1018.mp3","entryId":"24119","definition":"广泛告知众人某些内容。","pronunciation":["공지"]},{"id":"108e44b6099164b1","term":"사항","zh":"事项，事宜","audio":"/audio/108e44b6099164b117f3.mp3","entryId":"61563","definition":"构成某件事或者事实的项目或内容。","pronunciation":["사ː항"]},{"id":"d14f5bfb24390ed9","term":"그런","zh":"那种，那样","audio":"/audio/d14f5bfb24390ed9c4da.mp3","entryId":"60341","definition":"状态、模样、性质等那个样子的。","pronunciation":["그런"]},{"id":"cb0f24046b508710","term":"내용","zh":"内容","audio":"/audio/cb0f24046b508710d631.mp3","entryId":"72573","definition":"言语、文章、画作、电影等的情节；或指想借此传递的信息。","pronunciation":["내ː용"]},{"id":"7998eec620b7e3cc","term":"적히다","zh":"被写下","audio":"/audio/7998eec620b7e3cc03ff.mp3","entryId":"25069","definition":"被用文字记下来。","pronunciation":["저키다"]},{"id":"96fe52db2531c9e7","term":"있다","zh":"某种结果状态持续着（-아/어 있다）","audio":"/audio/96fe52db2531c9e73e53.mp3","entryId":"62595","definition":"某种结果状态持续着（-아/어 있다）","pronunciation":["읻따"]}],"audio":"/audio/68c1ab2c7c1615b97718.mp3","speakerIndex":0},{"id":"n36978-1-9-2","ko":"아니요. 이건 회의 때 구두로만 전달된 겁니다.","zh":"没有。这是只在会议上口头传达的。","note":"点不懂的词，看本句词义、助词和语尾；听词语后，再听整句。","parts":[{"text":"아니요.","meaning":"不是，不用","explanation":"아니요：不是，不用。","readings":[{"term":"아니요","audio":"/audio/9474acc7539b7e2cedaf.mp3"}],"sources":[{"entryId":"17189","senseId":"1","lemma":"아니요","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"아니요","audio":"/audio/9474acc7539b7e2cedaf.mp3"}},{"text":"이건","meaning":"这个","explanation":"이거：这个；ㄴ：은/는 的缩略，标记话题或对比，如 난＝나는。","readings":[{"term":"이거","audio":"/audio/4515223b0fb4ed4e27bf.mp3"}],"sources":[{"entryId":"71128","senseId":"2","lemma":"이거","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"이건","audio":"/audio/5a674df42cc1d8ac9ff2.mp3"}},{"text":"회의","meaning":"会，会议","explanation":"회의：会，会议。","readings":[{"term":"회의","audio":"/audio/8ada2d6d6aa420fc4f0d.mp3"}],"sources":[{"entryId":"73244","senseId":"1","lemma":"회의","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"회의","audio":"/audio/8ada2d6d6aa420fc4f0d.mp3"}},{"text":"때","meaning":"时，时候","explanation":"때：时，时候。","readings":[{"term":"때","audio":"/audio/43bc9c47e0f938b11288.mp3"}],"sources":[{"entryId":"74123","senseId":"1","lemma":"때","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"때","audio":"/audio/43bc9c47e0f938b11288.mp3"}},{"text":"구두로만","meaning":"口头","explanation":"구두：口头；로：表示方向、方式、手段、材料、身份或原因等关系；만：表示“只、仅”。","readings":[{"term":"구두","audio":"/audio/0053d9a2905615031142.mp3"}],"sources":[{"entryId":"36978","senseId":"1","lemma":"구두","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"구두로만","audio":"/audio/28274d9ab9d0e3ca7d00.mp3"}},{"text":"전달된","meaning":"传达，转达","explanation":"전달되다：传达，转达；ㄴ：修饰后面的名词。形容词后表示当前性质；动词后通常表示已完成的动作或结果状态。","readings":[{"term":"전달되다","audio":"/audio/85630a6e8628eed724cc.mp3"}],"sources":[{"entryId":"25147","senseId":"2","lemma":"전달되다","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"전달된","audio":"/audio/be4d604a409defdeb6c2.mp3"}},{"text":"겁니다.","meaning":"表示说话人的确信、决定、决心等。","explanation":"거：表示说话人的确信、决定、决心等；이다：表示“是”的判断形式；ㅂ니다：正式礼貌的陈述句末。","readings":[{"term":"거","audio":"/audio/ffcedfda7558e5dc31fe.mp3"}],"sources":[{"entryId":"62331","senseId":"4","lemma":"거","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"겁니다","audio":"/audio/86254b469958c26e53f4.mp3"}}],"words":[{"id":"9474acc7539b7e2c","term":"아니요","zh":"不是，不用","audio":"/audio/9474acc7539b7e2cedaf.mp3","entryId":"17189","definition":"用于否定回答长辈所提出的问题。","pronunciation":["아니요"]},{"id":"4515223b0fb4ed4e","term":"이거","zh":"这个","audio":"/audio/4515223b0fb4ed4e27bf.mp3","entryId":"71128","definition":"指代就在前面已经讲过的对象。","pronunciation":["이거"]},{"id":"8ada2d6d6aa420fc","term":"회의","zh":"会，会议","audio":"/audio