:[{"entryId":"62171","senseId":"1","lemma":"보다","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"봅시다","audio":"/audio/5d12c5167c7da80d3dd8.mp3"}}],"words":[{"id":"16ebe2403bccd648","term":"이제","zh":"现在","audio":"/audio/16ebe2403bccd648e89e.mp3","entryId":"58621","definition":"说话的同时。","pronunciation":["이제"]},{"id":"3bc6235e1d18162f","term":"오늘","zh":"今天，今日","audio":"/audio/3bc6235e1d18162fb94c.mp3","entryId":"68206","definition":"现在正在度过的这一天。","pronunciation":["오늘"]},{"id":"09053ac2411bc4cd","term":"주제","zh":"主题","audio":"/audio/09053ac2411bc4cdd44c.mp3","entryId":"91771","definition":"在对话或研究等里，成中心的问题。","pronunciation":["주제"]},{"id":"4033b88da1605ad4","term":"대하다","zh":"对，对于","audio":"/audio/4033b88da1605ad4f103.mp3","entryId":"86300","definition":"当作对象或对方。","pronunciation":["대ː하다"]},{"id":"2b6b8502cede3108","term":"논하다","zh":"论，谈论，议论","audio":"/audio/2b6b8502cede31086d87.mp3","entryId":"28319","definition":"有条理地详细述说事物的道理或事情的对错。","pronunciation":["논하다"]},{"id":"6a45cf834264a5ec","term":"보다","zh":"试着做（-아/어 보다）","audio":"/audio/6a45cf834264a5ec3611.mp3","entryId":"62171","definition":"试着做（-아/어 보다）","pronunciation":["보다"]}],"audio":"/audio/73b5496a2a9127db7204.mp3","speakerIndex":0},{"id":"n28319-1-9-2","ko":"네. 제가 먼저 의견을 말씀드리겠습니다.","zh":"好的，我先来发表一下我的意见。","note":"点不懂的词，看本句词义、助词和语尾；听词语后，再听整句。","parts":[{"text":"네.","meaning":"是，行","explanation":"네：是，行","readings":[{"term":"네","audio":"/audio/1c0ddfd0050938404c35.mp3"}],"sources":[{"entryId":"17294","senseId":"2","lemma":"네","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"네","audio":"/audio/1c0ddfd0050938404c35.mp3"}},{"text":"제가","meaning":"我","explanation":"저：我；가：主格助词，标记主语。","readings":[{"term":"저","audio":"/audio/ac0e9ef613fd92c84845.mp3"}],"sources":[{"entryId":"44506","senseId":"1","lemma":"저","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"제가","audio":"/audio/c1f551b0d681d02645e2.mp3"}},{"text":"먼저","meaning":"先","explanation":"먼저：先","readings":[{"term"