7be6bf0a0810e.mp3"}],"sources":[{"entryId":"65570","senseId":"1","lemma":"버리다","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"버렸을","audio":"/audio/e31f7d0911e7bc2fc51f.mp3"}},{"text":"거야.","meaning":"表示说话人的推测或信念等。","explanation":"거：表示说话人的推测或信念等。；이다：表示“是”的判断形式。；야：非敬语判断或疑问句末，常与 이다 连用。","readings":[{"term":"거","audio":"/audio/ffcedfda7558e5dc31fe.mp3"}],"sources":[{"entryId":"62331","senseId":"5","lemma":"거","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"거야","audio":"/audio/16592c1618a6826ee403.mp3"}}],"words":[{"id":"a016b81a22708418","term":"등산길","zh":"登山路","audio":"/audio/a016b81a22708418d91d.mp3","definition":"登山时行走的道路。","pronunciation":[]},{"id":"49bb6eb34b7a66bb","term":"오가다","zh":"来去，来往","audio":"/audio/49bb6eb34b7a66bb2fcb.mp3","entryId":"62357","definition":"在街上或路上来来去去。","pronunciation":["오가다"]},{"id":"389e7564ae2551b4","term":"사람","zh":"人们，大家","audio":"/audio/389e7564ae2551b4f94d.mp3","entryId":"58161","definition":"对没有特别指定的，自己以外的人的称呼。","pronunciation":["사ː람"]},{"id":"51654377be6bf0a0","term":"버리다","zh":"扔，丢","audio":"/audio/51654377be6bf0a0810e.mp3","entryId":"65570","definition":"丢弃或倒掉没必要继续持有的东西。","pronunciation":["버리다"]},{"id":"ffcedfda7558e5dc","term":"거","zh":"表示说话人的推测或信念等。","audio":"/audio/ffcedfda7558e5dc31fe.mp3","entryId":"62331","definition":"表示说话人的推测或信念等。","pronunciation":["거"]}],"audio":"/audio/c9bbd4859f1fcf9572cc.mp3","speakerIndex":1}],"difficulty":2.117,"source":{"url":"https://krdict.korean.go.kr/chn/dicSearch/SearchView?ParaWordNo=62357","label":"国立国语院韩国语—汉语学习词典","license":"https://creativecommons.org/licenses/by-sa/2.0/kr/"},"sourceSenseId":"2","sourceLevel":"중급","day":71,"sequenceScore":1.9437,"questions":[{"lineIndex":0,"options":["应该是来来往往的登山者扔的吧。","会是谁把垃圾扔到山里的呢？","周末您一般都做些什么？"],"answer":1},{"lineIndex":1,"options":["会是谁把垃圾扔到山里的呢？","周末您一般都做些什么？","应该是来来往往的登山者扔的吧。"],"answer":2}]}
