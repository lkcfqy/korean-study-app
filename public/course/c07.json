28eecdd.mp3"}],"surfaceReading":{"term":"맵게","audio":"/audio/548af6bea5ec728eecdd.mp3"}},{"text":"해","meaning":"做","explanation":"하다（做）→ 해，与주세요组成请求。","readings":[{"term":"해","audio":"/audio/b4ec4274b7799f1f17e5.mp3"}],"surfaceReading":{"term":"해","audio":"/audio/b4ec4274b7799f1f17e5.mp3"}},{"text":"주세요.","meaning":"请帮我","explanation":"주다在-아/어 주다中表示为别人做；-세요表示礼貌请求。","readings":[{"term":"주세요","audio":"/audio/97f2a1d4f468faba426d.mp3"}],"surfaceReading":{"term":"주세요","audio":"/audio/97f2a1d4f468faba426d.mp3"}}]},{"id":"c07-5","ko":"알겠습니다. 더 필요한 건 없으세요?","zh":"好的，还需要别的吗？","note":"알겠습니다：明白了；필요하다：需要。","words":[{"term":"알다","zh":"知道","id":"4646a3463436c8a4","audio":"/audio/4646a3463436c8a43feb.mp3"},{"term":"더","zh":"再；更","id":"1e2cb79b6970d021","audio":"/audio/1e2cb79b6970d0213fd9.mp3"},{"term":"필요하다","zh":"需要","id":"b98947c9698402e3","audio":"/audio/b98947c9698402e3d07e.mp3"}],"audio":"/audio/ad7ba0901d0438161f4a.mp3","speakerIndex":0,"parts":[{"text":"알겠습니다.","meaning":"明白了","explanation":"알다（知道）+ -겠-（这里表接受、意愿）+ -습니다（正式礼貌体）。","readings":[{"term":"알다","audio":"/audio/4646a3463436c8a43feb.mp3"}],"surfaceReading":{"term":"알겠습니다","audio":"/audio/d0b5eebde68b9538543c.mp3"}},{"text":"더","meaning":"另外／再","explanation":"더表示追加。","readings":[{"term":"더","audio":"/audio/1e2cb79b6970d0213fd9.mp3"}],"surfaceReading":{"term":"더","audio":"/audio/1e2cb79b6970d0213fd9.mp3"}},{"text":"필요한","meaning":"需要的","explanation":"필요하다（需要）+ -ㄴ（定语形）。","readings":[{"term":"필요하다","audio":"/audio/b98947c9698402e3d07e.mp3"}],"surfaceReading":{"term":"필요한","audio":"/audio/801d19a8a024b12dd6e4.mp3"}},{"text":"건","meaning":"东西","explanation":"것은 → 건；것（东西）+ 은（话题）。","readings":[{"term":"건","audio":"/audio/f5fd44f22ad30ad631dc.mp3"}],"surfaceReading":{"term":"건","audio":"/audio/f5fd44f22ad30ad631dc.mp3"}},{"text":"없으세요?","meaning":"没有吗？","explanation":"없다（没有）+ -으시-（尊敬）+ -어요（礼貌体）；整句询问是否还需要别的。","readings":[{"term":"없으세요","audio":"/audio/1d06d46b4c2146953e9c.mp3"}],"surfaceReading":{"term":"없으세요","audio":"/audio/