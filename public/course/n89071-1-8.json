"/audio/f0e7b4f32898bd30a21d.mp3"}],"sources":[{"entryId":"89071","senseId":"1","lemma":"효도","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"효도를","audio":"/audio/a53c6c68f453c8350a3f.mp3"}},{"text":"다","meaning":"全，都","explanation":"다：全，都","readings":[{"term":"다","audio":"/audio/822b7db6f6886f572413.mp3"}],"sources":[{"entryId":"58175","senseId":"1","lemma":"다","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"다","audio":"/audio/822b7db6f6886f572413.mp3"}},{"text":"받아","meaning":"接受，遭受，经受，承蒙","explanation":"받다：接受，遭受，经受，承蒙；어：连接后续动作或辅助表达；常与前面的词干缩合。","readings":[{"term":"받다","audio":"/audio/5af01487318c0c571462.mp3"}],"sources":[{"entryId":"66636","senseId":"3","lemma":"받다","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"받아","audio":"/audio/0a0a7a563f5137f6e18d.mp3"}},{"text":"보는구나.","meaning":"试着做（-아/어 보다）","explanation":"보다：试着做（-아/어 보다）；는구나：对新发现或新理解的情况表示感叹，非敬语。","readings":[{"term":"보다","audio":"/audio/6a45cf834264a5ec3611.mp3"}],"sources":[{"entryId":"61190","senseId":"18","lemma":"보다","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"보는구나","audio":"/audio/e95b2f0b73d7c0b986fb.mp3"}}],"words":[{"id":"12dad67abf287f9a","term":"살다","zh":"生活，过活，过日子","audio":"/audio/12dad67abf287f9a30d4.mp3","entryId":"69579","definition":"人过生活。","pronunciation":["살ː다"]},{"id":"6a45cf834264a5ec","term":"보다","zh":"表示做了前面所指的行为后，领悟到后面所指的事实，或成为后面所指的状态。；试着做（-아/어 보다）","audio":"/audio/6a45cf834264a5ec3611.mp3","entryId":"62171","definition":"表示做了前面所指的行为后，领悟到后面所指的事实，或成为后面所指的状态。","pronunciation":["보다"]},{"id":"734dae8e9d9a8f8b","term":"너","zh":"你","audio":"/audio/734dae8e9d9a8f8b763b.mp3","entryId":"64390","definition":"指代听者，用于朋友或晚辈。","pronunciation":["너"]},{"id":"f0e7b4f32898bd30","term":"효도","zh":"孝，孝道","audio":"/audio/f0e7b4f32898bd30a21d.mp3","entryId":"89071","definition":"尽心孝顺服侍父母。","pronunciation":["효ː도"]},{"id":"822b7db6f6886f57","term":"다","zh":"全，都","audio":"/audio/822b7db6f6886f572413.mp3","entryId":"5