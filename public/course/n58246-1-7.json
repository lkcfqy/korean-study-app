tionary"}],"surfaceReading":{"term":"깜빡했어요","audio":"/audio/f9d24b1347f7c6db4f16.mp3"}},{"text":"다음부터","meaning":"以后，下次","explanation":"다음：以后，下次；부터：表示起点：“从……起”。","readings":[{"term":"다음","audio":"/audio/aef613c6612d424ab454.mp3"}],"sources":[{"entryId":"64531","senseId":"5","lemma":"다음","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"다음부터","audio":"/audio/e885d8bbb4d2a5de76a0.mp3"}},{"text":"꼭","meaning":"紧紧地用力摁或抓的样子。","explanation":"꼭：紧紧地用力摁或抓的样子。","readings":[{"term":"꼭","audio":"/audio/712da780b7ecf8b736b3.mp3"}],"sources":[{"entryId":"28297","senseId":"1","lemma":"꼭","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"꼭","audio":"/audio/712da780b7ecf8b736b3.mp3"}},{"text":"물을","meaning":"水","explanation":"물：水；을：宾格助词，标记动作对象。","readings":[{"term":"물","audio":"/audio/2e7edc957ce601f5ff7c.mp3"}],"sources":[{"entryId":"17596","senseId":"1","lemma":"물","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"물을","audio":"/audio/46ddd583ad8778f3f0de.mp3"}},{"text":"내릴게요.","meaning":"降下，拉下，垂下","explanation":"내리다：降下，拉下，垂下；ㄹ게요：向对方礼貌地表达自己的决定或承诺。","readings":[{"term":"내리다","audio":"/audio/01d776172b3f93c3c9d5.mp3"}],"sources":[{"entryId":"73353","senseId":"7","lemma":"내리다","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"내릴게요","audio":"/audio/669649d5615e1c07832d.mp3"}}],"words":[{"id":"ee75d5588acef9bd","term":"깜빡하다","zh":"忘，遗忘，忘掉","audio":"/audio/ee75d5588acef9bdc9a1.mp3","entryId":"37737","definition":"没有记住或没注意。","pronunciation":["깜빠카다"]},{"id":"aef613c6612d424a","term":"다음","zh":"以后，下次","audio":"/audio/aef613c6612d424ab454.mp3","entryId":"64531","definition":"一段时间后。","pronunciation":["다음"]},{"id":"712da780b7ecf8b7","term":"꼭","zh":"紧紧地用力摁或抓的样子。","audio":"/audio/712da780b7ecf8b736b3.mp3","entryId":"28297","definition":"紧紧地用力摁或抓的样子。","pronunciation":["꼭"]},{"id":"2e7edc957ce601f5","term":"물","zh":"水","audio":"/audio/2e7edc957ce601f5ff7c.mp3","entryId":"17596","definition":"含在河、湖、海、地下水等，纯粹的且无色无香无味的透明