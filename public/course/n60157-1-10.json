b6b.mp3"}],"sources":[{"entryId":"71365","senseId":"1","lemma":"차다","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"찼는데","audio":"/audio/68c28792b45ab0bc831e.mp3"}},{"text":"골대를","meaning":"球门柱","explanation":"골대：球门柱；를：宾格助词，标记动作对象。","readings":[{"term":"골대","audio":"/audio/382b6e2b9f914c33fa1b.mp3"}],"sources":[{"entryId":"18326","senseId":"1","lemma":"골대","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"골대를","audio":"/audio/3ef2ab4d914b09f2da1f.mp3"}},{"text":"살짝","meaning":"稍微","explanation":"살짝：稍微。","readings":[{"term":"살짝","audio":"/audio/cf17ce5604310bf9c196.mp3"}],"sources":[{"entryId":"61612","senseId":"3","lemma":"살짝","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"살짝","audio":"/audio/cf17ce5604310bf9c196.mp3"}},{"text":"빗나가서","meaning":"偏离，斜","explanation":"빗나가다：偏离，斜；어서：连接原因与结果，或前后相接的动作。","readings":[{"term":"빗나가다","audio":"/audio/8e3f896e582245d84479.mp3"}],"sources":[{"entryId":"60157","senseId":"1","lemma":"빗나가다","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"빗나가서","audio":"/audio/0f790ced3e2c856bf8dd.mp3"}},{"text":"결국","meaning":"最后，终于","explanation":"결국：最后，终于。","readings":[{"term":"결국","audio":"/audio/a1a5375588e265b035a5.mp3"}],"sources":[{"entryId":"17260","senseId":"1","lemma":"결국","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"결국","audio":"/audio/a1a5375588e265b035a5.mp3"}},{"text":"졌어.","meaning":"输","explanation":"지다：输；었：过去或完成，常与词干缩合；어：非敬语句末；与熟悉的人或晚辈交谈，语调决定陈述、询问等语气。","readings":[{"term":"지다","audio":"/audio/6fde84679c7f2c315bb0.mp3"}],"sources":[{"entryId":"63606","senseId":"1","lemma":"지다","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"졌어","audio":"/audio/ad3d3e2a5157bc68a08d.mp3"}}],"words":[{"id":"1098bbe54520ab2a","term":"나","zh":"我","audio":"/audio/1098bbe54520ab2a367c.mp3","entryId":"60931","definition":"说话人在朋友或晚辈面前用来指称自己。","pronunciation":["나"]},{"id":"8da62ef6312ba9ce","term":"마지막","zh":"最后，最终，末了","audio":