","audio":"/audio/815560dcd5b828930ac0.mp3"}],"sources":[{"entryId":"89917","senseId":"7","lemma":"없다","origin":"NIKL Korean-Chinese dictionary"}]}],"words":[{"id":"d39087dda3899d88","term":"그래","zh":"真的","audio":"/audio/d39087dda3899d88b99b.mp3","entryId":"27656","definition":"用于对对方所说的话表示感叹或轻微的惊讶。","pronunciation":["그래"]},{"id":"c65326b2de936236","term":"뒤","zh":"后，后面","audio":"/audio/c65326b2de936236c222.mp3","entryId":"67477","definition":"朝向的反方向。","pronunciation":["뒤ː"]},{"id":"1bb289b6e5d9e641","term":"아무","zh":"任何人","audio":"/audio/1bb289b6e5d9e641ff85.mp3","entryId":"71326","definition":"指代不定指的某人。","pronunciation":["아ː무"]},{"id":"815560dcd5b82893","term":"없다","zh":"不在","audio":"/audio/815560dcd5b828930ac0.mp3","entryId":"89917","definition":"人、事物、现象等不占据某处或空间。","pronunciation":["업ː따"]}],"audio":"/audio/bb58a12cdecd71bb8378.mp3","speakerIndex":1}],"difficulty":2.355,"source":{"url":"https://krdict.korean.go.kr/chn/dicSearch/SearchView?ParaWordNo=64728","label":"国立国语院韩国语—汉语学习词典","license":"https://creativecommons.org/licenses/by-sa/2.0/kr/"},"sourceSenseId":"5","sourceLevel":"중급","day":72,"sequenceScore":1.9526,"questions":[{"lineIndex":0,"options":["是吗？后面可没有人啊。","你今天看起来格外漂亮。","我觉得好像有人在一直跟在我们后面。"],"answer":2},{"lineIndex":1,"options":["是吗？后面可没有人啊。","我觉得好像有人在一直跟在我们后面。","你今天看起来格外漂亮。"],"answer":0}]}
