a7758.mp3"}],"sources":[{"entryId":"73277","senseId":"1","lemma":"하다","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"해서","audio":"/audio/91cbeb2e0a1193dc2da9.mp3"}},{"text":"봐.","meaning":"试，试图","explanation":"보다：试，试图；어：非敬语句末；与熟悉的人或晚辈交谈，语调决定陈述、询问等语气。","readings":[{"term":"보다","audio":"/audio/6a45cf834264a5ec3611.mp3"}],"sources":[{"entryId":"62171","senseId":"1","lemma":"보다","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"봐","audio":"/audio/fdcffec86114c54dd4e0.mp3"}}],"words":[{"id":"5c42cdc348b794ff","term":"발돋움","zh":"踮脚","audio":"/audio/5c42cdc348b794ffc0f4.mp3","entryId":"56607","definition":"为使身高显高或走路时不发出声音，抬起脚后跟，用脚尖点地。","pronunciation":["발도둠"]},{"id":"505de0a2f6be73fa","term":"하다","zh":"做，干","audio":"/audio/505de0a2f6be73fa7758.mp3","entryId":"73277","definition":"进行某种行动、动作或活动。","pronunciation":["하다"]},{"id":"6a45cf834264a5ec","term":"보다","zh":"试，试图","audio":"/audio/6a45cf834264a5ec3611.mp3","entryId":"62171","definition":"表示试着做前面所指的行为。","pronunciation":["보다"]}],"audio":"/audio/a0b459783da187c17890.mp3","speakerIndex":1}],"difficulty":3.149,"source":{"url":"https://krdict.korean.go.kr/chn/dicSearch/SearchView?ParaWordNo=56607","label":"国立国语院韩国语—汉语学习词典","license":"https://creativecommons.org/licenses/by-sa/2.0/kr/"},"sourceSenseId":"1","sourceLevel":"고급","day":149,"sequenceScore":2.9757,"questions":[{"lineIndex":0,"options":["你至少踮起脚来看看吧。","狗狗已经好几天没排便了。","因为前面的人，我完全看不见前面了。"],"answer":2},{"lineIndex":1,"options":["你至少踮起脚来看看吧。","因为前面的人，我完全看不见前面了。","狗狗已经好几天没排便了。"],"answer":0}]}
