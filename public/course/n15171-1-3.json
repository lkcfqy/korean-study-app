ean-Chinese dictionary"}],"surfaceReading":{"term":"힘들어야","audio":"/audio/8d93ec8025ac24600723.mp3"}},{"text":"말이지.","meaning":"意思","explanation":"말：意思；이다：表示“是”的判断形式。；지：表示确认、提醒、意愿或自问等，非敬语句末。","readings":[{"term":"말","audio":"/audio/dfbb3ea79fc80c6f3f0e.mp3"}],"sources":[{"entryId":"27260","senseId":"7","lemma":"말","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"말이지","audio":"/audio/5bfd171a130e4f49803e.mp3"}}],"words":[{"id":"dfbb3ea79fc80c6f","term":"말","zh":"话、谈起（말도 마：别提了）；意思","audio":"/audio/dfbb3ea79fc80c6f3f0e.mp3","entryId":"27260","definition":"话、谈起（말도 마：别提了）","pronunciation":["말ː"]},{"id":"f8b54c8d9bfb2043","term":"말다","zh":"不再做，停止","audio":"/audio/f8b54c8d9bfb2043a3b8.mp3","entryId":"72580","definition":"表示使无法做之前的话所指的行动。","pronunciation":["말ː다"]},{"id":"5352cc37226c44ed","term":"여간","zh":"一般地","audio":"/audio/5352cc37226c44ed8711.mp3","entryId":"15171","definition":"以普通程度。","pronunciation":["여간"]},{"id":"8eec39c3609a6c71","term":"힘들다","zh":"累，费力，费劲，辛苦，用力","audio":"/audio/8eec39c3609a6c71740f.mp3","entryId":"91737","definition":"有花费很多力气的一面。","pronunciation":["힘들다"]}],"audio":"/audio/86b0e4125dedae5f8df2.mp3","speakerIndex":1}],"difficulty":2.871,"source":{"url":"https://krdict.korean.go.kr/chn/dicSearch/SearchView?ParaWordNo=15171","label":"国立国语院韩国语—汉语学习词典","license":"https://creativecommons.org/licenses/by-sa/2.0/kr/"},"sourceSenseId":"1","sourceLevel":"중급","day":103,"sequenceScore":2.6977,"questions":[{"lineIndex":0,"options":["新开始的工作怎么样？","别提了，简直累死了。","今天去参观的展览怎么样？"],"answer":0},{"lineIndex":1,"options":["新开始的工作怎么样？","别提了，简直累死了。","今天去参观的展览怎么样？"],"answer":1}]}
