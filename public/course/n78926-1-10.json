ionary"}],"surfaceReading":{"term":"하나만","audio":"/audio/73ab833d7c0821414f30.mp3"}},{"text":"하고","meaning":"表示两个以上的并列或反复。","explanation":"하다：表示两个以上的并列或反复；고：连接并列或先后的动作、状态；也用于 -고 있다 等搭配。","readings":[{"term":"하다","audio":"/audio/505de0a2f6be73fa7758.mp3"}],"sources":[{"entryId":"73277","senseId":"26","lemma":"하다","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"하고","audio":"/audio/1a7140c02481d065b267.mp3"}},{"text":"발표를","meaning":"发表，发布","explanation":"발표：发表，发布；를：宾格助词，标记动作对象。","readings":[{"term":"발표","audio":"/audio/662fbb8d7bdeae8019f6.mp3"}],"sources":[{"entryId":"62470","senseId":"1","lemma":"발표","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"발표를","audio":"/audio/fb8eecedd8451fb146ac.mp3"}},{"text":"마치겠습니다.","meaning":"结束，完成","explanation":"마치다：结束，完成；겠：表示意愿、推测或礼貌委婉，结合整句判断；습니다：正式礼貌的陈述句末。","readings":[{"term":"마치다","audio":"/audio/48af85297dcba6b93058.mp3"}],"sources":[{"entryId":"61135","senseId":"1","lemma":"마치다","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"마치겠습니다","audio":"/audio/bc4e9e543070e3f61bc4.mp3"}}],"words":[{"id":"86f87d3fb9919f14","term":"그럼","zh":"那么，既然那样","audio":"/audio/86f87d3fb9919f145d21.mp3","entryId":"60346","definition":"用于表示接受前文内容，或以前文为基础，提出新的主张。","pronunciation":["그럼"]},{"id":"8e714baa69a0dc83","term":"짤막하다","zh":"简短，稍短","audio":"/audio/8e714baa69a0dc83e0a6.mp3","entryId":"78926","definition":"稍微有点短。","pronunciation":["짤마카다"]},{"id":"ffe0179e59e74069","term":"이야기","zh":"故事","audio":"/audio/ffe0179e59e74069bc54.mp3","entryId":"60321","definition":"说或写给别人的关于某个事实、状态、现象、经验、想法等的话或文章。","pronunciation":["이야기"]},{"id":"556dcbf069a950eb","term":"하나","zh":"一、一个","audio":"/audio/556dcbf069a950eb94f3.mp3","entryId":"20279","definition":"一、一个","pronunciation":["하나"]},{"id":"505de0a2f6be73fa","term":"하다","zh":"表示两个以上的并列或反复。","audio":"/audio/505de0a2f6be73fa7758.mp3","entryId":"73277","definition":"表示两个以上的并列或反复。","pronunciation":["하다"]},{"id":"662fbb8d7bdeae80","term":"발표","zh":"发表，发布"