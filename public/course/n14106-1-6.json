.korean.go.kr/chn/dicSearch/SearchView?ParaWordNo=14106","label":"国立国语院韩国语—汉语学习词典","license":"https://creativecommons.org/licenses/by-sa/2.0/kr/"},"sourceSenseId":"1","sourceLevel":"중급","day":91,"sequenceScore":2.4627,"questions":[{"lineIndex":0,"options":["那么现在在位的部长要辞职吗？","你没去看看父母吗？","听说宣传部的部长要换人了呢。"],"answer":2},{"lineIndex":1,"options":["那么现在在位的部长要辞职吗？","听说宣传部的部长要换人了呢。","你没去看看父母吗？"],"answer":0}]}
