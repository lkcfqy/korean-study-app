iation":["관심"]},{"id":"b30b4bf6ab97d6a5","term":"많다","zh":"多，丰富，强","audio":"/audio/b30b4bf6ab97d6a55225.mp3","entryId":"69295","definition":"数、量、程度等超过一定标准。","pronunciation":["만ː타"]}],"audio":"/audio/857466a4b01f7ad70f6d.mp3","speakerIndex":1}],"difficulty":3.11,"source":{"url":"https://krdict.korean.go.kr/chn/dicSearch/SearchView?ParaWordNo=71312","label":"国立国语院韩国语—汉语学习词典","license":"https://creativecommons.org/licenses/by-sa/2.0/kr/"},"sourceSenseId":"1","sourceLevel":"중급","day":108,"sequenceScore":2.8353,"questions":[{"lineIndex":0,"options":["谢谢。我对打扮自己很感兴趣嘛。","这里为什么禁止进入呢？","你的时尚感真不错啊。"],"answer":2},{"lineIndex":1,"options":["谢谢。我对打扮自己很感兴趣嘛。","你的时尚感真不错啊。","这里为什么禁止进入呢？"],"answer":0}]}
