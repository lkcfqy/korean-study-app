ry"}],"surfaceReading":{"term":"들었어","audio":"/audio/212b440366b02768c97f.mp3"}}],"words":[{"id":"23a9f0224cc40ec0","term":"계속","zh":"继续，持续","audio":"/audio/23a9f0224cc40ec08adb.mp3","entryId":"17692","definition":"连续不间断。","pronunciation":["계ː속","게ː속"]},{"id":"c65326b2de936236","term":"뒤","zh":"后，后面","audio":"/audio/c65326b2de936236c222.mp3","entryId":"67477","definition":"朝向的反方向。","pronunciation":["뒤ː"]},{"id":"169eb5d7a0d76e97","term":"부르다","zh":"请，叫","audio":"/audio/169eb5d7a0d76e97fa7f.mp3","entryId":"57304","definition":"请求对方过来。","pronunciation":["부르다"]},{"id":"89058d16546c1107","term":"못","zh":"不能、没能（能力或条件限制）","audio":"/audio/89058d16546c11076dd1.mp3","entryId":"17254","definition":"不会做动词所指的动作。","pronunciation":["몯ː"]},{"id":"58977b8705722edc","term":"듣다","zh":"听","audio":"/audio/58977b8705722edc164c.mp3","entryId":"74104","definition":"聆听他人的话或声音等。","pronunciation":["듣따"]}],"audio":"/audio/7f0cad5b3e06196d6503.mp3","speakerIndex":0},{"id":"n76784-1-12-2","ko":"아, 미안해. 이어폰을 꽂고 있었어.","zh":"啊，对不起。我当时戴着耳机。","note":"点不懂的词，看本句词义、助词和语尾；听词语后，再听整句。","parts":[{"text":"아,","meaning":"哦","explanation":"아：哦","readings":[{"term":"아","audio":"/audio/d6ce479be9ddc9b7de97.mp3"}],"sources":[{"entryId":"16247","senseId":"4","lemma":"아","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"아","audio":"/audio/d6ce479be9ddc9b7de97.mp3"}},{"text":"미안해.","meaning":"抱歉，愧疚，不好意思，过意不去","explanation":"미안하다：抱歉，愧疚，不好意思，过意不去；어：非敬语句末；与熟悉的人或晚辈交谈，语调决定陈述、询问等语气。","readings":[{"term":"미안하다","audio":"/audio/a3bb8e6d52d6985107bb.mp3"}],"sources":[{"entryId":"67883","senseId":"1","lemma":"미안하다","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"미안해","audio":"/audio/aacbb9c76d03aaf6939d.mp3"}},{"text":"이어폰을","meaning":"耳机","explanation":"이어폰：耳机；을：宾格助词，标记动作对象。","readings":[{"term":"이어폰","audio":"/audio/e9fdbe020b266dd328b0.mp3"}],"sources":[{"entryId":"76784","senseId":"1","lemma":"이어폰","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"이어폰을","audio