":"/audio/a95149cfdc4266f5c413.mp3"}}],"words":[{"id":"14e10e3b73bff854","term":"오빠","zh":"哥哥、大哥（女性对年长男性的亲切称呼）","audio":"/audio/14e10e3b73bff8540288.mp3","entryId":"68006","definition":"女子用于亲切地指称或称呼比自己年长的男性。","pronunciation":["오빠"]},{"id":"9ab740751e1be982","term":"언니","zh":"姐姐（女性对姐姐的称呼）","audio":"/audio/9ab740751e1be982fcd7.mp3","entryId":"31971","definition":"女子用于指称或称呼兄弟姐妹或亲戚兄弟姐妹中比自己年长的女性。","pronunciation":["언니"]},{"id":"822b7db6f6886f57","term":"다","zh":"全，都","audio":"/audio/822b7db6f6886f572413.mp3","entryId":"58175","definition":"无剩余或遗漏，所有的。","pronunciation":["다ː"]},{"id":"c9b4aed6d54a8847","term":"공부","zh":"学习，读书","audio":"/audio/c9b4aed6d54a88472fe8.mp3","entryId":"36672","definition":"通过学习学问或技术而获得知识。","pronunciation":["공부"]},{"id":"039fa50765b5cd6f","term":"잘하다","zh":"棒","audio":"/audio/039fa50765b5cd6feb79.mp3","entryId":"70073","definition":"做得好、优秀。","pronunciation":["잘하다"]},{"id":"398dfa639dfd0db8","term":"우리","zh":"我们，咱们","audio":"/audio/398dfa639dfd0db8f8e0.mp3","entryId":"17182","definition":"说话人指代自己和听话人在内的一些人。","pronunciation":["우리"]},{"id":"99cf116bb12cf106","term":"집","zh":"家","audio":"/audio/99cf116bb12cf1061e0b.mp3","entryId":"71358","definition":"组成家庭而生活的一家子。","pronunciation":["집"]},{"id":"08b35eb63efd4aaa","term":"왜","zh":"为什么","audio":"/audio/08b35eb63efd4aaae44c.mp3","entryId":"67848","definition":"因什么原因；或指怎么。","pronunciation":["왜ː"]},{"id":"1098bbe54520ab2a","term":"나","zh":"我","audio":"/audio/1098bbe54520ab2a367c.mp3","entryId":"60931","definition":"说话人在朋友或晚辈面前用来指称自己。","pronunciation":["나"]},{"id":"962ae18a075d06e2","term":"같다","zh":"那样的，类似的","audio":"/audio/962ae18a075d06e2b7fd.mp3","entryId":"62076","definition":"表示与某物属于近似的种类。","pronunciation":["갇따"]},{"id":"5cbc572c1c78b5a5","term":"돌연변이","zh":"异类，突变","audio":"/audio/5cbc572c1c78b5a52aa2.mp3","entryId":"48324","definition":"(喻义)具有与家族或自己所属集团的人完全不同性格或气质的人。","pronunciation":["도련벼니"]},{"id":"038a8038eb817ffe","term":"나오다","zh":"出现，出来","audio":"/audio/038a8038eb817ffef26e.mp3","entryId":"62233","definition":"某个东西被发现或显现。","pronunciation":["나오다"]}],"audio":"/audio/10fb0322c5592fb144a9.mp3","speakerIndex":0},{"id":"n48324-2-4-2","ko":"글쎄, 네가 노력을 안 한 건 아니고?","zh":"是吗？会不会是你没努力呢？","note":"点不懂的词，看本句词义、助词和语尾；听词语后，再听整句。","parts":[{"text":"글쎄,","meaning":"也许吧，或许吧，难说","explanation":"글쎄：也许吧，或许吧，难说","readings":[{"term":"글쎄","audio":"/audio/7ca52d3e5ceed208124e.mp3"}],"sources":[{"entryId":"29723","senseId":"1","lemma":"글쎄","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"글쎄","audio":"/audio/7ca52d3e5ceed208124e.mp3"}},{"text":"네가","meaning":"你","explanation":"너：你；가：主格助词，标记主语。","readings":[{"term":"너","audio":"/audio/734dae8e9d9a8f8b763b.mp3"}],"sources":[{"entryId":"64390","senseId":"1","lemma":"너","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"네가","audio":"/audio/3bd2d2d84b2dc14c59a4.mp3"}},{"text":"노력을","meaning":"努力，下工夫","explanation":"노력：努力，下工夫；을：宾格助词，标记动作对象。","readings":[{"term":"노력","audio":"/audio/1119b060db74766fb336.mp3"}],"sources":[{"entryId":"62400","senseId":"1","lemma":"노력","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"노력을","audio":"/audio/0643b79872abb5d81320.mp3"}},{"text":"안","meaning":"不","explanation":"안：不","readings":[{"term":"안","audio":"/audio/bc00bc8172c83d5fab70.mp3"}],"sources":[{"entryId":"71372","senseId":"1","lemma":"안","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"안","audio":"/audio/bc00bc8172c83d5fab70.mp3"}},{"text":"한","meaning":"做，干","explanation":"하다：做，干；ㄴ：修饰后面的名词。形容词后表示当前性质；动词后通常表示已完成的动作或结果状态。","readings":[{"term":"하다","audio":"/audio/505de0a2f6be73fa7758.mp3"}],"sources":[{"entryId":"73277","senseId":"1","lemma":"하다","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"한","audio":"/audio/89233692031a62c60e6e.mp3"}},{"text":"건","meaning":"某种事物、现象或事实。","explanation":"거：某种事物、现象或事实。；ㄴ：은/는 的缩略，标记话题或对比，如 난＝나는。","readings":[{"term":"거","audio":"/audio/ffcedfda7558e5dc31fe.mp3"}],"sources":[{"entryId":"62331","senseId":"1","lemma":"