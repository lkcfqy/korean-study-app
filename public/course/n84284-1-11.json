":"오다","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"왔다","audio":"/audio/cd2b82611b455e7bfb06.mp3"}}],"words":[{"id":"3bc6235e1d18162f","term":"오늘","zh":"今天，今日","audio":"/audio/3bc6235e1d18162fb94c.mp3","entryId":"68206","definition":"现在正在度过的这一天。","pronunciation":["오늘"]},{"id":"607077062c5e900a","term":"공연장","zh":"剧场，演出场地","audio":"/audio/607077062c5e900a7010.mp3","entryId":"25333","definition":"表演戏剧、歌曲、舞蹈等的地方。","pronunciation":["공연장"]},{"id":"389e7564ae2551b4","term":"사람","zh":"人们，大家","audio":"/audio/389e7564ae2551b4f94d.mp3","entryId":"58161","definition":"对没有特别指定的，自己以外的人的称呼。","pronunciation":["사ː람"]},{"id":"6f24e21fc8cce6bd","term":"정말","zh":"真的","audio":"/audio/6f24e21fc8cce6bd9e56.mp3","entryId":"61173","definition":"用于强调自己所说的话。","pronunciation":["정ː말"]},{"id":"1af2aeb1be04021c","term":"많이","zh":"多","audio":"/audio/1af2aeb1be04021c7be5.mp3","entryId":"66030","definition":"数、量、程度等超过一定标准地。","pronunciation":["마ː니"]},{"id":"6fe577b99594f4a7","term":"오다","zh":"来，来参加","audio":"/audio/6fe577b99594f4a7bd8d.mp3","entryId":"69514","definition":"为了参与某个有目的性的聚会而从另一个地方转移到这个地方。","pronunciation":["오다"]}],"audio":"/audio/b2190b78fcc095925cfe.mp3","speakerIndex":0},{"id":"n84284-1-11-2","ko":"함성 소리 때문에 바로 옆에서 무슨 얘길 하는지도 잘 모르겠어.","zh":"因为欢呼声太大，就连旁边在说些什么都听不清楚。","note":"点不懂的词，看本句词义、助词和语尾；听词语后，再听整句。","parts":[{"text":"함성","meaning":"呼喊，呼声，喊声，呼喊声","explanation":"함성：呼喊，呼声，喊声，呼喊声","readings":[{"term":"함성","audio":"/audio/2a9091016be9efc14202.mp3"}],"sources":[{"entryId":"84284","senseId":"1","lemma":"함성","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"함성","audio":"/audio/2a9091016be9efc14202.mp3"}},{"text":"소리","meaning":"声音，声，音，动静","explanation":"소리：声音，声，音，动静","readings":[{"term":"소리","audio":"/audio/d13cec79f66edb6aa0c5.mp3"}],"sources":[{"entryId":"62379","senseId":"1","lemma":"소리","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"소리","audio":"/audio/d13cec79f66edb6aa0c5.mp3"}},{"text":"때문에","meaning":"因为，由于","explanation":"때문：因为，由于；에：格助词，表示时间、位置、去向、对象等；需结合整句理解。","readings":[{"term":"때문","audio":"/audio/e7ce9cf0ec012e05cb2b.mp3"}],"sources":[{"entryId":"64555","senseId":"1","lemma":"때문","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"때문에","audio":"/audio/870904a840bc33218066.mp3"}},{"text":"바로","meaning":"就","explanation":"바로：就","readings":[{"term":"바로","audio":"/audio/a441b444c56119c0f154.mp3"}],"sources":[{"entryId":"64744","senseId":"7","lemma":"바로","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"바로","audio":"/audio/a441b444c56119c0f154.mp3"}},{"text":"옆에서","meaning":"旁，旁边","explanation":"옆：旁，旁边；에서：格助词，表示动作发生的地点或出发点。","readings":[{"term":"옆","audio":"/audio/c140e1936b454b24fb3a.mp3"}],"sources":[{"entryId":"20243","senseId":"1","lemma":"옆","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"옆에서","audio":"/audio/74f0af6347bf47b58b9e.mp3"}},{"text":"무슨","meaning":"什么","explanation":"무슨：什么","readings":[{"term":"무슨","audio":"/audio/41abb599007a8f8a3050.mp3"}],"sources":[{"entryId":"66237","senseId":"2","lemma":"무슨","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"무슨","audio":"/audio/41abb599007a8f8a3050.mp3"}},{"text":"얘길","meaning":"谈话，说话","explanation":"얘기：谈话，说话；ㄹ：을/를 的缩略，标记宾语，如 뭘＝무엇을。","readings":[{"term":"얘기","audio":"/audio/cbb7c3fe2dd88ddc7d2b.mp3"}],"sources":[{"entryId":"74194","senseId":"1","lemma":"얘기","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"얘길","audio":"/audio/d780f9428ce8f6351723.mp3"}},{"text":"하는지도","meaning":"表示说这样那样的话。","explanation":"하다：表示说这样那样的话。；는지：引入未确定的信息、间接疑问或选择：“是否、怎么、何时”等。；도：表示“也、连……也”。","readings":[{"term":"하다","audio":"/audio/505de0a2f6be73fa7758.mp3"}],"sources":[{"entryId":"73277","senseId":"28","lemma":"하다","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"하는지도","audio":"/audio/b44d57d49aec5178ee24.mp3"}},{"text":"잘","meaning":"清楚地，仔细地","explanation":"잘：清楚地，仔细地","readings":[{"term":"잘","audio":"/audio/8aff11a4aebdccdbf05d.mp3"}],"sources":[{"entryId":"58939","senseId":"2","lemma":"잘","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"잘","audio":"/audio/8aff11a4aebdccdbf05d.mp3"}},{"text":"모르겠어.","meaning":"不知道，不认识，不懂","explanation":"모르다：不知道，不认识，不懂；겠：表示意愿、推测或礼貌委婉，结合整句判断。；어：非敬语句末；与熟悉的人或晚辈交谈，语调决定陈述、询问等语气。","readings":[{"term":"모르다","audio":"/audio/20ef19694f337fd42539.mp3"}],"sources":[{"entryId":"29712","senseId":"1","lemma":"모르다","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"모르겠어","audio":"/audio/b0a5887fc79197b11412.mp3"}}],"words":[{"id":"2a9091016be9efc1","term":"함성","zh":"呼喊，呼声，喊声，呼喊声","audio":"/audio/2a9091016be9efc14202.mp3","entryId":"84284","definition":"许多人一起大声喊或叫的声音。","pronunciation":["함ː성"]},{"id":"d13cec79f66edb6a","term":"소리","zh":"声音，声，音，动静","audio":"/audio/d13cec79f66edb6aa0c5.mp3","entryId":"62379","definition":"物体震动发出的音波传入耳朵中产生的响声。","pronunciation":["소리"]},{"id":"e7ce9cf0ec012e05","term":"때문","zh":"因为，由于","audio":"/audio/e7ce9cf0ec012e05cb2b.mp3","entryId":"64555","definition":"表示原因或理由。","pronunciation":["때문"]},{"id":"a441b444c56119c0","term":"바로","zh":"就","audio":"/audio/a441b444c56119c0f154.mp3","entryId":"64744","definition":"时间上或空间上非常近地。","pronunciation":["바로"]},{"id":"c140e1936b454b24","term":"옆","zh":"旁，旁边","audio":"/audio/c140e1936b454b24fb3a.mp3","entryId":"20243","definition":"指左右两侧中的一侧。","pronunciation":["엽"]},{"id":"41abb599007a8f8a","term":"무슨","zh":"什么","audio":"/audio/41abb599007a8f8a3050.mp3","entryId":"66237","definition":"虚指，表示不肯定的事物。","pronunciation":["무슨"]},{"id":"cbb7c3fe2dd88ddc","term":"얘기","zh":"谈话，说话","audio":"/audio/cbb7c3fe2dd88ddc7d2b.mp3","entryId":"74194","definition":"向某人诉说与某事实、状态、现象、经验、想法等有关的话。","pronunciation":["얘ː기"]},{"id":"505de0a2f6be73fa","term":"하다","zh":"表示说这样那样的话。","audio":"/audio/505de0a2f6be73fa7758.mp3","entryId":"73277","definition":"表示说这样那样的话。","pronunciation":["하다"]},{"id":"8aff11a4aebdccdb","term":"잘","zh":"清楚地，仔细地","audio":"/audio/8aff11a4aebdccdbf05d.mp3","entryId":"58939","d