":["공지"]},{"id":"108e44b6099164b1","term":"사항","zh":"事项，事宜","audio":"/audio/108e44b6099164b117f3.mp3","entryId":"61563","definition":"构成某件事或者事实的项目或内容。","pronunciation":["사ː항"]},{"id":"3a939ba13b7d1af7","term":"올라오다","zh":"发布，上传","audio":"/audio/3a939ba13b7d1af7902f.mp3","entryId":"67841","definition":"在电脑网络或贴吧等上发表文章。","pronunciation":["올라오다"]}],"audio":"/audio/4e29d08e91cc5b02cfad.mp3","speakerIndex":0},{"id":"n67841-13-6-2","ko":"아니, 아직 안 올라왔어.","zh":"没有，还没贴出来呢。","note":"点不懂的词，看本句词义、助词和语尾；听词语后，再听整句。","parts":[{"text":"아니,","meaning":"不，没","explanation":"아니：不，没","readings":[{"term":"아니","audio":"/audio/bcf26f704fdac00f644a.mp3"}],"sources":[{"entryId":"65980","senseId":"1","lemma":"아니","origin":"NIKL Korean-Chinese dictionary"}]},{"text":"아직","meaning":"尚未，还，仍然","explanation":"아직：尚未，还，仍然","readings":[{"term":"아직","audio":"/audio/fc3d924ec6725c21b50b.mp3"}],"sources":[{"entryId":"71254","senseId":"1","lemma":"아직","origin":"NIKL Korean-Chinese dictionary"}]},{"text":"안","meaning":"不","explanation":"안：不","readings":[{"term":"안","audio":"/audio/bc00bc8172c83d5fab70.mp3"}],"sources":[{"entryId":"71372","senseId":"1","lemma":"안","origin":"NIKL Korean-Chinese dictionary"}]},{"text":"올라왔어.","meaning":"发布，上传","explanation":"올라오다：发布，上传；었：过去或完成，常与词干缩合。；어：非敬语句末；与熟悉的人或晚辈交谈，语调决定陈述、询问等语气。","readings":[{"term":"올라오다","audio":"/audio/3a939ba13b7d1af7902f.mp3"}],"sources":[{"entryId":"67841","senseId":"13","lemma":"올라오다","origin":"NIKL Korean-Chinese dictionary"}]}],"words":[{"id":"bcf26f704fdac00f","term":"아니","zh":"不，没","audio":"/audio/bcf26f704fdac00f644a.mp3","entryId":"65980","definition":"用于表示否定或反对。","pronunciation":["아니"]},{"id":"fc3d924ec6725c21","term":"아직","zh":"尚未，还，仍然","audio":"/audio/fc3d924ec6725c21b50b.mp3","entryId":"71254","definition":"表示某事或状态成为怎么样需要过一段时间， 或者某事或状态不结束继续不断。","pronunciation":["아직"]},{"id":"bc00bc8172c83d5f","term":"안","zh":"不","audio":"/audio/bc00bc8172c83d5fab70.mp3","entryId":"71372","definition":"表示否定或反对。","pronunciation":["안"]},{"id":"3a939ba13b7d1