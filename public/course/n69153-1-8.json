":[{"lineIndex":0,"options":["光喊饿，饭就能快点做好吗？","妈妈！我饿了！","妈妈，智秀去哪儿了？"],"answer":1},{"lineIndex":1,"options":["妈妈！我饿了！","妈妈，智秀去哪儿了？","光喊饿，饭就能快点做好吗？"],"answer":2}]}
