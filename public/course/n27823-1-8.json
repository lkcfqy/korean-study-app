Id":"1","lemma":"귀엽다","origin":"NIKL Korean-Chinese dictionary"}]}],"words":[{"id":"8bafb6b7d17ead49","term":"이","zh":"指代“这个人”。","audio":"/audio/8bafb6b7d17ead4985bf.mp3","entryId":"27527","definition":"指代“这个人”。","pronunciation":["이"]},{"id":"389e7564ae2551b4","term":"사람","zh":"人","audio":"/audio/389e7564ae2551b4f94d.mp3","entryId":"58161","definition":"可以思考，会制造并使用语言和工具、构成社会而生活的存在。","pronunciation":["사ː람"]},{"id":"69d1c530729872d3","term":"축소","zh":"缩小，缩减","audio":"/audio/69d1c530729872d39529.mp3","entryId":"27823","definition":"减少数量或把体积、规模等变小。","pronunciation":["축쏘"]},{"id":"00e9b33fa6e7c3c4","term":"모형","zh":"模型","audio":"/audio/00e9b33fa6e7c3c4c2b7.mp3","entryId":"56053","definition":"仿照实物的形状制成的物体。","pronunciation":["모형"]},{"id":"70ae9bc35b2d378b","term":"좀","zh":"一下","audio":"/audio/70ae9bc35b2d378b00ef.mp3","entryId":"75798","definition":"主要用于委婉请求或征得同意。","pronunciation":["좀"]},{"id":"6a45cf834264a5ec","term":"보다","zh":"试，试图","audio":"/audio/6a45cf834264a5ec3611.mp3","entryId":"62171","definition":"表示试着做前面所指的行为。","pronunciation":["보다"]},{"id":"79eea25f740b5721","term":"진짜","zh":"真的","audio":"/audio/79eea25f740b5721caae.mp3","entryId":"71539","definition":"没有假装或虚假而真正地。","pronunciation":["진짜"]},{"id":"f6866c147cb407d9","term":"귀엽다","zh":"可爱","audio":"/audio/f6866c147cb407d922da.mp3","entryId":"38323","definition":"看起来漂亮，或令人喜爱。","pronunciation":["귀ː엽따"]}],"audio":"/audio/5a8aba8917399d07a0e9.mp3","speakerIndex":0},{"id":"n27823-1-8-2","ko":"그러게. 여기 눈, 코, 입까지 그려 넣었어.","zh":"是啊，这里甚至还画上了眼睛、鼻子和嘴巴呢。","note":"点不懂的词，看本句词义、助词和语尾；听词语后，再听整句。","parts":[{"text":"그러게.","meaning":"就是嘛，可不嘛","explanation":"그러게：就是嘛，可不嘛","readings":[{"term":"그러게","audio":"/audio/87d7b69edce28452d447.mp3"}],"sources":[{"entryId":"36269","senseId":"1","lemma":"그러게","origin":"NIKL Korean-Chinese dictionary"}]},{"text":"여기","meaning":"这里，这儿","explanation":"여기：这里，这儿","readings":[{"term":"여기","audio":"/audio/c13089162f79c61744a9.mp3"}],"sources":[{"entryId":"17863","senseId":"1","lemma":"여기","origin":"NIKL Korean-Chinese dictionary"}]},{"text":"눈,","meaning":"眼睛","explanation":"눈：眼睛","readings":[{"term":"눈","audio":"/audio/ab1b14816087979d2143.mp3"}],"sources":[{"entryId":"72704","senseId":"1","lemma":"눈","origin":"NIKL Korean-Chinese dictionary"}]},{"text":"코,","meaning":"鼻，鼻子","explanation":"코：鼻，鼻子","readings":[{"term":"코","audio":"/audio/f4f759edb468db531ae2.mp3"}],"sources":[{"entryId":"46814","senseId":"1","lemma":"코","origin":"NIKL Korean-Chinese dictionary"}]},{"text":"입까지","meaning":"嘴，口","explanation":"입：嘴，口；까지：表示终点或范围：“到、直到、连……都”。","readings":[{"term":"입","audio":"/audio/c503f60b315f818ea268.mp3"}],"sources":[{"entryId":"62276","senseId":"1","lemma":"입","origin":"NIKL Korean-Chinese dictionary"}]},{"text":"그려","meaning":"画","explanation":"그리다：画；어：连接后续动作或辅助表达；常与前面的词干缩合。","readings":[{"term":"그리다","audio":"/audio/729cbc127a38cc4c4f21.mp3"}],"sources":[{"entryId":"57277","senseId":"1","lemma":"그리다","origin":"NIKL Korean-Chinese dictionary"}]},{"text":"넣었어.","meaning":"放进，装进","explanation":"넣다：放进，装进；었：过去或完成，常与词干缩合。；어：非敬语句末；与熟悉的人或晚辈交谈，语调决定陈述、询问等语气。","readings":[{"term":"넣다","audio":"/audio/c0bd6058bd724000a75e.mp3"}],"sources":[{"entryId":"64509","senseId":"1","lemma":"넣다","origin":"NIKL Korean-Chinese dictionary"}]}],"words":[{"id":"87d7b69edce28452","term":"그러게","zh":"就是嘛，可不嘛","audio":"/audio/87d7b69edce28452d447.mp3","entryId":"36269","definition":"用于赞成或同意对方所说的话。","pronunciation":["그러게"]},{"id":"c13089162f79c617","term":"여기","zh":"这里，这儿","audio":"/audio/c13089162f79c61744a9.mp3","entryId":"17863","definition":"指代与说话人较近的地方。","pronunciation":["여기"]},{"id":"ab1b14816087979d","term":"눈","zh":"眼睛","audio":"/audio/ab1b14816087979d2143.mp3","entryId":"72704","definition":"人或动物的一种感觉器官，位于脸部，受光线刺激后能看到物体。","pronunciation":["눈"]},{"id":"f4f759edb468db53","term":"코","zh":"鼻，鼻子","audio":"/audio/f4f759edb468db531ae2.mp3","entryId":"46814","definition":"用于呼吸、闻味儿的身体的一个部位。","pronunciation":["코"]},{"id":"c503f60b315f818e","term":"입","zh":"嘴，口","audio":"/audio/c503f60b315f818ea