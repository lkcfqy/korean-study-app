iation":["지다"]},{"id":"1b43f195318e9604","term":"주다","zh":"为别人做某事（-아/어 주다）","audio":"/audio/1b43f195318e9604abd7.mp3","entryId":"77245","definition":"为别人做某事（-아/어 주다）","pronunciation":["주다"]},{"id":"ffcedfda7558e5dc","term":"거","zh":"表示说话人的确信、决定、决心等。","audio":"/audio/ffcedfda7558e5dc31fe.mp3","entryId":"62331","definition":"表示说话人的确信、决定、决心等。","pronunciation":["거"]}],"audio":"/audio/59436e2a9d01abdddd90.mp3","speakerIndex":1}],"difficulty":2.855,"source":{"url":"https://krdict.korean.go.kr/chn/dicSearch/SearchView?ParaWordNo=37153","label":"国立国语院韩国语—汉语学习词典","license":"https://creativecommons.org/licenses/by-sa/2.0/kr/"},"sourceSenseId":"2","sourceLevel":"고급","day":137,"sequenceScore":2.6817,"questions":[{"lineIndex":0,"options":["什么手足无措，我只是让着她而已。","我是路过的旅人，能请您给我一杯水喝吗？","你为什么对女朋友就会那么手足无措呢？"],"answer":2},{"lineIndex":1,"options":["什么手足无措，我只是让着她而已。","你为什么对女朋友就会那么手足无措呢？","我是路过的旅人，能请您给我一杯水喝吗？"],"answer":0}]}
