a5ec3611.mp3"}],"sources":[{"entryId":"62249","senseId":"1","lemma":"보다","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"봐","audio":"/audio/fdcffec86114c54dd4e0.mp3"}}],"words":[{"id":"2a38de25ef5f5194","term":"아마","zh":"也许","audio":"/audio/2a38de25ef5f5194f0a9.mp3","entryId":"71248","definition":"虽然不能说得很明确，猜测或估计很有可能地。","pronunciation":["아마"]},{"id":"ac0e9ef613fd92c8","term":"저","zh":"那","audio":"/audio/ac0e9ef613fd92c84845.mp3","entryId":"71215","definition":"用于指示与话者、听者离得很远的对象。","pronunciation":["저"]},{"id":"b294b251f77dfbc5","term":"나무","zh":"树，树木","audio":"/audio/b294b251f77dfbc5ede4.mp3","entryId":"32750","definition":"拥有坚硬的茎杆，上面长有枝叶的多年生植物。","pronunciation":["나무"]},{"id":"3fa18e9b7894d25b","term":"둥지","zh":"鸟巢，鸟窝","audio":"/audio/3fa18e9b7894d25ba71c.mp3","entryId":"14968","definition":"鸟类为了下蛋或栖身而用草、树枝等编制的圆形住处。","pronunciation":["둥지"]},{"id":"96fe52db2531c9e7","term":"있다","zh":"有","audio":"/audio/96fe52db2531c9e73e53.mp3","entryId":"68797","definition":"人或动物、物体等存在的状态。","pronunciation":["읻따"]},{"id":"6a45cf834264a5ec","term":"보다","zh":"看来、好像（根据情况推测）","audio":"/audio/6a45cf834264a5ec3611.mp3","entryId":"62249","definition":"看来、好像（根据情况推测）","pronunciation":["보다"]}],"audio":"/audio/ee261f2973c8360835c3.mp3","speakerIndex":1}],"difficulty":3.125,"source":{"url":"https://krdict.korean.go.kr/chn/dicSearch/SearchView?ParaWordNo=18913","label":"国立国语院韩国语—汉语学习词典","license":"https://creativecommons.org/licenses/by-sa/2.0/kr/"},"sourceSenseId":"2","sourceLevel":"고급","day":148,"sequenceScore":2.9517,"questions":[{"lineIndex":0,"options":["大概那棵树上有个鸟巢吧。","谁是班长啊？","鸟儿们一直在绕着树飞，画着圈儿呢。"],"answer":2},{"lineIndex":1,"options":["大概那棵树上有个鸟巢吧。","鸟儿们一直在绕着树飞，画着圈儿呢。","谁是班长啊？"],"answer":0}]}
