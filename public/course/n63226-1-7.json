88472fe8.mp3"}},{"text":"안","meaning":"不","explanation":"안：不","readings":[{"term":"안","audio":"/audio/bc00bc8172c83d5fab70.mp3"}],"sources":[{"entryId":"71372","senseId":"1","lemma":"안","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"안","audio":"/audio/bc00bc8172c83d5fab70.mp3"}},{"text":"하는","meaning":"做，干","explanation":"하다：做，干；-는：将前面的动作或状态转为修饰名词的形式。","readings":[{"term":"하다","audio":"/audio/505de0a2f6be73fa7758.mp3"}],"sources":[{"entryId":"73277","senseId":"1","lemma":"하다","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"하는","audio":"/audio/db405bc1ba8346522533.mp3"}},{"text":"애는","meaning":"孩子，小孩","explanation":"애：孩子，小孩；는：话题或对比助词。","readings":[{"term":"애","audio":"/audio/a9fee06ad11f5bbdb2f7.mp3"}],"sources":[{"entryId":"73967","senseId":"1","lemma":"애","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"애는","audio":"/audio/b5c8498cffe7d9d5aba6.mp3"}},{"text":"생전","meaning":"生来，从来","explanation":"생전：生来，从来","readings":[{"term":"생전","audio":"/audio/ce30661ad0776d65307b.mp3"}],"sources":[{"entryId":"63226","senseId":"1","lemma":"생전","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"생전","audio":"/audio/ce30661ad0776d65307b.mp3"}},{"text":"처음이야.","meaning":"第一次，初次","explanation":"처음：第一次，初次；이다：表示“是”的判断形式。；야：非敬语判断或疑问句末，常与 이다 连用。","readings":[{"term":"처음","audio":"/audio/91390eadfad43d09c458.mp3"}],"sources":[{"entryId":"17170","senseId":"1","lemma":"처음","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"처음이야","audio":"/audio/958de10525bc114ac66c.mp3"}}],"words":[{"id":"1e07b94ba5182a41","term":"내일","zh":"明天，明日","audio":"/audio/1e07b94ba5182a41e7de.mp3","entryId":"30193","definition":"今天的下一天。","pronunciation":["내일"]},{"id":"ff65dc582ce71198","term":"시험","zh":"考试","audio":"/audio/ff65dc582ce71198934b.mp3","entryId":"20233","definition":"按照问题、提问、实际行动等一定程序考核考生的知识或能力的事宜。","pronunciation":["시험"]},{"id":"41abb599007a8f8a","term":"무슨","zh":"什么","audio":"/audio/41abb599007a8f8a3