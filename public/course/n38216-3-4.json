0a7e3f16.mp3"}],"sources":[{"entryId":"28030","senseId":"1","lemma":"사진","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"사진이라","audio":"/audio/af124ff392029eef360a.mp3"}},{"text":"자꾸","meaning":"一直，总是","explanation":"자꾸：一直，总是","readings":[{"term":"자꾸","audio":"/audio/d28ff63a0382ce4fce6d.mp3"}],"sources":[{"entryId":"70796","senseId":"1","lemma":"자꾸","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"자꾸","audio":"/audio/d28ff63a0382ce4fce6d.mp3"}},{"text":"시선이","meaning":"目光","explanation":"시선：目光；이：主格助词，标记主语。","readings":[{"term":"시선","audio":"/audio/e13568f722a5e0b607d4.mp3"}],"sources":[{"entryId":"13965","senseId":"2","lemma":"시선","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"시선이","audio":"/audio/bf05ce566e2aca64dea9.mp3"}},{"text":"꽂히네요.","meaning":"盯，注视","explanation":"꽂히다：盯，注视；네요：对新发现的情况表示感叹或确认，礼貌句末。","readings":[{"term":"꽂히다","audio":"/audio/19dc390ad89db92c17b5.mp3"}],"sources":[{"entryId":"38216","senseId":"3","lemma":"꽂히다","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"꽂히네요","audio":"/audio/5d2763f014d7e2762a31.mp3"}}],"words":[{"id":"af4870c15b98485b","term":"아버지","zh":"父亲，爸爸","audio":"/audio/af4870c15b98485bf462.mp3","entryId":"71343","definition":"用于指称或称呼生育自己的男子。","pronunciation":["아버지"]},{"id":"e1e4a89817058245","term":"찍다","zh":"拍，拍摄","audio":"/audio/e1e4a898170582452675.mp3","entryId":"63320","definition":"用照相机照射某个物品，把其样子移动到胶片上。","pronunciation":["찍따"]},{"id":"1b43f195318e9604","term":"주다","zh":"为别人做某事（-아/어 주다）","audio":"/audio/1b43f195318e9604abd7.mp3","entryId":"77245","definition":"为别人做某事（-아/어 주다）","pronunciation":["주다"]},{"id":"1f872b5045690a7e","term":"사진","zh":"照片，相片","audio":"/audio/1f872b5045690a7e3f16.mp3","entryId":"28030","definition":"为将事物的样子长久保存下来而用照相机拍下后在纸或电脑等上显现出的影像。","pronunciation":["사진"]},{"id":"d28ff63a0382ce4f","term":"자꾸","zh":"一直，总是","audio":"/audio/d28ff63a0382ce4fce6d.mp3","entryId":"70796","definition":"多次连续地。","pronunciation":["자꾸"]},{"id