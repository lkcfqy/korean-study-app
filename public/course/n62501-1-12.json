inese dictionary"}],"surfaceReading":{"term":"어디서","audio":"/audio/2239e13aeeae3639dd35.mp3"}},{"text":"이렇게","meaning":"这样","explanation":"이렇다：这样；게：使前面的动作或状态修饰后文，也用于 -게 되다、-게 하다 等搭配。","readings":[{"term":"이렇다","audio":"/audio/c2f95cfd19c5a89b2cd1.mp3"}],"sources":[{"entryId":"71157","senseId":"1","lemma":"이렇다","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"이렇게","audio":"/audio/9a767a1c9118d82c3af9.mp3"}},{"text":"상처가","meaning":"伤口，伤","explanation":"상처：伤口，伤；가：主格助词，标记主语。","readings":[{"term":"상처","audio":"/audio/005223fd14eafcaf1ee3.mp3"}],"sources":[{"entryId":"62979","senseId":"1","lemma":"상처","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"상처가","audio":"/audio/3ea744d1ff0e11e81dc6.mp3"}},{"text":"났니?","meaning":"发生","explanation":"나다：发生；었：过去或完成，常与词干缩合；니：非敬语疑问句末，用于亲近的人、晚辈或自问。","readings":[{"term":"나다","audio":"/audio/1a06e246c5fb49e2814c.mp3"}],"sources":[{"entryId":"62210","senseId":"7","lemma":"나다","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"났니","audio":"/audio/76360aadecc7f0e103c3.mp3"}}],"words":[{"id":"734dae8e9d9a8f8b","term":"너","zh":"你","audio":"/audio/734dae8e9d9a8f8b763b.mp3","entryId":"64390","definition":"指代听者，用于朋友或晚辈。","pronunciation":["너"]},{"id":"44adfe36e1f5e4fe","term":"고개","zh":"头，脑袋","audio":"/audio/44adfe36e1f5e4fe0260.mp3","entryId":"62501","definition":"包括脖子在内的头部。","pronunciation":["고개"]},{"id":"70ae9bc35b2d378b","term":"좀","zh":"一下","audio":"/audio/70ae9bc35b2d378b00ef.mp3","entryId":"75798","definition":"主要用于委婉请求或征得同意。","pronunciation":["좀"]},{"id":"7ff37822e89462ea","term":"들다","zh":"提，拿","audio":"/audio/7ff37822e89462ea5014.mp3","entryId":"57293","definition":"将下面的东西往上拎。","pronunciation":["들다"]},{"id":"6a45cf834264a5ec","term":"보다","zh":"试着做（-아/어 보다）","audio":"/audio/6a45cf834264a5ec3611.mp3","entryId":"62171","definition":"试着做（-아/어 보다）","pronunciation":["보다"]},{"id":"c1ee1b7e560f9f3a","term":"어디","zh":"哪里，哪儿","audio":"/audio/c1ee1b7e560f9f3ac3bf.mp3","entryId":"60319",