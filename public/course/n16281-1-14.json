unciation":["풍경"]},{"id":"dc76f888ddfaef28","term":"아주","zh":"非常，极其，很","audio":"/audio/dc76f888ddfaef286adb.mp3","entryId":"72484","definition":"表示程度相当高，远远超出了一般程度。","pronunciation":["아주"]},{"id":"61d5c0f0fef18581","term":"인상적","zh":"印象深刻的，难忘的","audio":"/audio/61d5c0f0fef18581a7a1.mp3","entryId":"25102","definition":"忘不掉某些感觉或印象，一直记着。","pronunciation":["인상적"]}],"audio":"/audio/24fd1d0bfde8668fcbc2.mp3","speakerIndex":1}],"difficulty":2.238,"source":{"url":"https://krdict.korean.go.kr/chn/dicSearch/SearchView?ParaWordNo=16281","label":"国立国语院韩国语—汉语学习词典","license":"https://creativecommons.org/licenses/by-sa/2.0/kr/"},"sourceSenseId":"1","sourceLevel":"중급","day":74,"sequenceScore":2.0647,"questions":[{"lineIndex":0,"options":["嗯，一望无际的海景真的非常令人印象深刻。","这次旅行还愉快吗？","现在新来的学生也会被灌酒吗？"],"answer":1},{"lineIndex":1,"options":["这次旅行还顺利吗？","现在新来的学生也会被灌酒吗？","嗯，一望无际的海景真的非常令人印象深刻。"],"answer":2}]}
