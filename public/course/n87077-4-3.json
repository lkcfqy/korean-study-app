fdd01bd86a193dbd13e5.mp3"}},{"text":"환히","meaning":"清秀地，水灵地，白净地","explanation":"환히：清秀地，水灵地，白净地","readings":[{"term":"환히","audio":"/audio/df8bb1fbafce9847472c.mp3"}],"sources":[{"entryId":"87077","senseId":"4","lemma":"환히","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"환히","audio":"/audio/df8bb1fbafce9847472c.mp3"}},{"text":"잘생겼어.","meaning":"好看，漂亮，英俊","explanation":"잘생기다：好看，漂亮，英俊；었：过去或完成，常与词干缩合。；어：非敬语句末；与熟悉的人或晚辈交谈，语调决定陈述、询问等语气。","readings":[{"term":"잘생기다","audio":"/audio/c56f4bd1fb4139c5b3d2.mp3"}],"sources":[{"entryId":"24881","senseId":"1","lemma":"잘생기다","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"잘생겼어","audio":"/audio/b67cd7f673ac664f4916.mp3"}}],"words":[{"id":"1098bbe54520ab2a","term":"나","zh":"我","audio":"/audio/1098bbe54520ab2a367c.mp3","entryId":"60931","definition":"说话人在朋友或晚辈面前用来指称自己。","pronunciation":["나"]},{"id":"6a45cf834264a5ec","term":"보다","zh":"看，看待","audio":"/audio/6a45cf834264a5ec3611.mp3","entryId":"61190","definition":"认识并判断事件或情况。","pronunciation":["보다"]},{"id":"df8bb1fbafce9847","term":"환히","zh":"清秀地，水灵地，白净地","audio":"/audio/df8bb1fbafce9847472c.mp3","entryId":"87077","definition":"面容干净俊俏，好看地。","pronunciation":["환ː히"]},{"id":"c56f4bd1fb4139c5","term":"잘생기다","zh":"好看，漂亮，英俊","audio":"/audio/c56f4bd1fb4139c5b3d2.mp3","entryId":"24881","definition":"人的容貌出众。","pronunciation":["잘생기다"]}],"audio":"/audio/3d4cbfb6708b5724bbc9.mp3","speakerIndex":1}],"difficulty":2.676,"source":{"url":"https://krdict.korean.go.kr/chn/dicSearch/SearchView?ParaWordNo=87077","label":"国立国语院韩国语—汉语学习词典","license":"https://creativecommons.org/licenses/by-sa/2.0/kr/"},"sourceSenseId":"4","sourceLevel":"고급","day":132,"sequenceScore":2.5027,"questions":[{"lineIndex":0,"options":["就算我来看，也觉得他长得非常英俊。","因为是自己的儿子，长得可真帅啊。","雪越下越大了。"],"answer":1},{"lineIndex":1,"options":["因为是自己的儿子，长得可真帅啊。","雪越下越大了。","就算我来看，也觉得他长得非常英俊。"],"answer":2}]}
