=63509","label":"国立国语院韩国语—汉语学习词典","license":"https://creativecommons.org/licenses/by-sa/2.0/kr/"},"sourceSenseId":"3","sourceLevel":"중급","day":88,"sequenceScore":2.4137,"questions":[{"lineIndex":0,"options":["明天要去看棒球比赛吧？","对啊。已经很期待明天那场比赛的结果了。","那件事最后怎么样了？"],"answer":0},{"lineIndex":1,"options":["明天要去看棒球比赛吧？","对啊。已经很期待明天那场比赛的结果了。","那件事最后怎么样了？"],"answer":1}]}
