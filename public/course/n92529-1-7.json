n-Chinese dictionary"}]},{"text":"같이","meaning":"一起，一同","explanation":"같이：一起，一同","readings":[{"term":"같이","audio":"/audio/d44da011993f2a6e9ba5.mp3"}],"sources":[{"entryId":"26799","senseId":"1","lemma":"같이","origin":"NIKL Korean-Chinese dictionary"}]},{"text":"여행을","meaning":"旅行，旅游","explanation":"여행：旅行，旅游；을：宾格助词，标记动作对象。","readings":[{"term":"여행","audio":"/audio/b5d87b0a7b5d6b82f2a8.mp3"}],"sources":[{"entryId":"28026","senseId":"1","lemma":"여행","origin":"NIKL Korean-Chinese dictionary"}]},{"text":"갈","meaning":"去，上","explanation":"가다：去，上；ㄹ：修饰后面的名词，表示预定、意向、推测或可能；具体含义取决于后接表达。","readings":[{"term":"가다","audio":"/audio/233cb510410b09d69cdc.mp3"}],"sources":[{"entryId":"27500","senseId":"6","lemma":"가다","origin":"NIKL Korean-Chinese dictionary"}]},{"text":"거래.","meaning":"表示说话人的推测或信念等。","explanation":"거：表示说话人的推测或信念等。；이다：表示“是”的判断形式。；래：口语中转述听来的话，非敬语。","readings":[{"term":"거","audio":"/audio/ffcedfda7558e5dc31fe.mp3"}],"sources":[{"entryId":"62331","senseId":"5","lemma":"거","origin":"NIKL Korean-Chinese dictionary"}]}],"words":[{"id":"107dd01c3d38a368","term":"응","zh":"是，行","audio":"/audio/107dd01c3d38a368ad44.mp3","entryId":"30205","definition":"用于肯定回答对方所提出的问题或命令等。","pronunciation":["응"]},{"id":"b5d87b0a7b5d6b82","term":"여행","zh":"旅行，旅游","audio":"/audio/b5d87b0a7b5d6b82f2a8.mp3","entryId":"28026","definition":"离开家，去其他地区或国外游玩的行为。","pronunciation":["여행"]},{"id":"e5fc8350e1fcc9ef","term":"계","zh":"契，互助会","audio":"/audio/e5fc8350e1fcc9ef8a9f.mp3","entryId":"92529","definition":"从古至今为了在经济上互相帮助或增进和睦而建立的组织。","pronunciation":["계:","게:"]},{"id":"3c159cf2a6420ca9","term":"만들다","zh":"建立，组建","audio":"/audio/3c159cf2a6420ca9bda5.mp3","entryId":"60317","definition":"组织机关或团体。","pronunciation":["만들다"]},{"id":"a5d79d1c30059080","term":"돈","zh":"钱，钱财","audio":"/audio/a5d79d1c3005908084a4.mp3","entryId":"17204","definition":"财物或财产。","pronunciation":["돈ː"]},{"id":"5ddf1bf1c10eabe3","term":"모으다","zh":"积攒，储存，积蓄","audio":"/audio/5ddf1bf1c10eabe3cc6f.mp3","entryId":"74137","definition":"不花掉钱财等，而