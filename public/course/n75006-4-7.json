:"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"예전만큼은","audio":"/audio/f6ca2c7e4b4c170b59aa.mp3"}},{"text":"벌지","meaning":"赚，挣","explanation":"벌다：赚，挣；지：连接后续表达，可形成对照；与 않다、못하다、말다 等合用时表示否定、不能或禁止。","readings":[{"term":"벌다","audio":"/audio/0c2e9654aebad7fa3ddc.mp3"}],"sources":[{"entryId":"59096","senseId":"1","lemma":"벌다","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"벌지","audio":"/audio/131c72112d48b9ec178b.mp3"}},{"text":"못해요.","meaning":"不，未能","explanation":"못하다：不，未能；어요：礼貌句末；可随语调表示陈述或询问。","readings":[{"term":"못하다","audio":"/audio/641e1150cc79b5b24a33.mp3"}],"sources":[{"entryId":"26841","senseId":"1","lemma":"못하다","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"못해요","audio":"/audio/90aab492af74192aeeba.mp3"}}],"words":[{"id":"b6013caa74979f40","term":"글쎄요","zh":"也许吧，或许吧，难说","audio":"/audio/b6013caa74979f40ee06.mp3","entryId":"60633","definition":"对于对方所提出的问题或要求，表现出不确定的态度。","pronunciation":["글쎄요"]},{"id":"b46fa208d9de21d2","term":"시장","zh":"市场","audio":"/audio/b46fa208d9de21d2daf1.mp3","entryId":"17193","definition":"进行商品、财富、服务等交易的抽象领域。","pronunciation":["시ː장"]},{"id":"a5d79d1c30059080","term":"돈","zh":"钱，钱财","audio":"/audio/a5d79d1c3005908084a4.mp3","entryId":"17204","definition":"财物或财产。","pronunciation":["돈ː"]},{"id":"8aff11a4aebdccdb","term":"잘","zh":"好好地，顺利地","audio":"/audio/8aff11a4aebdccdbf05d.mp3","entryId":"58939","definition":"没有任何问题而舒服地。","pronunciation":["잘"]},{"id":"2dc53ba2c5ff682d","term":"돌다","zh":"周转","audio":"/audio/2dc53ba2c5ff682d012f.mp3","entryId":"75006","definition":"钱款或物资等流通。","pronunciation":["돌ː다"]},{"id":"641e1150cc79b5b2","term":"못하다","zh":"不，未能","audio":"/audio/641e1150cc79b5b24a33.mp3","entryId":"26841","definition":"表示无法到达之前的话所指的状态。","pronunciation":["모ː타다"]},{"id":"75497dc0562cdf68","term":"예전","zh":"很久以前","audio":"/audio/75497dc0562cdf68c50d.mp3","entryId":"70090","definition":"过去很久的往日。","pronunciation":["예ː전"]},{"id":"0c2e9654aebad7fa","term":"벌다","zh":"赚，挣","audio":"/audio/0c2