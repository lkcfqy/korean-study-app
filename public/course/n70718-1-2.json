o/063c1a7bb93233dcd205.mp3","entryId":"66318","definition":"物品的价格或做某事所花的费用高于一般水平。","pronunciation":["비싸다"]}],"audio":"/audio/e1a1111f3febb577f554.mp3","speakerIndex":1}],"difficulty":1.44,"source":{"url":"https://krdict.korean.go.kr/chn/dicSearch/SearchView?ParaWordNo=70718","label":"国立国语院韩国语—汉语学习词典","license":"https://creativecommons.org/licenses/by-sa/2.0/kr/"},"sourceSenseId":"1","sourceLevel":"초급","day":27,"sequenceScore":1.1653,"questions":[{"lineIndex":0,"options":["不过价格实在太贵了。","我们之前一起去的那家餐厅很不错呢。","我们今天放学后去操场玩吧。"],"answer":1},{"lineIndex":1,"options":["我们之前一起去的那家餐厅很不错呢。","我们今天放学后去操场玩吧。","不过价格实在太贵了。"],"answer":2}]}
