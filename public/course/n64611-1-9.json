79df5fd3b4c0.mp3"}],"sources":[{"entryId":"28352","senseId":"1","lemma":"다이어트","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"다이어트에는","audio":"/audio/7985b056d9f816834cc8.mp3"}},{"text":"수영이","meaning":"游泳","explanation":"수영：游泳；이：主格助词，标记主语。","readings":[{"term":"수영","audio":"/audio/a2fcc3f1c53a37caae9b.mp3"}],"sources":[{"entryId":"64611","senseId":"1","lemma":"수영","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"수영이","audio":"/audio/36a11b1cd53e531bd744.mp3"}},{"text":"최고야.","meaning":"最；最佳","explanation":"최고：最；最佳；이다：表示“是”的判断形式；야：非敬语判断或疑问句末，常与 이다 连用。","readings":[{"term":"최고","audio":"/audio/97b8be84b3d009c4b9b1.mp3"}],"sources":[{"entryId":"47976","senseId":"1","lemma":"최고","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"최고야","audio":"/audio/f7e2c2e51ce08afcd4bb.mp3"}}],"words":[{"id":"5998c9b179df5fd3","term":"다이어트","zh":"节食，减肥","audio":"/audio/5998c9b179df5fd3b4c0.mp3","entryId":"28352","definition":"为了健康或美容而调节饮食种类和量。","pronunciation":[]},{"id":"a2fcc3f1c53a37ca","term":"수영","zh":"游泳","audio":"/audio/a2fcc3f1c53a37caae9b.mp3","entryId":"64611","definition":"在水中游行。","pronunciation":["수영"]},{"id":"97b8be84b3d009c4","term":"최고","zh":"最；最佳","audio":"/audio/97b8be84b3d009c4b9b1.mp3","entryId":"47976","definition":"最好或最出色的。","pronunciation":["최ː고","췌ː고"]}],"audio":"/audio/6a57e5b1ad6a266a2a0b.mp3","speakerIndex":1}],"difficulty":1.94,"source":{"url":"https://krdict.korean.go.kr/chn/dicSearch/SearchView?ParaWordNo=64611","label":"国立国语院韩国语—汉语学习词典","license":"https://creativecommons.org/licenses/by-sa/2.0/kr/"},"sourceSenseId":"1","sourceLevel":"초급","day":33,"sequenceScore":1.4535,"questions":[{"lineIndex":0,"options":["游泳是减肥的最佳选择哦。","我得减肥了，有什么好方法吗？","那个橘子的味道怎么样？"],"answer":1},{"lineIndex":1,"options":["我得减肥了，有什么好方法吗？","那个橘子的味道怎么样？","游泳是减肥的最佳选择哦。"],"answer":2}]}
