tionary"}],"surfaceReading":{"term":"잊은","audio":"/audio/940dd717091fc11e2c11.mp3"}},{"text":"것","meaning":"表示某种行为、状态或事情。","explanation":"것：表示某种行为、状态或事情。","readings":[{"term":"것","audio":"/audio/1443a6c090b122289ad7.mp3"}],"sources":[{"entryId":"62835","senseId":"4","lemma":"것","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"것","audio":"/audio/1443a6c090b122289ad7.mp3"}},{"text":"같지?","meaning":"好像，可能","explanation":"같다：好像，可能；지：表示确认、提醒、意愿或自问等，非敬语句末。","readings":[{"term":"같다","audio":"/audio/962ae18a075d06e2b7fd.mp3"}],"sources":[{"entryId":"62076","senseId":"8","lemma":"같다","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"같지","audio":"/audio/e4d091a1a3887ffa8533.mp3"}}],"words":[{"id":"fc3d924ec6725c21","term":"아직","zh":"尚未，还，仍然","audio":"/audio/fc3d924ec6725c21b50b.mp3","entryId":"71254","definition":"表示某事或状态成为怎么样需要过一段时间， 或者某事或状态不结束继续不断。","pronunciation":["아직"]},{"id":"55df2acaad2147f2","term":"헤어지다","zh":"分手，分开，走开","audio":"/audio/55df2acaad2147f202aa.mp3","entryId":"58271","definition":"和亲近的人切断关系。","pronunciation":["헤어지다"]},{"id":"97aae2f9eae59ad1","term":"애인","zh":"爱人","audio":"/audio/97aae2f9eae59ad11035.mp3","entryId":"73134","definition":"男女之间相爱的人。","pronunciation":["애ː인"]},{"id":"89058d16546c1107","term":"못","zh":"不会做动词所指的动作。","audio":"/audio/89058d16546c11076dd1.mp3","entryId":"17254","definition":"不会做动词所指的动作。","pronunciation":["몯ː"]},{"id":"b0566314f635fe32","term":"잊다","zh":"忘，忘记，忘却","audio":"/audio/b0566314f635fe32e273.mp3","entryId":"70067","definition":"本来知道的事情记不住或记不起来。","pronunciation":["읻따"]},{"id":"1443a6c090b12228","term":"것","zh":"表示某种行为、状态或事情。","audio":"/audio/1443a6c090b122289ad7.mp3","entryId":"62835","definition":"表示某种行为、状态或事情。","pronunciation":["걷"]},{"id":"962ae18a075d06e2","term":"같다","zh":"好像，可能","audio":"/audio/962ae18a075d06e2b7fd.mp3","entryId":"62076","definition":"推测出结果。","pronunciation":["갇따"]}],"audio":"/audio/bc9b5ad6609d37bf1ecf.mp3","speakerIndex":0},{"id":"n56190-1-7-2","ko":"응, 저번에도 그 