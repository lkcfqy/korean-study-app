1","lemma":"주제","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"주제를","audio":"/audio/2ebcb1b40fd53af39286.mp3"}},{"text":"정해도","meaning":"定，选定","explanation":"정하다：定，选定；어도：表示让步：“即使、就算”；-아/어도 되다 表示“可以”。","readings":[{"term":"정하다","audio":"/audio/2b712f8bfe2006ebd91d.mp3"}],"sources":[{"entryId":"29767","senseId":"1","lemma":"정하다","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"정해도","audio":"/audio/1820d42d53820e738247.mp3"}},{"text":"됩니다.","meaning":"可以、得到允许（-아/어도 되다）","explanation":"되다：可以、得到允许（-아/어도 되다）；ㅂ니다：正式礼貌的陈述句末。","readings":[{"term":"되다","audio":"/audio/91b4dc2748cba787dd6f.mp3"}],"sources":[{"entryId":"89858","senseId":"21","lemma":"되다","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"됩니다","audio":"/audio/d5bd67992682ed3f7e8d.mp3"}}],"words":[{"id":"9474acc7539b7e2c","term":"아니요","zh":"不是，不用","audio":"/audio/9474acc7539b7e2cedaf.mp3","entryId":"17189","definition":"用于否定回答长辈所提出的问题。","pronunciation":["아니요"]},{"id":"fb2ddc76ae7f4ad6","term":"자유롭다","zh":"自由，自由自在","audio":"/audio/fb2ddc76ae7f4ad63c7e.mp3","entryId":"71198","definition":"不受拘束或限制，随心所欲。","pronunciation":["자유롭따"]},{"id":"0983250a9db31bda","term":"개별","zh":"个别","audio":"/audio/0983250a9db31bdac70b.mp3","entryId":"15770","definition":"指一个一个单独分开的状态。","pronunciation":["개ː별"]},{"id":"09053ac2411bc4cd","term":"주제","zh":"主题","audio":"/audio/09053ac2411bc4cdd44c.mp3","entryId":"91771","definition":"在对话或研究等里，成中心的问题。","pronunciation":["주제"]},{"id":"2b712f8bfe2006eb","term":"정하다","zh":"定，选定","audio":"/audio/2b712f8bfe2006ebd91d.mp3","entryId":"29767","definition":"从几个里面选一个。","pronunciation":["정ː하다"]},{"id":"91b4dc2748cba787","term":"되다","zh":"可以、得到允许（-아/어도 되다）","audio":"/audio/91b4dc2748cba787dd6f.mp3","entryId":"89858","definition":"可以、得到允许（-아/어도 되다）","pronunciation":["되다","뒈다"]}],"audio":"/audio/0da9c82845067bf18200.mp3","speakerIndex":1}],"difficulty":3.08,"source":{"url":"https://krdict.korean.go.kr/chn/dicSearch/SearchView?ParaWordNo=15770","la