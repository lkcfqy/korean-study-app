aa13.mp3","entryId":"64487","definition":"空气中的小水滴或冰粒凝结在一起，飘浮在空中。","pronunciation":["구름"]},{"id":"6f24e21fc8cce6bd","term":"정말","zh":"真的","audio":"/audio/6f24e21fc8cce6bd9e56.mp3","entryId":"61173","definition":"用于强调自己所说的话。","pronunciation":["정ː말"]},{"id":"f62ff8982d788e72","term":"예쁘다","zh":"漂亮，好看","audio":"/audio/f62ff8982d788e72028f.mp3","entryId":"89697","definition":"长相看起来美丽，让人喜欢。","pronunciation":["예ː쁘다"]}],"audio":"/audio/b5f8180bbdf77d79e89f.mp3","speakerIndex":1}],"difficulty":1.44,"source":{"url":"https://krdict.korean.go.kr/chn/dicSearch/SearchView?ParaWordNo=89697","label":"国立国语院韩国语—汉语学习词典","license":"https://creativecommons.org/licenses/by-sa/2.0/kr/"},"sourceSenseId":"1","sourceLevel":"초급","day":13,"sequenceScore":0.4249,"questions":[{"lineIndex":0,"options":["哇，云朵真的好漂亮啊。","您睡得好吗？","裕敏，抬头看看天空吧。"],"answer":2},{"lineIndex":1,"options":["哇，云朵真的好漂亮啊。","裕敏，抬头看看天空吧。","您睡得好吗？"],"answer":0}]}
