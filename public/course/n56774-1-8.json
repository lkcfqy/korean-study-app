/b8a273e5d75f1fd1734c.mp3"}],"sources":[],"surfaceReading":{"term":"아니야","audio":"/audio/b8a273e5d75f1fd1734c.mp3"}}],"words":[{"id":"228794e2524374dc","term":"어","zh":"咦","audio":"/audio/228794e2524374dc8637.mp3","entryId":"26153","definition":"感到惊讶、慌张、焦急、急促时发出的声音。","pronunciation":["어"]},{"id":"ceea9a2e61410973","term":"이쪽","zh":"这边","audio":"/audio/ceea9a2e61410973dfd8.mp3","entryId":"71694","definition":"指代离说话人很近的地方或方向。","pronunciation":["이쪽"]},{"id":"233cb510410b09d6","term":"가다","zh":"去","audio":"/audio/233cb510410b09d69cdc.mp3","entryId":"27500","definition":"为做某事而向别的地方移动。","pronunciation":["가다"]},{"id":"1443a6c090b12228","term":"것","zh":"表示某种行为、状态或事情。","audio":"/audio/1443a6c090b122289ad7.mp3","entryId":"62835","definition":"表示某种行为、状态或事情。","pronunciation":["걷"]}],"audio":"/audio/f733119ff9df829a7945.mp3","speakerIndex":1}],"difficulty":2.117,"source":{"url":"https://krdict.korean.go.kr/chn/dicSearch/SearchView?ParaWordNo=56774","label":"国立国语院韩国语—汉语学习词典","license":"https://creativecommons.org/licenses/by-sa/2.0/kr/"},"sourceSenseId":"1","sourceLevel":"중급","day":71,"sequenceScore":1.9437,"questions":[{"lineIndex":0,"options":["敏俊啊！你为什么要往反方向走？","啊？不是应该往这边走吗？","会是谁把垃圾扔到山里的呢？"],"answer":0},{"lineIndex":1,"options":["敏俊啊！你为什么要往反方向走？","啊？不是应该往这边走吗？","会是谁把垃圾扔到山里的呢？"],"answer":1}]}
