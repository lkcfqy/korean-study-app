ary"}],"surfaceReading":{"term":"나옵니다","audio":"/audio/c43e62fb6619c08cc5c3.mp3"}}],"words":[{"id":"8bafb6b7d17ead49","term":"이","zh":"这个","audio":"/audio/8bafb6b7d17ead4985bf.mp3","entryId":"27527","definition":"指代离说话人较近的，或说话人所想的对象。","pronunciation":["이"]},{"id":"f977ac4486c2b67c","term":"티셔츠","zh":"T恤","audio":"/audio/f977ac4486c2b67cd296.mp3","entryId":"82674","definition":"“T”字形的短袖衬衫。","pronunciation":[]},{"id":"82232621b82d72be","term":"크기","zh":"大小，高矮，高低","audio":"/audio/82232621b82d72beac66.mp3","entryId":"62458","definition":"物体的体积、宽度及量等的大小的程度。","pronunciation":["크기"]},{"id":"1bcc05bddb3c9e8c","term":"세","zh":"三","audio":"/audio/1bcc05bddb3c9e8c0bec.mp3","entryId":"17194","definition":"三个的。","pronunciation":["세ː"]},{"id":"b16bec1ce2b95619","term":"가지","zh":"种，项，类别，个","audio":"/audio/b16bec1ce2b9561977e6.mp3","entryId":"59921","definition":"表示事物种类的数量单位。","pronunciation":["가지"]},{"id":"038a8038eb817ffe","term":"나오다","zh":"上市，出品","audio":"/audio/038a8038eb817ffef26e.mp3","entryId":"62233","definition":"新商品出现在市场上。","pronunciation":["나오다"]}],"audio":"/audio/60694507af67d762a230.mp3","speakerIndex":0},{"id":"n82141-2-8-2","ko":"그럼 중간 사이즈로 보여 주세요.","zh":"那请给我看看中号吧。","note":"点不懂的词，看本句词义、助词和语尾；听词语后，再听整句。","parts":[{"text":"그럼","meaning":"那么，既然那样","explanation":"그럼：那么，既然那样","readings":[{"term":"그럼","audio":"/audio/86f87d3fb9919f145d21.mp3"}],"sources":[{"entryId":"60346","senseId":"2","lemma":"그럼","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"그럼","audio":"/audio/86f87d3fb9919f145d21.mp3"}},{"text":"중간","meaning":"中，中档，中等","explanation":"중간：中，中档，中等","readings":[{"term":"중간","audio":"/audio/541d1ddb952f8fbf865a.mp3"}],"sources":[{"entryId":"82141","senseId":"2","lemma":"중간","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"중간","audio":"/audio/541d1ddb952f8fbf865a.mp3"}},{"text":"사이즈로","meaning":"尺寸，号，尺码","explanation":"사이즈：尺寸，号，尺码；로：表示方向、方式、手段、材料、身份或原因等关系。","readings":[{"term":"사이즈","audio":"/audio/e0511ad24076321c499a.mp3"}],