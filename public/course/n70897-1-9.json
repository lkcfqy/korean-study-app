6a55225.mp3"}],"sources":[{"entryId":"69295","senseId":"1","lemma":"많다","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"많아","audio":"/audio/cddc8e9fac3b225d8a31.mp3"}}],"words":[{"id":"23457023f6034aaf","term":"바쁘다","zh":"忙，忙碌，紧张","audio":"/audio/23457023f6034aaf6759.mp3","entryId":"66248","definition":"因为要做的事情多或没有时间而无暇顾及其他。","pronunciation":["바쁘다"]},{"id":"bcf27ef578d25dc7","term":"신문","zh":"报纸","audio":"/audio/bcf27ef578d25dc71d55.mp3","entryId":"65337","definition":"告知世上新发生的事件的定期刊物。","pronunciation":["신문"]},{"id":"08b17e433630742b","term":"제목","zh":"题目","audio":"/audio/08b17e433630742bc700.mp3","entryId":"70897","definition":"文章、电影或公演等中，为表达中心内容而取的名字。","pronunciation":["제목"]},{"id":"b14e1350e48dbcc8","term":"훑다","zh":"快速浏览、扫视（报纸标题）","audio":"/audio/b14e1350e48dbcc80b62.mp3","entryId":"87740","definition":"快速浏览、扫视（报纸标题）","pronunciation":["훌따"]},{"id":"43bc9c47e0f938b1","term":"때","zh":"时，时候","audio":"/audio/43bc9c47e0f938b11288.mp3","entryId":"74123","definition":"指某一瞬间或时间段。","pronunciation":["때"]},{"id":"b30b4bf6ab97d6a5","term":"많다","zh":"多，丰富，强","audio":"/audio/b30b4bf6ab97d6a55225.mp3","entryId":"69295","definition":"数、量、程度等超过一定标准。","pronunciation":["만ː타"]}],"audio":"/audio/0cdebd6ab4644eb2e088.mp3","speakerIndex":1}],"difficulty":2.316,"source":{"url":"https://krdict.korean.go.kr/chn/dicSearch/SearchView?ParaWordNo=70897","label":"国立国语院韩国语—汉语学习词典","license":"https://creativecommons.org/licenses/by-sa/2.0/kr/"},"sourceSenseId":"1","sourceLevel":"초급","day":41,"sequenceScore":1.8295,"questions":[{"lineIndex":0,"options":["你每天都会读报纸吗？","因为太忙了，很多时候只是快速浏览一下标题而已。","房租什么时候交比较合适呢？"],"answer":0},{"lineIndex":1,"options":["你每天都会读报纸吗？","因为太忙了，很多时候只是快速浏览一下标题而已。","房租什么时候交比较合适呢？"],"answer":1}]}
