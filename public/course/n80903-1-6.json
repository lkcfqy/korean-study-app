ary"}],"surfaceReading":{"term":"잡혀","audio":"/audio/f857f0e475f012b72a0a.mp3"}},{"text":"간","meaning":"上，进","explanation":"가다：上，进；ㄴ：修饰后面的名词。形容词后表示当前性质；动词后通常表示已完成的动作或结果状态。","readings":[{"term":"가다","audio":"/audio/233cb510410b09d69cdc.mp3"}],"sources":[{"entryId":"27500","senseId":"8","lemma":"가다","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"간","audio":"/audio/74ca8db3a8d704900080.mp3"}},{"text":"거래?","meaning":"某种事物、现象或事实。","explanation":"거：某种事物、现象或事实；이다：表示“是”的判断形式；래：口语中转述听来的话，非敬语。","readings":[{"term":"거","audio":"/audio/ffcedfda7558e5dc31fe.mp3"}],"sources":[{"entryId":"62331","senseId":"1","lemma":"거","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"거래","audio":"/audio/60f81bab2175c15e62d0.mp3"}}],"words":[{"id":"d4901559765ba929","term":"옆집","zh":"邻居，隔壁","audio":"/audio/d4901559765ba929833a.mp3","entryId":"71723","definition":"旁边的一家。","pronunciation":["엽찝"]},{"id":"65e567305972e652","term":"아들","zh":"儿子","audio":"/audio/65e567305972e652430e.mp3","entryId":"20240","definition":"男性子女。","pronunciation":["아들"]},{"id":"08b35eb63efd4aaa","term":"왜","zh":"为什么","audio":"/audio/08b35eb63efd4aaae44c.mp3","entryId":"67848","definition":"因什么原因；或指怎么。","pronunciation":["왜ː"]},{"id":"c7c5916d2df73410","term":"또","zh":"又","audio":"/audio/c7c5916d2df73410dd21.mp3","entryId":"51887","definition":"某件事情或行为再次发生。","pronunciation":["또"]},{"id":"d7c352449c7960ec","term":"경찰서","zh":"警察署，警察局，公安局","audio":"/audio/d7c352449c7960ec1ec2.mp3","entryId":"25960","definition":"负责一个地区的公安工作的官厅。","pronunciation":["경ː찰써"]},{"id":"4e82277a09474ac2","term":"잡히다","zh":"被抓","audio":"/audio/4e82277a09474ac2305e.mp3","entryId":"70656","definition":"被捉住而无法逃走。","pronunciation":["자피다"]},{"id":"233cb510410b09d6","term":"가다","zh":"上，进","audio":"/audio/233cb510410b09d69cdc.mp3","entryId":"27500","definition":"隶属于某个团体或机关。","pronunciation":["가다"]},{"id":"ffcedfda7558e5dc","term":"거","zh":"某种事物、现象或事实。","audio":"/audio/ffcedfda7558e5dc31fe.mp3","entryId":"62331","defin