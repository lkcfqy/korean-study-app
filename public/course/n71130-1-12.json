n/dicSearch/SearchView?ParaWordNo=71130","label":"国立国语院韩国语—汉语学习词典","license":"https://creativecommons.org/licenses/by-sa/2.0/kr/"},"sourceSenseId":"1","sourceLevel":"초급","day":31,"sequenceScore":1.3118,"questions":[{"lineIndex":0,"options":["嗯，空气好又安静，我很喜欢。","您在这里的生活感觉怎么样？","学习还顺利吗？"],"answer":1},{"lineIndex":1,"options":["您在这里的生活感觉怎么样？","学习还顺利吗？","嗯，空气好又安静，我很喜欢。"],"answer":2}]}
