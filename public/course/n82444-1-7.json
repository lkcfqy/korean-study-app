05","senseId":"2","lemma":"응","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"응","audio":"/audio/107dd01c3d38a368ad44.mp3"}},{"text":"우리","meaning":"我，我们","explanation":"우리：我，我们","readings":[{"term":"우리","audio":"/audio/398dfa639dfd0db8f8e0.mp3"}],"sources":[{"entryId":"17182","senseId":"3","lemma":"우리","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"우리","audio":"/audio/398dfa639dfd0db8f8e0.mp3"}},{"text":"할아버지","meaning":"爷爷，姥爷","explanation":"할아버지：爷爷，姥爷","readings":[{"term":"할아버지","audio":"/audio/6600340ce9e158e7d903.mp3"}],"sources":[{"entryId":"74121","senseId":"1","lemma":"할아버지","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"할아버지","audio":"/audio/6600340ce9e158e7d903.mp3"}},{"text":"것이야.","meaning":"(某人)的","explanation":"것：(某人)的；이다：表示“是”的判断形式。；야：非敬语判断或疑问句末，常与 이다 连用。","readings":[{"term":"것","audio":"/audio/1443a6c090b122289ad7.mp3"}],"sources":[{"entryId":"62835","senseId":"3","lemma":"것","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"것이야","audio":"/audio/4fa6b910fe1b6ee3e0d4.mp3"}},{"text":"할아버지께서","meaning":"爷爷，姥爷","explanation":"할아버지：爷爷，姥爷；께서：이/가 的敬语形式，标记受到尊敬的主语。","readings":[{"term":"할아버지","audio":"/audio/6600340ce9e158e7d903.mp3"}],"sources":[{"entryId":"74121","senseId":"1","lemma":"할아버지","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"할아버지께서","audio":"/audio/8d394502e3ec4be9e917.mp3"}},{"text":"트로트","meaning":"韩国流行歌谣","explanation":"트로트：韩国流行歌谣","readings":[{"term":"트로트","audio":"/audio/81d090e304ffb6855250.mp3"}],"sources":[{"entryId":"82444","senseId":"1","lemma":"트로트","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"트로트","audio":"/audio/81d090e304ffb6855250.mp3"}},{"text":"음악을","meaning":"音乐","explanation":"음악：音乐；을：宾格助词，标记动作对象。","readings":[{"term":"음악","audio":"/audio/88caa317d96897c98d10.mp3"}],"sources":[{"entryId":"71115","senseId":"1","lemma":"음악","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"