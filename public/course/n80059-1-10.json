3"}}],"words":[{"id":"107dd01c3d38a368","term":"응","zh":"是，行","audio":"/audio/107dd01c3d38a368ad44.mp3","entryId":"30205","definition":"用于肯定回答对方所提出的问题或命令等。","pronunciation":["응"]},{"id":"38c61820e786f234","term":"그","zh":"那个","audio":"/audio/38c61820e786f2346e96.mp3","entryId":"43883","definition":"指代与听话人较近或听话人所想的对象。","pronunciation":["그"]},{"id":"c6a3b6d97217b4d8","term":"남자","zh":"男子，男人","audio":"/audio/c6a3b6d97217b4d81661.mp3","entryId":"60865","definition":"作为男性出生的人。","pronunciation":["남자"]},{"id":"c17f7a33ba0f8a27","term":"부지런하다","zh":"勤奋，勤快，勤勉，勤恳","audio":"/audio/c17f7a33ba0f8a274e48.mp3","entryId":"26500","definition":"具有不偷懒、坚持不懈、努力做事的倾向。","pronunciation":["부지런하다"]},{"id":"f67c36eff95bd32b","term":"착실하다","zh":"踏实，实在，扎实","audio":"/audio/f67c36eff95bd32ba65e.mp3","entryId":"80059","definition":"一贯正派、诚实。","pronunciation":["착씰하다"]},{"id":"389e7564ae2551b4","term":"사람","zh":"人","audio":"/audio/389e7564ae2551b4f94d.mp3","entryId":"58161","definition":"可以思考，会制造并使用语言和工具、构成社会而生活的存在。","pronunciation":["사ː람"]}],"audio":"/audio/72dc735b39e977d5eab7.mp3","speakerIndex":1}],"difficulty":2.474,"source":{"url":"https://krdict.korean.go.kr/chn/dicSearch/SearchView?ParaWordNo=80059","label":"国立国语院韩国语—汉语学习词典","license":"https://creativecommons.org/licenses/by-sa/2.0/kr/"},"sourceSenseId":"1","sourceLevel":"고급","day":127,"sequenceScore":2.3007,"questions":[{"lineIndex":0,"options":["嗯，那个男人是个勤奋又踏实的人。","你弟弟受伤很严重吗？","智秀，那个男人怎么样？"],"answer":2},{"lineIndex":1,"options":["嗯，那个男人是个勤奋又踏实的人。","智秀，那个男人怎么样？","你弟弟受伤很严重吗？"],"answer":0}]}
