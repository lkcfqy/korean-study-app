d3f7e8d.mp3"}}],"words":[{"id":"c0ccf82e09f1e873","term":"오","zh":"五","audio":"/audio/c0ccf82e09f1e8734531.mp3","entryId":"31635","definition":"四加一所得的数目。","pronunciation":["오ː"]},{"id":"5987e716eafb9e90","term":"층","zh":"层","audio":"/audio/5987e716eafb9e902330.mp3","entryId":"20264","definition":"对建筑物中高度相同的部分从下往上计算次序时使用的单位。","pronunciation":["층"]},{"id":"233cb510410b09d6","term":"가다","zh":"去，上","audio":"/audio/233cb510410b09d69cdc.mp3","entryId":"27500","definition":"为某种目的而向某个地方移动。","pronunciation":["가다"]},{"id":"91b4dc2748cba787","term":"되다","zh":"能，行","audio":"/audio/91b4dc2748cba787dd6f.mp3","entryId":"89858","definition":"某个事情可行或被允许。","pronunciation":["되다","뒈다"]}],"audio":"/audio/5528704de812438ee99c.mp3","speakerIndex":1}],"difficulty":1.44,"source":{"url":"https://krdict.korean.go.kr/chn/dicSearch/SearchView?ParaWordNo=20264","label":"国立国语院韩国语—汉语学习词典","license":"https://creativecommons.org/licenses/by-sa/2.0/kr/"},"sourceSenseId":"4","sourceLevel":"초급","day":19,"sequenceScore":0.763,"questions":[{"lineIndex":0,"options":["这里的内科在几层呢？","这里的牙科在几层呢？","这里的牙科几点开门呢？"],"answer":1,"explanation":"치과 是牙科，몇 층 问楼层，不问开门时间。"},{"lineIndex":1,"options":["请往4层走就可以了。","请往地下5层走就可以了。","请往5层走就可以了。"],"answer":2,"explanation":"오 층 是地上五层；如果是地下会说 지하。"}]}
