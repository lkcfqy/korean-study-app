77.mp3"}],"sources":[{"entryId":"66375","senseId":"7","lemma":"보내다","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"보내려고","audio":"/audio/079364d3c2ac78e03fc5.mp3"}},{"text":"해요.","meaning":"打算做（-려고 하다）","explanation":"하다：打算做（-려고 하다）；어요：礼貌句末；可随语调表示陈述或询问。","readings":[{"term":"하다","audio":"/audio/505de0a2f6be73fa7758.mp3"}],"sources":[{"entryId":"62888","senseId":"2","lemma":"하다","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"해요","audio":"/audio/521029965a4dd3b2882e.mp3"}}],"words":[{"id":"1c0ddfd005093840","term":"네","zh":"是，行","audio":"/audio/1c0ddfd0050938404c35.mp3","entryId":"17294","definition":"用于肯定回答长辈所提出的问题或命令等。","pronunciation":["네"]},{"id":"f7a54f6defb5a3ff","term":"농사","zh":"农事，种田，种地","audio":"/audio/f7a54f6defb5a3ff8d26.mp3","entryId":"66305","definition":"种植收获粮食或蔬菜的事情。","pronunciation":["농사"]},{"id":"e17bf0fed41df779","term":"짓다","zh":"种","audio":"/audio/e17bf0fed41df779832d.mp3","entryId":"66585","definition":"干农活。","pronunciation":["짇ː따"]},{"id":"068bccdcf866defe","term":"부모님","zh":"父母","audio":"/audio/068bccdcf866defe1ca7.mp3","entryId":"62272","definition":"(敬语)父亲和母亲。","pronunciation":["부모님"]},{"id":"7feaaecf170e0c6a","term":"돕다","zh":"帮，帮助","audio":"/audio/7feaaecf170e0c6a578f.mp3","entryId":"17203","definition":"给别人正在做的事打下手或添帮手。","pronunciation":["돕ː따"]},{"id":"e0b9feca18797927","term":"값지다","zh":"珍贵，宝贵","audio":"/audio/e0b9feca187979274416.mp3","entryId":"23031","definition":"价值或意义很大。","pronunciation":["갑찌다"]},{"id":"8af300ffd85ed5a1","term":"보내다","zh":"度过","audio":"/audio/8af300ffd85ed5a13777.mp3","entryId":"66375","definition":"让时间流逝。","pronunciation":["보내다"]},{"id":"505de0a2f6be73fa","term":"하다","zh":"打算做（-려고 하다）","audio":"/audio/505de0a2f6be73fa7758.mp3","entryId":"62888","definition":"打算做（-려고 하다）","pronunciation":["하다"]}],"audio":"/audio/9b4d6abb5acc70860ec9.mp3","speakerIndex":1}],"difficulty":3.169,"source":{"url":"https://krdict.korean.go.kr/chn/dicSearch/SearchView?ParaWordNo=23031","label":"国