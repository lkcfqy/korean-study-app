ry"}],"surfaceReading":{"term":"하고","audio":"/audio/1a7140c02481d065b267.mp3"}},{"text":"왔어.","meaning":"到，来到","explanation":"오다：到，来到；었：过去或完成，常与词干缩合；어：非敬语句末；与熟悉的人或晚辈交谈，语调决定陈述、询问等语气。","readings":[{"term":"오다","audio":"/audio/6fe577b99594f4a7bd8d.mp3"}],"sources":[{"entryId":"69514","senseId":"10","lemma":"오다","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"왔어","audio":"/audio/1c7a0c0d37b0eadd46f3.mp3"}}],"words":[{"id":"47aebe2586c6cf8d","term":"시내","zh":"市内，市里","audio":"/audio/47aebe2586c6cf8d52e3.mp3","entryId":"65118","definition":"城市里面。","pronunciation":["시ː내"]},{"id":"f7bcc82cf5b9252f","term":"구경","zh":"赏，观看，游览","audio":"/audio/f7bcc82cf5b9252f8050.mp3","entryId":"64484","definition":"用眼睛看或亲自体验。","pronunciation":["구ː경"]},{"id":"70ae9bc35b2d378b","term":"좀","zh":"一下","audio":"/audio/70ae9bc35b2d378b00ef.mp3","entryId":"75798","definition":"主要用于委婉请求或征得同意。","pronunciation":["좀"]},{"id":"505de0a2f6be73fa","term":"하다","zh":"做，干","audio":"/audio/505de0a2f6be73fa7758.mp3","entryId":"73277","definition":"进行某种行动、动作或活动。","pronunciation":["하다"]},{"id":"6fe577b99594f4a7","term":"오다","zh":"到，来到","audio":"/audio/6fe577b99594f4a7bd8d.mp3","entryId":"69514","definition":"到达想去的地方。","pronunciation":["오다"]}],"audio":"/audio/bfa4e9eedbbc878ef808.mp3","speakerIndex":1}],"difficulty":2.218,"source":{"url":"https://krdict.korean.go.kr/chn/dicSearch/SearchView?ParaWordNo=14793","label":"国立国语院韩国语—汉语学习词典","license":"https://creativecommons.org/licenses/by-sa/2.0/kr/"},"sourceSenseId":"1","sourceLevel":"중급","day":71,"sequenceScore":1.9433,"questions":[{"lineIndex":0,"options":["今天是在哪里逛来着？","去市中心转了转就回来了。","敏俊啊！你为什么要往反方向走？"],"answer":0},{"lineIndex":1,"options":["今天是在哪里逛来着？","去市中心转了转就回来了。","敏俊啊！你为什么要往反方向走？"],"answer":1}]}
