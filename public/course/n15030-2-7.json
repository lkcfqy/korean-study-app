1","lemma":"드라마","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"드라마에","audio":"/audio/dc1affd88b9cf403bff7.mp3"}},{"text":"등장을","meaning":"登场，出场","explanation":"등장：登场，出场；을：宾格助词，标记动作对象。","readings":[{"term":"등장","audio":"/audio/72bd0cdcc3bc0e1b03e9.mp3"}],"sources":[{"entryId":"15030","senseId":"2","lemma":"등장","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"등장을","audio":"/audio/cac39b562a2d7660b404.mp3"}},{"text":"한대!","meaning":"表示引用。","explanation":"하다：表示引用。；ㄴ대：口语中转述听来的话，非敬语。","readings":[{"term":"하다","audio":"/audio/505de0a2f6be73fa7758.mp3"}],"sources":[{"entryId":"73277","senseId":"22","lemma":"하다","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"한대","audio":"/audio/ecbeb5d6ac1f114dc58c.mp3"}}],"words":[{"id":"1e07b94ba5182a41","term":"내일","zh":"明天，明日","audio":"/audio/1e07b94ba5182a41e7de.mp3","entryId":"30193","definition":"今天的下一天。","pronunciation":["내일"]},{"id":"dfc77ad537b73519","term":"드디어","zh":"终于，到底，总算","audio":"/audio/dfc77ad537b73519dd4a.mp3","entryId":"15026","definition":"期待已久的最终；到了最后。","pronunciation":["드디어"]},{"id":"38c61820e786f234","term":"그","zh":"那个","audio":"/audio/38c61820e786f2346e96.mp3","entryId":"43883","definition":"指代前面已经讲过的对象。","pronunciation":["그"]},{"id":"cad171780a04b71e","term":"유명하다","zh":"有名，知名，著名","audio":"/audio/cad171780a04b71eb7bf.mp3","entryId":"29716","definition":"名字广为人知。","pronunciation":["유ː명하다"]},{"id":"70129359d515b770","term":"배우","zh":"演员","audio":"/audio/70129359d515b77048d9.mp3","entryId":"58204","definition":"担任电影、话剧或电视剧等中的人物角色进行表演的人。","pronunciation":["배우"]},{"id":"48196dde09d3559f","term":"드라마","zh":"电视剧，连续剧","audio":"/audio/48196dde09d3559f1d2b.mp3","entryId":"61389","definition":"在影院上映或电视上播放的剧。","pronunciation":[]},{"id":"72bd0cdcc3bc0e1b","term":"등장","zh":"登场，出场","audio":"/audio/72bd0cdcc3bc0e1b03e9.mp3","entryId":"15030","definition":"某个人物出现在小说、戏剧和电影等中。","pronunciation":["등장"]},{"id":"505de0a2f6be73fa","term":"하다","zh":"表示引用。","audio":"/audio/