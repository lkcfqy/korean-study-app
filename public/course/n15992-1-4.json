ae2551b4f94d.mp3","entryId":"58161","definition":"可以思考，会制造并使用语言和工具、构成社会而生活的存在。","pronunciation":["사ː람"]},{"id":"8e09b5f4c09195e3","term":"참","zh":"真，实在，的确","audio":"/audio/8e09b5f4c09195e322ba.mp3","entryId":"71761","definition":"毫不违背事实或道理，真正地。","pronunciation":["참"]},{"id":"8aff11a4aebdccdb","term":"잘","zh":"很好地，熟练地","audio":"/audio/8aff11a4aebdccdbf05d.mp3","entryId":"58939","definition":"熟悉而擅长地。","pronunciation":["잘"]},{"id":"3ad4e3c6c1e70dee","term":"따르다","zh":"跟随，尾随","audio":"/audio/3ad4e3c6c1e70deec620.mp3","entryId":"64547","definition":"在他人后面跟着走。","pronunciation":["따르다"]}],"audio":"/audio/a1c8ab6cef6386366eff.mp3","speakerIndex":0},{"id":"n15992-1-4-2","ko":"네, 낯선 사람을 봐도 멍멍 소리 한 번 안 내요.","zh":"是啊，见到陌生人也一声都不叫。","note":"点不懂的词，看本句词义、助词和语尾；听词语后，再听整句。","parts":[{"text":"네,","meaning":"是，行","explanation":"네：是，行","readings":[{"term":"네","audio":"/audio/1c0ddfd0050938404c35.mp3"}],"sources":[{"entryId":"17294","senseId":"2","lemma":"네","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"네","audio":"/audio/1c0ddfd0050938404c35.mp3"}},{"text":"낯선","meaning":"陌生，面生","explanation":"낯설다：陌生，面生；ㄴ：修饰后面的名词。形容词后表示当前性质；动词后通常表示已完成的动作或结果状态。","readings":[{"term":"낯설다","audio":"/audio/f8ed723eebf05294a03f.mp3"}],"sources":[{"entryId":"41324","senseId":"1","lemma":"낯설다","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"낯선","audio":"/audio/ad08c431a35300062622.mp3"}},{"text":"사람을","meaning":"人","explanation":"사람：人；을：宾格助词，标记动作对象。","readings":[{"term":"사람","audio":"/audio/389e7564ae2551b4f94d.mp3"}],"sources":[{"entryId":"58161","senseId":"1","lemma":"사람","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"사람을","audio":"/audio/e4ea86ef494eafea0006.mp3"}},{"text":"봐도","meaning":"看","explanation":"보다：看；어도：表示让步：“即使、就算”；-아/어도 되다 表示“可以”。","readings":[{"term":"보다","audio":"/audio/6a45cf834264a5ec3611.mp3"}],"sources":[{"entryId":"61190","senseId":"1","lemma":"보다","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"봐도","audio":"/audio/fdd01bd86a193dbd13e5.mp3"}},{"text":"멍멍","meaning":"汪汪","explanation":"멍멍：汪汪","readings":[{"term":"멍멍","audio":"/audio/acd35e3409f5e5d4421f.mp3"}],"sources":[{"entryId":"15992","senseId":"1","lemma":"멍멍","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"멍멍","audio":"/audio/acd35e3409f5e5d4421f.mp3"}},{"text":"소리","meaning":"嗓音，嗓子，嗓门","explanation":"소리：嗓音，嗓子，嗓门","readings":[{"term":"소리","audio":"/audio/d13cec79f66edb6aa0c5.mp3"}],"sources":[{"entryId":"62379","senseId":"3","lemma":"소리","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"소리","audio":"/audio/d13cec79f66edb6aa0c5.mp3"}},{"text":"한","meaning":"一","explanation":"한：一","readings":[{"term":"한","audio":"/audio/89233692031a62c60e6e.mp3"}],"sources":[{"entryId":"73278","senseId":"1","lemma":"한","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"한","audio":"/audio/89233692031a62c60e6e.mp3"}},{"text":"번","meaning":"次，遍","explanation":"번：次，遍","readings":[{"term":"번","audio":"/audio/dfccc17e2997aa8da631.mp3"}],"sources":[{"entryId":"26846","senseId":"2","lemma":"번","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"번","audio":"/audio/dfccc17e2997aa8da631.mp3"}},{"text":"안","meaning":"不","explanation":"안：不","readings":[{"term":"안","audio":"/audio/bc00bc8172c83d5fab70.mp3"}],"sources":[{"entryId":"71372","senseId":"1","lemma":"안","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"안","audio":"/audio/bc00bc8172c83d5fab70.mp3"}},{"text":"내요.","meaning":"散出，放出","explanation":"내다：散出，放出；어요：礼貌句末；可随语调表示陈述或询问。","readings":[{"term":"내다","audio":"/audio/3c7ab23f77767092623c.mp3"}],"sources":[{"entryId":"89906","senseId":"20","lemma":"내다","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"내요","audio":"/audio/f5227f5415cb0f89399a.mp3"}}],"words":[{"id":"1c0ddfd005093840","term":"네","zh":"是，行","audio":"/audio/1c0ddfd0050938404c35.mp3","entryId":"17294","definition":"用于肯定回答长辈所提出的问题或命令等。","pronunciation"