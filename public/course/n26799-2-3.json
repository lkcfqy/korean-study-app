07","senseId":"1","lemma":"혼자","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"혼자","audio":"/audio/9d309cd460ea409c50fb.mp3"}},{"text":"있어.","meaning":"待着","explanation":"있다：在某处待着；혼자 있어 表示“一个人待着”。","readings":[{"term":"있다","audio":"/audio/96fe52db2531c9e73e53.mp3"}],"sources":[{"entryId":"68797","senseId":"9","lemma":"있다","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"있어","audio":"/audio/675a95c70a831521b983.mp3"}}],"words":[{"id":"bcf26f704fdac00f","term":"아니","zh":"不，没","audio":"/audio/bcf26f704fdac00f644a.mp3","entryId":"65980","definition":"用于表示否定或反对。","pronunciation":["아니"]},{"id":"5dbe3d17e9e85489","term":"아까","zh":"刚才，方才，刚刚","audio":"/audio/5dbe3d17e9e854897ec5.mp3","entryId":"65974","definition":"不久以前。","pronunciation":["아까"]},{"id":"1202aff936337891","term":"친구","zh":"朋友","audio":"/audio/1202aff936337891e079.mp3","entryId":"29742","definition":"关系亲近、经常来往的人。","pronunciation":["친구"]},{"id":"55df2acaad2147f2","term":"헤어지다","zh":"分别，分离","audio":"/audio/55df2acaad2147f202aa.mp3","entryId":"58271","definition":"和在一起的人分开。","pronunciation":["헤어지다"]},{"id":"df159f47a890ff65","term":"지금","zh":"现在","audio":"/audio/df159f47a890ff655039.mp3","entryId":"62522","definition":"指正在说话的此时。","pronunciation":["지금"]},{"id":"9d309cd460ea409c","term":"혼자","zh":"独自，单独","audio":"/audio/9d309cd460ea409c50fb.mp3","entryId":"30207","definition":"只有一人，没有别人。","pronunciation":["혼자"]},{"id":"96fe52db2531c9e7","term":"있다","zh":"在，待，住","audio":"/audio/96fe52db2531c9e73e53.mp3","entryId":"68797","definition":"人或动物停留或居住在某个地方。","pronunciation":["읻따"]}],"audio":"/audio/cccd1915ece875305d6d.mp3","speakerIndex":1}],"difficulty":1.9,"source":{"url":"https://krdict.korean.go.kr/chn/dicSearch/SearchView?ParaWordNo=26799","label":"国立国语院韩国语—汉语学习词典","license":"https://creativecommons.org/licenses/by-sa/2.0/kr/"},"sourceSenseId":"2","sourceLevel":"초급","day":23,"sequenceScore":0.954,"questions":[{"lineIndex":0,"options":["没有，刚才和朋友分开了，现在就我一个人。","我男朋友突然说要跟我分手。","你