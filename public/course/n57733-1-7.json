mp3"}],"sources":[{"entryId":"24881","senseId":"1","lemma":"잘생기다","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"잘생기셨네요","audio":"/audio/833929d60880885695e2.mp3"}}],"words":[{"id":"ceea9a2e61410973","term":"이쪽","zh":"这边，这位","audio":"/audio/ceea9a2e61410973dfd8.mp3","entryId":"71694","definition":"指代离说话人近的人或人群。","pronunciation":["이쪽"]},{"id":"b364daea4cbc5e72","term":"훨씬","zh":"更加，远远地","audio":"/audio/b364daea4cbc5e721b5e.mp3","entryId":"73250","definition":"与某物相比差别很大地。","pronunciation":["훨씬"]},{"id":"c56f4bd1fb4139c5","term":"잘생기다","zh":"好看，漂亮，英俊","audio":"/audio/c56f4bd1fb4139c5b3d2.mp3","entryId":"24881","definition":"人的容貌出众。","pronunciation":["잘생기다"]}],"audio":"/audio/c75ef0df615afe74a6cf.mp3","speakerIndex":1}],"difficulty":1.76,"source":{"url":"https://krdict.korean.go.kr/chn/dicSearch/SearchView?ParaWordNo=57733","label":"国立国语院韩国语—汉语学习词典","license":"https://creativecommons.org/licenses/by-sa/2.0/kr/"},"sourceSenseId":"1","sourceLevel":"고급","day":121,"sequenceScore":1.4853,"questions":[{"lineIndex":0,"options":["这位帅得多！","这家餐厅的氛围不错吧？","我们俩谁更帅？"],"answer":2},{"lineIndex":1,"options":["这位帅得多！","我们俩谁更帅？","这家餐厅的氛围不错吧？"],"answer":0}]}
