n":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"되었나","audio":"/audio/18a7bfc772e75931daf2.mp3"}},{"text":"봐.","meaning":"看来、好像（根据情况推测）","explanation":"보다：看来、好像（根据情况推测）；어：非敬语句末；与熟悉的人或晚辈交谈，语调决定陈述、询问等语气。","readings":[{"term":"보다","audio":"/audio/6a45cf834264a5ec3611.mp3"}],"sources":[{"entryId":"62171","senseId":"1","lemma":"보다","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"봐","audio":"/audio/fdcffec86114c54dd4e0.mp3"}}],"words":[{"id":"b039867287707963","term":"너무","zh":"太","audio":"/audio/b0398672877079631cf2.mp3","entryId":"28183","definition":"已超过一定的程度或限度的状态。","pronunciation":["너무"]},{"id":"7d268ef946cccd3a","term":"오래되다","zh":"久，老","audio":"/audio/7d268ef946cccd3a8e4b.mp3","entryId":"89515","definition":"开始或发生后，经过的时间长。","pronunciation":["오래되다","오래뒈다"]},{"id":"06f1a0e00c7c690f","term":"노화","zh":"老化","audio":"/audio/06f1a0e00c7c690f9bae.mp3","entryId":"42933","definition":"随着时间的流逝，由于性质改变，导致功能衰退。","pronunciation":["노ː화"]},{"id":"91b4dc2748cba787","term":"되다","zh":"变得，弄得","audio":"/audio/91b4dc2748cba787dd6f.mp3","entryId":"89858","definition":"达到某种情况或状态。","pronunciation":["되다","뒈다"]},{"id":"6a45cf834264a5ec","term":"보다","zh":"看来、好像（根据情况推测）","audio":"/audio/6a45cf834264a5ec3611.mp3","entryId":"62171","definition":"看来、好像（根据情况推测）","pronunciation":["보다"]}],"audio":"/audio/142dca0aaca8b0bdcd84.mp3","speakerIndex":1}],"difficulty":3.37,"source":{"url":"https://krdict.korean.go.kr/chn/dicSearch/SearchView?ParaWordNo=42933","label":"国立国语院韩国语—汉语学习词典","license":"https://creativecommons.org/licenses/by-sa/2.0/kr/"},"sourceSenseId":"2","sourceLevel":"고급","day":162,"sequenceScore":3.1967,"questions":[{"lineIndex":0,"options":["橡胶怎么变得这么硬了呢？","应该是因为用得太久了，老化了吧。","空地上要新建什么吗？"],"answer":0},{"lineIndex":1,"options":["橡胶怎么变得这么硬了呢？","应该是因为用得太久了，老化了吧。","空地上要新建什么吗？"],"answer":1}]}
