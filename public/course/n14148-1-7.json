48","senseId":"1","lemma":"예선","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"예선","audio":"/audio/dbad85ccbcd6388288c7.mp3"}},{"text":"결과","meaning":"结果，结局","explanation":"결과：结果，结局","readings":[{"term":"결과","audio":"/audio/109383e344db8ae54a47.mp3"}],"sources":[{"entryId":"60093","senseId":"1","lemma":"결과","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"결과","audio":"/audio/109383e344db8ae54a47.mp3"}},{"text":"나왔어?","meaning":"出现，出来","explanation":"나오다：出现，出来；었：过去或完成，常与词干缩合。；어：非敬语句末；与熟悉的人或晚辈交谈，语调决定陈述、询问等语气。","readings":[{"term":"나오다","audio":"/audio/038a8038eb817ffef26e.mp3"}],"sources":[{"entryId":"62233","senseId":"10","lemma":"나오다","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"나왔어","audio":"/audio/8551cc335e2fac96879f.mp3"}}],"words":[{"id":"734dae8e9d9a8f8b","term":"너","zh":"你","audio":"/audio/734dae8e9d9a8f8b763b.mp3","entryId":"64390","definition":"指代听者，用于朋友或晚辈。","pronunciation":["너"]},{"id":"0c2f1df517822c1f","term":"지난번","zh":"上次，上回","audio":"/audio/0c2f1df517822c1fb603.mp3","entryId":"71316","definition":"以正在说话时为准，指过去的时候。","pronunciation":["지난번"]},{"id":"961ee88770fe6ab5","term":"나가다","zh":"参加，出战","audio":"/audio/961ee88770fe6ab5a409.mp3","entryId":"71456","definition":"出席聚会，加入竞技比赛，或以候补身份加入选举。","pronunciation":["나가다"]},{"id":"662fbb8d7bdeae80","term":"발표","zh":"发表、演讲（발표 대회：演讲比赛）","audio":"/audio/662fbb8d7bdeae8019f6.mp3","entryId":"62470","definition":"发表、演讲（발표 대회：演讲比赛）","pronunciation":["발표"]},{"id":"7255709b1fec18f4","term":"대회","zh":"比赛，大赛","audio":"/audio/7255709b1fec18f41a20.mp3","entryId":"61306","definition":"许多人较量实力或技术的活动。","pronunciation":["대ː회","대ː훼"]},{"id":"dbad85ccbcd63882","term":"예선","zh":"预选","audio":"/audio/dbad85ccbcd6388288c7.mp3","entryId":"14148","definition":"为获得参加某个大会决赛的资格而提前进行的比赛。","pronunciation":["예ː선"]},{"id":"109383e344db8ae5","term":"결과","zh":"结果，结局","audio":"/audio/109383e344db8ae54a47.mp3","entryId":"60093","definition":"某件事情或过程结束后的状态或现象。","pronunciation":["결과"