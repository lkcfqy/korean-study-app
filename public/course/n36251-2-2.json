ary"}],"surfaceReading":{"term":"취직이","audio":"/audio/85faee9b0c565f1e771e.mp3"}},{"text":"잘","meaning":"容易","explanation":"잘：容易","readings":[{"term":"잘","audio":"/audio/8aff11a4aebdccdbf05d.mp3"}],"sources":[{"entryId":"58939","senseId":"14","lemma":"잘","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"잘","audio":"/audio/8aff11a4aebdccdbf05d.mp3"}},{"text":"안","meaning":"不","explanation":"안：不","readings":[{"term":"안","audio":"/audio/bc00bc8172c83d5fab70.mp3"}],"sources":[{"entryId":"71372","senseId":"1","lemma":"안","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"안","audio":"/audio/bc00bc8172c83d5fab70.mp3"}},{"text":"되니까요.","meaning":"能，行","explanation":"되다：能，行；니까요：在句末礼貌地解释原因或依据。","readings":[{"term":"되다","audio":"/audio/91b4dc2748cba787dd6f.mp3"}],"sources":[{"entryId":"89858","senseId":"21","lemma":"되다","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"되니까요","audio":"/audio/14b51294bfc5e5f79846.mp3"}}],"words":[{"id":"cc5bf6a36796ed18","term":"성적","zh":"成绩","audio":"/audio/cc5bf6a36796ed18e880.mp3","entryId":"64457","definition":"通过考试对学生的学习进行评价的结果。","pronunciation":["성적"]},{"id":"bc00bc8172c83d5f","term":"안","zh":"不","audio":"/audio/bc00bc8172c83d5fab70.mp3","entryId":"71372","definition":"表示否定或反对。","pronunciation":["안"]},{"id":"86d0464f1c6da402","term":"좋다","zh":"合适，适用","audio":"/audio/86d0464f1c6da40233cd.mp3","entryId":"79033","definition":"适合用于某种材料或某件事情。","pronunciation":["조ː타"]},{"id":"e75e43b242732d24","term":"취직","zh":"就业，就职","audio":"/audio/e75e43b242732d24d26d.mp3","entryId":"72152","definition":"找到一份工作而去单位上班。","pronunciation":["취ː직"]},{"id":"8aff11a4aebdccdb","term":"잘","zh":"容易","audio":"/audio/8aff11a4aebdccdbf05d.mp3","entryId":"58939","definition":"性质或倾向较易成为某种状态或进行某种行动地。","pronunciation":["잘"]},{"id":"91b4dc2748cba787","term":"되다","zh":"能，行","audio":"/audio/91b4dc2748cba787dd6f.mp3","entryId":"89858","definition":"某个事情可行或被允许。","pronunciation":["되다","뒈다"]}],"audio":"/audio/92918c4db874d592