inese dictionary"}],"surfaceReading":{"term":"왔나","audio":"/audio/e928f4dfbdd4a6b1d413.mp3"}},{"text":"봐요.","meaning":"看来、好像（根据情况推测）","explanation":"보다：看来、好像（根据情况推测）；어요：礼貌句末；可随语调表示陈述或询问。","readings":[{"term":"보다","audio":"/audio/6a45cf834264a5ec3611.mp3"}],"sources":[{"entryId":"62249","senseId":"1","lemma":"보다","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"봐요","audio":"/audio/fc7dc158d915635d6cbc.mp3"}}],"words":[{"id":"79c5ada11647bce6","term":"어제","zh":"昨天，昨日","audio":"/audio/79c5ada11647bce64407.mp3","entryId":"67075","definition":"今天的前一天。","pronunciation":["어제"]},{"id":"b039867287707963","term":"너무","zh":"太","audio":"/audio/b0398672877079631cf2.mp3","entryId":"28183","definition":"已超过一定的程度或限度的状态。","pronunciation":["너무"]},{"id":"2f64811b687303a9","term":"오래","zh":"好久，很久","audio":"/audio/2f64811b687303a9be76.mp3","entryId":"57308","definition":"长时间。","pronunciation":["오래"]},{"id":"96e5ecf6b0d33341","term":"뛰다","zh":"跑，奔跑","audio":"/audio/96e5ecf6b0d33341a17f.mp3","entryId":"74124","definition":"快速挪动双脚，迅速向前行进。","pronunciation":["뛰다"]},{"id":"8bdf6c1c6e18700e","term":"발목","zh":"脚脖子，脚踝","audio":"/audio/8bdf6c1c6e18700e7ba6.mp3","entryId":"56817","definition":"腿和脚连接的部位。","pronunciation":["발목"]},{"id":"a7e5e35fac23a952","term":"무리","zh":"超负荷，吃不消","audio":"/audio/a7e5e35fac23a9526184.mp3","entryId":"15326","definition":"指过度做某事使健康状况变差。","pronunciation":["무리"]},{"id":"6fe577b99594f4a7","term":"오다","zh":"来，产生","audio":"/audio/6fe577b99594f4a7bd8d.mp3","entryId":"69514","definition":"在某个对象上出现某种状态。","pronunciation":["오다"]},{"id":"6a45cf834264a5ec","term":"보다","zh":"看来、好像（根据情况推测）","audio":"/audio/6a45cf834264a5ec3611.mp3","entryId":"62249","definition":"看来、好像（根据情况推测）","pronunciation":["보다"]}],"audio":"/audio/5c8fa5c6fc8caaf580f8.mp3","speakerIndex":1}],"difficulty":3.036,"source":{"url":"https://krdict.korean.go.kr/chn/dicSearch/SearchView?ParaWordNo=15326","label":"国立国语院韩国语—汉语学习词典","license":"https://creativecommons.org/licenses/by-sa/2.0/kr/"},"sour