eaning":"畏惧，害怕","explanation":"겁나다：畏惧，害怕；어：非敬语句末；与熟悉的人或晚辈交谈，语调决定陈述、询问等语气。","readings":[{"term":"겁나다","audio":"/audio/37d8cfa0b69c667428a9.mp3"}],"sources":[{"entryId":"15937","senseId":"1","lemma":"겁나다","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"겁나","audio":"/audio/43e1d36d9e4b3e20dc6e.mp3"}}],"words":[{"id":"f7c6efa694aaef95","term":"그렇다","zh":"那样","audio":"/audio/f7c6efa694aaef9559bd.mp3","entryId":"61178","definition":"表示状态、样子、性质等与此相同。","pronunciation":["그러타"]},{"id":"daac5ca7b302bd9b","term":"선생님","zh":"老师，教师","audio":"/audio/daac5ca7b302bd9b404a.mp3","entryId":"62818","definition":"(敬语)教授学生的人。","pronunciation":["선생님"]},{"id":"b4d47e56735ffcb5","term":"혼나다","zh":"被大骂，被怒斥","audio":"/audio/b4d47e56735ffcb5a8a4.mp3","entryId":"87966","definition":"被严重指责或受罚。","pronunciation":["혼나다"]},{"id":"6a45cf834264a5ec","term":"보다","zh":"怕","audio":"/audio/6a45cf834264a5ec3611.mp3","entryId":"62249","definition":"表示担心或害怕成为前面的话语所指的状况。","pronunciation":["보다"]},{"id":"37d8cfa0b69c6674","term":"겁나다","zh":"畏惧，害怕","audio":"/audio/37d8cfa0b69c667428a9.mp3","entryId":"15937","definition":"心里感到恐惧或惧怕。","pronunciation":["검나다"]}],"audio":"/audio/cbccaf5428d11d902895.mp3","speakerIndex":1}],"difficulty":3.189,"source":{"url":"https://krdict.korean.go.kr/chn/dicSearch/SearchView?ParaWordNo=15937","label":"国立国语院韩国语—汉语学习词典","license":"https://creativecommons.org/licenses/by-sa/2.0/kr/"},"sourceSenseId":"1","sourceLevel":"중급","day":116,"sequenceScore":3.0157,"questions":[{"lineIndex":0,"options":["我们还是把实情告诉老师吧。","那样做的话，怕会被老师骂，好害怕。","我忘了，没带颜料过来呢。"],"answer":0},{"lineIndex":1,"options":["我们还是把实情告诉老师吧。","那样做的话，怕会被老师骂，好害怕。","我忘了，没带颜料过来呢。"],"answer":1}]}
