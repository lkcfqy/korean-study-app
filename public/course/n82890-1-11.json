onunciation":["그만두다"]},{"id":"9986b156ac970834","term":"대학원","zh":"研究生院","audio":"/audio/9986b156ac970834ed38.mp3","entryId":"66290","definition":"大学毕业的人接受专业教育、进行研究的机构。","pronunciation":["대ː하권"]},{"id":"233cb510410b09d6","term":"가다","zh":"去，上","audio":"/audio/233cb510410b09d69cdc.mp3","entryId":"27500","definition":"为某种目的而向某个地方移动。","pronunciation":["가다"]}],"audio":"/audio/ad8a62c0aaeb773dc7bd.mp3","speakerIndex":1}],"difficulty":1.792,"source":{"url":"https://krdict.korean.go.kr/chn/dicSearch/SearchView?ParaWordNo=82890","label":"国立国语院韩国语—汉语学习词典","license":"https://creativecommons.org/licenses/by-sa/2.0/kr/"},"sourceSenseId":"1","sourceLevel":"중급","day":66,"sequenceScore":1.6187,"questions":[{"lineIndex":0,"options":["为什么想要辞职啊？","我想辞掉工作去读研究生。","听说你在市场里把钱包弄丢了？"],"answer":0},{"lineIndex":1,"options":["为什么想要辞职啊？","我想辞掉工作去读研究生。","听说你在市场里把钱包弄丢了？"],"answer":1}]}
