o/389e7564ae2551b4f94d.mp3"}],"sources":[{"entryId":"58161","senseId":"1","lemma":"사람","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"사람을","audio":"/audio/e4ea86ef494eafea0006.mp3"}},{"text":"잘못","meaning":"错","explanation":"잘못：错","readings":[{"term":"잘못","audio":"/audio/cd1c34de004dbb0df843.mp3"}],"sources":[{"entryId":"62478","senseId":"1","lemma":"잘못","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"잘못","audio":"/audio/cd1c34de004dbb0df843.mp3"}},{"text":"봤군요.","meaning":"看，看待","explanation":"보다：看，看待；었：过去或完成，常与词干缩合。；군요：对新发现或新理解的情况表示礼貌的感叹。","readings":[{"term":"보다","audio":"/audio/6a45cf834264a5ec3611.mp3"}],"sources":[{"entryId":"61190","senseId":"4","lemma":"보다","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"봤군요","audio":"/audio/6b0af8290ad9433a9d99.mp3"}}],"words":[{"id":"ee97380efe5d3ee0","term":"교양","zh":"教养，涵养","audio":"/audio/ee97380efe5d3ee0d28e.mp3","entryId":"24040","definition":"以社会经验或学识为基础，在社会生活、文化等各领域积累的知识或品味。","pronunciation":["교ː양"]},{"id":"96fe52db2531c9e7","term":"있다","zh":"处于，处在","audio":"/audio/96fe52db2531c9e73e53.mp3","entryId":"68796","definition":"人或动物继续保持某种状态。","pronunciation":["읻따"]},{"id":"db51ae9b72de3c99","term":"신사","zh":"绅士","audio":"/audio/db51ae9b72de3c99a4ec.mp3","entryId":"14066","definition":"态度庄重，有教养，彬彬有礼的男子。","pronunciation":["신ː사"]},{"id":"4e04e3938cc9c67e","term":"줄","zh":"表示几乎相似的水平或程度。","audio":"/audio/4e04e3938cc9c67ed71b.mp3","entryId":"83176","definition":"表示几乎相似的水平或程度。","pronunciation":["줄"]},{"id":"4646a3463436c8a4","term":"알다","zh":"看做","audio":"/audio/4646a3463436c8a43feb.mp3","entryId":"89445","definition":"对于某个事物或人，认为或觉得如此。","pronunciation":["알ː다"]},{"id":"389e7564ae2551b4","term":"사람","zh":"人","audio":"/audio/389e7564ae2551b4f94d.mp3","entryId":"58161","definition":"可以思考，会制造并使用语言和工具、构成社会而生活的存在。","pronunciation":["사ː람"]},{"id":"cd1c34de004dbb0d","term":"잘못","zh":"错","audio":"/audio/cd1c34de004dbb0df843.mp3","entryId":"62478","definition":"不正或错误地。","p