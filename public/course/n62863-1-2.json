KL Korean-Chinese dictionary"}],"surfaceReading":{"term":"좋아해","audio":"/audio/ef5074f85cc0a689d2ec.mp3"}}],"words":[{"id":"431c5321873ba8ee","term":"진심","zh":"真心","audio":"/audio/431c5321873ba8ee94a2.mp3","entryId":"28997","definition":"真实恳切的心。","pronunciation":["진심"]},{"id":"1098bbe54520ab2a","term":"나","zh":"我","audio":"/audio/1098bbe54520ab2a367c.mp3","entryId":"60931","definition":"说话人在朋友或晚辈面前用来指称自己。","pronunciation":["나"]},{"id":"734dae8e9d9a8f8b","term":"너","zh":"你","audio":"/audio/734dae8e9d9a8f8b763b.mp3","entryId":"64390","definition":"指代听者，用于朋友或晚辈。","pronunciation":["너"]},{"id":"6f24e21fc8cce6bd","term":"정말","zh":"真的","audio":"/audio/6f24e21fc8cce6bd9e56.mp3","entryId":"61174","definition":"没有虚假而真正地。","pronunciation":["정ː말"]},{"id":"74a6aa2fc6ae8f0c","term":"좋아하다","zh":"喜欢","audio":"/audio/74a6aa2fc6ae8f0c6bc1.mp3","entryId":"27929","definition":"珍惜某人而感觉亲密或相互满意。","pronunciation":["조ː아하다"]}],"audio":"/audio/38d3aa48647555bdc759.mp3","speakerIndex":1}],"difficulty":2.205,"source":{"url":"https://krdict.korean.go.kr/chn/dicSearch/SearchView?ParaWordNo=62863","label":"国立国语院韩国语—汉语学习词典","license":"https://creativecommons.org/licenses/by-sa/2.0/kr/"},"sourceSenseId":"1","sourceLevel":"중급","day":73,"sequenceScore":2.0317,"questions":[{"lineIndex":0,"options":["我是认真的。我真的很喜欢你。","你声音怎么了？哪里不舒服吗？","你说要交往，该不会是认真的吧？"],"answer":2},{"lineIndex":1,"options":["我是认真的。我真的很喜欢你。","你说要交往，该不会是认真的吧？","你声音怎么了？哪里不舒服吗？"],"answer":0}]}
