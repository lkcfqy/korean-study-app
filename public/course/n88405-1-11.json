888","senseId":"2","lemma":"하다","origin":"NIKL Korean-Chinese dictionary"}]}],"words":[{"id":"1c0ddfd005093840","term":"네","zh":"是，行","audio":"/audio/1c0ddfd0050938404c35.mp3","entryId":"17294","definition":"用于肯定回答长辈所提出的问题或命令等。","pronunciation":["네"]},{"id":"bc00bc8172c83d5f","term":"안","zh":"不","audio":"/audio/bc00bc8172c83d5fab70.mp3","entryId":"71372","definition":"表示否定或反对。","pronunciation":["안"]},{"id":"82bd547e58bb6509","term":"그래도","zh":"“그리하여도(即便如此)”的缩略语。","audio":"/audio/82bd547e58bb6509909c.mp3","entryId":"36264","definition":"“그리하여도(即便如此)”的缩略语。","pronunciation":[]},{"id":"da78d4146f0588e8","term":"이번","zh":"这次，这回","audio":"/audio/da78d4146f0588e8450a.mp3","entryId":"29737","definition":"马上到来的顺序；或指刚过去的顺序。","pronunciation":["이번"]},{"id":"233cb510410b09d6","term":"가다","zh":"去","audio":"/audio/233cb510410b09d69cdc.mp3","entryId":"27500","definition":"从一个地方移动到另一个地方。","pronunciation":["가다"]},{"id":"505de0a2f6be73fa","term":"하다","zh":"打算做（-려고 하다）","audio":"/audio/505de0a2f6be73fa7758.mp3","entryId":"62888","definition":"打算做（-려고 하다）","pronunciation":["하다"]}],"audio":"/audio/7165a1463f5626b92d2a.mp3","speakerIndex":1}],"difficulty":2.353,"source":{"url":"https://krdict.korean.go.kr/chn/dicSearch/SearchView?ParaWordNo=88405","label":"国立国语院韩国语—汉语学习词典","license":"https://creativecommons.org/licenses/by-sa/2.0/kr/"},"sourceSenseId":"1","sourceLevel":"중급","day":71,"sequenceScore":1.9506,"questions":[{"lineIndex":0,"options":["是的，我本来就打算这次去济州岛。","回去路还远，我就先告辞了。","现在是假期，您不打算去哪儿旅行吗？"],"answer":2},{"lineIndex":1,"options":["是的，我本来就打算这次去济州岛。","现在是假期，您不打算去哪儿旅行吗？","回去路还远，我就先告辞了。"],"answer":0}]}
