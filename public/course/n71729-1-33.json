.mp3"}},{"text":"동안","meaning":"期间","explanation":"동안：期间","readings":[{"term":"동안","audio":"/audio/2aa02e1d6b86b37d7e2b.mp3"}],"sources":[{"entryId":"70749","senseId":"1","lemma":"동안","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"동안","audio":"/audio/2aa02e1d6b86b37d7e2b.mp3"}},{"text":"휴가야.","meaning":"休假，度假，放假，假期","explanation":"휴가：休假，度假，放假，假期；이다：表示“是”的判断形式。；야：非敬语判断或疑问句末，常与 이다 连用。","readings":[{"term":"휴가","audio":"/audio/9e9f8123891fae1cf99f.mp3"}],"sources":[{"entryId":"73251","senseId":"1","lemma":"휴가","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"휴가야","audio":"/audio/283f94f1d5bcd5f9d1e5.mp3"}}],"words":[{"id":"1e07b94ba5182a41","term":"내일","zh":"明天，明日","audio":"/audio/1e07b94ba5182a41e7de.mp3","entryId":"30193","definition":"今天的下一天。","pronunciation":["내일"]},{"id":"6acdbac66e245ba6","term":"글피","zh":"大后天","audio":"/audio/6acdbac66e245ba6c5a7.mp3","entryId":"33473","definition":"以今天为基准的三天之后的那天，后天的下一天。","pronunciation":["글피"]},{"id":"3cd6c40aac5fd42e","term":"삼","zh":"三","audio":"/audio/3cd6c40aac5fd42ef96d.mp3","entryId":"61854","definition":"二加一后所得的数目。","pronunciation":["삼"]},{"id":"dfc76879e2f5c3ea","term":"일","zh":"一日","audio":"/audio/dfc76879e2f5c3ead091.mp3","entryId":"89863","definition":"一天时间。","pronunciation":["일"]},{"id":"2aa02e1d6b86b37d","term":"동안","zh":"期间","audio":"/audio/2aa02e1d6b86b37d7e2b.mp3","entryId":"70749","definition":"从某一时期另一时期之间的时间长度。","pronunciation":["동안"]},{"id":"9e9f8123891fae1c","term":"휴가","zh":"休假，度假，放假，假期","audio":"/audio/9e9f8123891fae1cf99f.mp3","entryId":"73251","definition":"属于工作单位或军队等团体的人在一定期间内从岗位上脱离出来并休息；或指这种时间。","pronunciation":["휴가"]}],"audio":"/audio/f67c5035b4889d47e9d1.mp3","speakerIndex":1}],"difficulty":2.29,"source":{"url":"https://krdict.korean.go.kr/chn/dicSearch/SearchView?ParaWordNo=71729","label":"国立国语院韩国语—汉语学习词典","license":"https://creativecommons.org/licenses/by-sa/2.0/kr/"},"sourceSenseId":"1","sourceLevel":"초급","day":42,"sequenceScore":1.8876,"questions":[{"l