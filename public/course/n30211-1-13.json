io/cd966a69e20cf4c0f61a.mp3","speakerIndex":1}],"difficulty":2.6,"source":{"url":"https://krdict.korean.go.kr/chn/dicSearch/SearchView?ParaWordNo=30211","label":"国立国语院韩国语—汉语学习词典","license":"https://creativecommons.org/licenses/by-sa/2.0/kr/"},"sourceSenseId":"1","sourceLevel":"초급","day":42,"sequenceScore":1.8511,"questions":[{"lineIndex":0,"options":["再坐三分钟车就到洗手间了。","因为要坐车三个小时以上，我们先去趟洗手间吧。","还有三个小时才出发，先别去洗手间。"],"answer":1},{"lineIndex":1,"options":["男洗手间在那边，女洗手间在这边。","男洗手间和女洗手间都在楼上。","好啊。男洗手间在这边，女洗手间在那边。"],"answer":2}]}
