4c35.mp3"}],"sources":[{"entryId":"17294","senseId":"2","lemma":"네","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"네","audio":"/audio/1c0ddfd0050938404c35.mp3"}},{"text":"다음","meaning":"以后，下次","explanation":"다음：以后，下次","readings":[{"term":"다음","audio":"/audio/aef613c6612d424ab454.mp3"}],"sources":[{"entryId":"64531","senseId":"5","lemma":"다음","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"다음","audio":"/audio/aef613c6612d424ab454.mp3"}},{"text":"학기","meaning":"学期","explanation":"학기：学期","readings":[{"term":"학기","audio":"/audio/a95c145d8eb8427ea655.mp3"}],"sources":[{"entryId":"72420","senseId":"1","lemma":"학기","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"학기","audio":"/audio/a95c145d8eb8427ea655.mp3"}},{"text":"학비를","meaning":"学费","explanation":"학비：学费；를：宾格助词，标记动作对象。","readings":[{"term":"학비","audio":"/audio/89e35481560c314cbf55.mp3"}],"sources":[{"entryId":"84362","senseId":"1","lemma":"학비","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"학비를","audio":"/audio/65f097aac09c3fe87b17.mp3"}},{"text":"벌어야","meaning":"赚，挣","explanation":"벌다：赚，挣；어야：表示必要条件；与 하다/되다 合用表示“应该、必须”。","readings":[{"term":"벌다","audio":"/audio/0c2e9654aebad7fa3ddc.mp3"}],"sources":[{"entryId":"59096","senseId":"1","lemma":"벌다","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"벌어야","audio":"/audio/aadeca3bfc51cfbb7408.mp3"}},{"text":"해요.","meaning":"应该、必须（与前面的 -아/어야 合用）","explanation":"하다：应该、必须（与前面的 -아/어야 合用）；어요：礼貌句末；可随语调表示陈述或询问。","readings":[{"term":"하다","audio":"/audio/505de0a2f6be73fa7758.mp3"}],"sources":[{"entryId":"62888","senseId":"4","lemma":"하다","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"해요","audio":"/audio/521029965a4dd3b2882e.mp3"}}],"words":[{"id":"1c0ddfd005093840","term":"네","zh":"是，行","audio":"/audio/1c0ddfd0050938404c35.mp3","entryId":"17294","definition":"用于肯定回答长辈所提出的问题或命令等。","pronunciation":["네"]},{"id":"aef613c6612d424a","term":"다음","zh":"以后，下次","aud