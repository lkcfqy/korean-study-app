ictionary"}],"surfaceReading":{"term":"화장품을","audio":"/audio/9c46df752ef1fcd79520.mp3"}},{"text":"써","meaning":"用，使用","explanation":"쓰다：用，使用；어：连接后续动作或辅助表达；常与前面的词干缩合。","readings":[{"term":"쓰다","audio":"/audio/e5721a077be2e027ff8c.mp3"}],"sources":[{"entryId":"71285","senseId":"1","lemma":"쓰다","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"써","audio":"/audio/a56108d30e19595a1562.mp3"}},{"text":"봐.","meaning":"试着做（-아/어 보다）","explanation":"보다：试着做（-아/어 보다）；어：非敬语句末；与熟悉的人或晚辈交谈，语调决定陈述、询问等语气。","readings":[{"term":"보다","audio":"/audio/6a45cf834264a5ec3611.mp3"}],"sources":[{"entryId":"62171","senseId":"1","lemma":"보다","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"봐","audio":"/audio/fdcffec86114c54dd4e0.mp3"}}],"words":[{"id":"e7fc6a47e7b42f93","term":"모공","zh":"毛孔","audio":"/audio/e7fc6a47e7b42f93c681.mp3","entryId":"55478","definition":"长出毛发的小孔。","pronunciation":["모공"]},{"id":"224d0b9fb5b5e50c","term":"위축","zh":"萎缩，枯萎","audio":"/audio/224d0b9fb5b5e50c0986.mp3","entryId":"69943","definition":"因变干或凋谢而变得枯萎或体积变小。","pronunciation":["위축"]},{"id":"7feaaecf170e0c6a","term":"돕다","zh":"增进，增补，促进","audio":"/audio/7feaaecf170e0c6a578f.mp3","entryId":"17203","definition":"使某种状态变得更好或使其更加积极地发生作用。","pronunciation":["돕ː따"]},{"id":"740b80a0f4f8ee40","term":"화장품","zh":"化妆品","audio":"/audio/740b80a0f4f8ee4087dd.mp3","entryId":"73232","definition":"为了美观或护理皮肤而涂抹在脸上的物品。","pronunciation":["화장품"]},{"id":"e5721a077be2e027","term":"쓰다","zh":"用，使用","audio":"/audio/e5721a077be2e027ff8c.mp3","entryId":"71285","definition":"做某事时利用材料、工具等。","pronunciation":["쓰다"]},{"id":"6a45cf834264a5ec","term":"보다","zh":"试着做（-아/어 보다）","audio":"/audio/6a45cf834264a5ec3611.mp3","entryId":"62171","definition":"试着做（-아/어 보다）","pronunciation":["보다"]}],"audio":"/audio/63ab7c992e2cbd0abe9f.mp3","speakerIndex":1}],"difficulty":3.264,"source":{"url":"https://krdict.korean.go.kr/chn/dicSearch/SearchView?ParaWordNo=69943","label":"国立国语院韩国语—汉语学习词典","license":"https://creativecommons.org/li