orean-Chinese dictionary"}],"surfaceReading":{"term":"하나도","audio":"/audio/11c4172e3e9554b54380.mp3"}},{"text":"안","meaning":"不","explanation":"안：不。","readings":[{"term":"안","audio":"/audio/bc00bc8172c83d5fab70.mp3"}],"sources":[{"entryId":"71372","senseId":"1","lemma":"안","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"안","audio":"/audio/bc00bc8172c83d5fab70.mp3"}},{"text":"무서워요.","meaning":"怕，害怕，可怕，恐惧","explanation":"무섭다：怕，害怕，可怕，恐惧；어요：礼貌句末；可随语调表示陈述或询问。","readings":[{"term":"무섭다","audio":"/audio/6c5692ebced898c0376c.mp3"}],"sources":[{"entryId":"55637","senseId":"1","lemma":"무섭다","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"무서워요","audio":"/audio/b0374fe525da295a32e0.mp3"}}],"words":[{"id":"ac0e9ef613fd92c8","term":"저","zh":"我","audio":"/audio/ac0e9ef613fd92c84845.mp3","entryId":"44506","definition":"说话人在听话人面前对自己的谦称。","pronunciation":["저"]},{"id":"6e2d3a22bfedf802","term":"인제","zh":"现在，到现在","audio":"/audio/6e2d3a22bfedf802a6d9.mp3","entryId":"25104","definition":"此时；或指此时之前不久的时间。","pronunciation":["인제"]},{"id":"9d309cd460ea409c","term":"혼자","zh":"独自，单独","audio":"/audio/9d309cd460ea409c50fb.mp3","entryId":"30207","definition":"只有一人，没有别人。","pronunciation":["혼자"]},{"id":"023aa5fb34178979","term":"자다","zh":"睡，睡觉","audio":"/audio/023aa5fb341789792a99.mp3","entryId":"69511","definition":"闭眼睛，停止身体、精神活动，一时进入休息状态。","pronunciation":["자다"]},{"id":"ffcedfda7558e5dc","term":"거","zh":"某种事物、现象或事实。","audio":"/audio/ffcedfda7558e5dc31fe.mp3","entryId":"62331","definition":"某种事物、现象或事实。","pronunciation":["거"]},{"id":"556dcbf069a950eb","term":"하나","zh":"完全","audio":"/audio/556dcbf069a950eb94f3.mp3","entryId":"20283","definition":"全然，毫无。","pronunciation":["하나"]},{"id":"bc00bc8172c83d5f","term":"안","zh":"不","audio":"/audio/bc00bc8172c83d5fab70.mp3","entryId":"71372","definition":"表示否定或反对。","pronunciation":["안"]},{"id":"6c5692ebced898c0","term":"무섭다","zh":"怕，害怕，可怕，恐惧","audio":"/audio/6c5692ebced898c0376c.mp3","entryId":"55637","definition":"忌讳