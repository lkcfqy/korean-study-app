ry"}],"surfaceReading":{"term":"남매네요","audio":"/audio/456447b5ae7d30f4aee3.mp3"}}],"words":[{"id":"6f24e21fc8cce6bd","term":"정말","zh":"真的","audio":"/audio/6f24e21fc8cce6bd9e56.mp3","entryId":"61173","definition":"用于强调自己所说的话。","pronunciation":["정ː말"]},{"id":"6a45cf834264a5ec","term":"보다","zh":"看，观看，观赏","audio":"/audio/6a45cf834264a5ec3611.mp3","entryId":"61190","definition":"用眼睛享受或欣赏某个对象。","pronunciation":["보다"]},{"id":"86d0464f1c6da402","term":"좋다","zh":"好，美，优良，优美","audio":"/audio/86d0464f1c6da40233cd.mp3","entryId":"79033","definition":"性质或内容等很优秀，让人满意。","pronunciation":["조ː타"]},{"id":"2633d546c99bb4e3","term":"남매","zh":"兄妹","audio":"/audio/2633d546c99bb4e3e98e.mp3","entryId":"37834","definition":"哥哥与妹妹。","pronunciation":["남매"]}],"audio":"/audio/6c91b75016e34f03e630.mp3","speakerIndex":1}],"difficulty":1.898,"source":{"url":"https://krdict.korean.go.kr/chn/dicSearch/SearchView?ParaWordNo=37834","label":"国立国语院韩国语—汉语学习词典","license":"https://creativecommons.org/licenses/by-sa/2.0/kr/"},"sourceSenseId":"1","sourceLevel":"중급","day":66,"sequenceScore":1.6233,"questions":[{"lineIndex":0,"options":["这位就是我哥哥。","真是让人看着赏心悦目的一对兄妹。","能请您到这边来帮我一下吗？"],"answer":0},{"lineIndex":1,"options":["这位就是我哥哥。","真是让人看着赏心悦目的一对兄妹。","能请您到这边来帮我一下吗？"],"answer":1}]}
