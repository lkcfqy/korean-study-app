c31fe.mp3"}],"sources":[{"entryId":"62331","senseId":"5","lemma":"거","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"거래요","audio":"/audio/b966196fc4e738c2fcf6.mp3"}}],"words":[{"id":"1c0ddfd005093840","term":"네","zh":"是，是的，哎","audio":"/audio/1c0ddfd0050938404c35.mp3","entryId":"17294","definition":"用于回应长辈的呼叫。","pronunciation":["네"]},{"id":"8df56b9bfbdae2fd","term":"그래서","zh":"因此，所以","audio":"/audio/8df56b9bfbdae2fd8463.mp3","entryId":"61169","definition":"用于表示前面内容是后面内容的原因、依据或条件等。","pronunciation":["그래서"]},{"id":"36d7e2795dabf3c6","term":"야채","zh":"蔬菜","audio":"/audio/36d7e2795dabf3c6d89a.mp3","entryId":"90066","definition":"在田里种植，主要以叶子、茎干或果实供使用的农作物。","pronunciation":["야ː채"]},{"id":"b19ddf94b4c9896b","term":"값","zh":"价格，价钱","audio":"/audio/b19ddf94b4c9896bb5c6.mp3","entryId":"20178","definition":"给买卖的东西划定的货币数量。","pronunciation":["갑"]},{"id":"1af2aeb1be04021c","term":"많이","zh":"多","audio":"/audio/1af2aeb1be04021c7be5.mp3","entryId":"66030","definition":"数、量、程度等超过一定标准地。","pronunciation":["마ː니"]},{"id":"8fdeb9822b3fa061","term":"오르다","zh":"上升，上涨","audio":"/audio/8fdeb9822b3fa0617051.mp3","entryId":"69518","definition":"价格、数值、温度、成绩等比以前多或高。","pronunciation":["오르다"]},{"id":"ffcedfda7558e5dc","term":"거","zh":"表示说话人的推测或信念等。","audio":"/audio/ffcedfda7558e5dc31fe.mp3","entryId":"62331","definition":"表示说话人的推测或信念等。","pronunciation":["거"]}],"audio":"/audio/54783b29628c56cfce79.mp3","speakerIndex":1}],"difficulty":2.568,"source":{"url":"https://krdict.korean.go.kr/chn/dicSearch/SearchView?ParaWordNo=61169","label":"国立国语院韩国语—汉语学习词典","license":"https://creativecommons.org/licenses/by-sa/2.0/kr/"},"sourceSenseId":"1","sourceLevel":"초급","day":37,"sequenceScore":1.6163,"questions":[{"lineIndex":0,"options":["对。所以蔬菜的价格也会大幅上涨呢。","您为什么带着护照出来呢？","天气预报说今年夏天会下很多雨，对吧？"],"answer":2},{"lineIndex":1,"options":["对。所以蔬菜的价格也会大幅上涨呢。","天气预报说今年夏天会下很多雨，对吧？","您为什么带着护照出来呢？"],"answer":0}]}
