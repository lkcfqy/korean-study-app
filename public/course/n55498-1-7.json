583","senseId":"1","lemma":"않다","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"않아서","audio":"/audio/56e46f9e2892c9f61489.mp3"}},{"text":"우유를","meaning":"牛奶","explanation":"우유：牛奶；를：宾格助词，标记动作对象。","readings":[{"term":"우유","audio":"/audio/2b7e75051be2c51a0337.mp3"}],"sources":[{"entryId":"26890","senseId":"1","lemma":"우유","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"우유를","audio":"/audio/8e487234a46dde7c9ea4.mp3"}},{"text":"먹이고","meaning":"喂，给......吃","explanation":"먹이다：喂，给......吃；고：连接并列或先后的动作、状态；也用于 -고 있다 等搭配。","readings":[{"term":"먹이다","audio":"/audio/046ac878d568614edecf.mp3"}],"sources":[{"entryId":"61953","senseId":"1","lemma":"먹이다","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"먹이고","audio":"/audio/a120161e331257dd2cfa.mp3"}},{"text":"있어요.","meaning":"正在做、持续进行（-고 있다）","explanation":"있다：正在做、持续进行（-고 있다）；어요：礼貌句末；可随语调表示陈述或询问。","readings":[{"term":"있다","audio":"/audio/96fe52db2531c9e73e53.mp3"}],"sources":[{"entryId":"62595","senseId":"2","lemma":"있다","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"있어요","audio":"/audio/499f8423f214354759ff.mp3"}}],"words":[{"id":"9474acc7539b7e2c","term":"아니요","zh":"不是，不用","audio":"/audio/9474acc7539b7e2cedaf.mp3","entryId":"17189","definition":"用于否定回答长辈所提出的问题。","pronunciation":["아니요"]},{"id":"ffd4c47d960fe8a9","term":"젖","zh":"乳，奶","audio":"/audio/ffd4c47d960fe8a968f3.mp3","entryId":"31770","definition":"从生孩子或崽子的人或动物的乳房中分泌出来的白色甜汁。","pronunciation":["젇"]},{"id":"8aff11a4aebdccdb","term":"잘","zh":"容易","audio":"/audio/8aff11a4aebdccdbf05d.mp3","entryId":"58939","definition":"性质或倾向较易成为某种状态或进行某种行动地。","pronunciation":["잘"]},{"id":"038a8038eb817ffe","term":"나오다","zh":"流出，漏出，涌出","audio":"/audio/038a8038eb817ffef26e.mp3","entryId":"62233","definition":"液体或气体等从里面流到外面。","pronunciation":["나오다"]},{"id":"b69b8939cafeac28","term":"않다","zh":"不","audio":"/audio/b69b8939cafeac284ca7.mp3","entryId":"71583","definition":"用于否定前文所指的状态。","pronunciation":["안타"]},{"id":"2b7e75051be2c51a","term":"우유","zh":"牛奶","audio":"/audio/2b7e75051be2c51a0337.mp3","entryId":"26890","definition":"母牛产的奶，制作冰淇淋、黄油、奶酪等时使用的白色液体。","pronunciation":["우유"]},{"id":"046ac878d568614e","term":"먹이다","zh":"喂，给......吃","audio":"/audio/046ac878d568614edecf.mp3","entryId":"61953","definition":"将食物送进人嘴里并使其咽下。","pronunciation":["머기다"]},{"id":"96fe52db2531c9e7","term":"있다","zh":"正在做、持续进行（-고 있다）","audio":"/audio/96fe52db2531c9e73e53.mp3","entryId":"62595","definition":"正在做、持续进行（-고 있다）","pronunciation":["읻따"]}],"audio":"/audio/2b1d46dc0b5b00677eef.mp3","speakerIndex":1}],"difficulty":3.402,"source":{"url":"https://krdict.korean.go.kr/chn/dicSearch/SearchView?ParaWordNo=55498","label":"国立国语院韩国语—汉语学习词典","license":"https://creativecommons.org/licenses/by-sa/2.0/kr/"},"sourceSenseId":"1","sourceLevel":"고급","day":163,"sequenceScore":3.2287,"questions":[{"lineIndex":0,"options":["裕敏女士是在给女儿喂母乳吗？","不是的。因为奶水不够，所以现在喂奶粉。","承奎说现在不会再离家出走了吗？"],"answer":0},{"lineIndex":1,"options":["裕敏女士是在给女儿喂母乳吗？","不是的。因为奶水不够，所以现在喂奶粉。","承奎说现在不会再离家出走了吗？"],"answer":1}]}
