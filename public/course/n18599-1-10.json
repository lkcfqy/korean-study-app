04c35.mp3"}],"sources":[{"entryId":"17294","senseId":"1","lemma":"네","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"네","audio":"/audio/1c0ddfd0050938404c35.mp3"}},{"text":"내부가","meaning":"里面，里边，内部","explanation":"내부：里面，里边，内部；가：主格助词，标记主语。","readings":[{"term":"내부","audio":"/audio/4dfe0970820370019950.mp3"}],"sources":[{"entryId":"28431","senseId":"1","lemma":"내부","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"내부가","audio":"/audio/b8b0224260304f44e71e.mp3"}},{"text":"너무","meaning":"太","explanation":"너무：太。","readings":[{"term":"너무","audio":"/audio/b0398672877079631cf2.mp3"}],"sources":[{"entryId":"28183","senseId":"1","lemma":"너무","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"너무","audio":"/audio/b0398672877079631cf2.mp3"}},{"text":"낡아서","meaning":"老旧，破旧","explanation":"낡다：老旧，破旧；어서：连接原因与结果，或前后相接的动作。","readings":[{"term":"낡다","audio":"/audio/294c650cb539ffd87149.mp3"}],"sources":[{"entryId":"36846","senseId":"1","lemma":"낡다","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"낡아서","audio":"/audio/51776397c240d56cf9f4.mp3"}},{"text":"개조를","meaning":"改造","explanation":"개조：改造；를：宾格助词，标记动作对象。","readings":[{"term":"개조","audio":"/audio/4ca234f1363ffe36d754.mp3"}],"sources":[{"entryId":"18599","senseId":"1","lemma":"개조","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"개조를","audio":"/audio/b1636ffc01bb1373de68.mp3"}},{"text":"했거든요.","meaning":"做，干","explanation":"하다：做，干；었：过去或完成，常与词干缩合；거든요：礼貌地补充理由或背景。","readings":[{"term":"하다","audio":"/audio/505de0a2f6be73fa7758.mp3"}],"sources":[{"entryId":"73277","senseId":"1","lemma":"하다","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"했거든요","audio":"/audio/5c7c4b0cdcf6a916e3d5.mp3"}}],"words":[{"id":"1c0ddfd005093840","term":"네","zh":"是，是的，哎","audio":"/audio/1c0ddfd0050938404c35.mp3","entryId":"17294","definition":"用于回应长辈的呼叫。","pronunciation":["네"]},{"id":"4dfe097082037001","term":"내부","zh":"里面，里边，内部","audio":"/au