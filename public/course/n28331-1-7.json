27,"sequenceScore":2.2827,"questions":[{"lineIndex":0,"options":["妈妈，那只长得像狗的动物叫什么？","那是狼。","这个问题为什么答错了呢？"],"answer":0},{"lineIndex":1,"options":["妈妈，那只长得像狗的动物叫什么？","那是狼。","这个问题为什么答错了呢？"],"answer":1}]}
