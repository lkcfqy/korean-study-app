ean-Chinese dictionary"}],"surfaceReading":{"term":"깊어","audio":"/audio/eae13f78f568bb4485a4.mp3"}},{"text":"그렇지?","meaning":"是呀，就是","explanation":"그렇지：是呀，就是","readings":[{"term":"그렇지","audio":"/audio/66da57bd505cc1e1c679.mp3"}],"sources":[{"entryId":"26031","senseId":"1","lemma":"그렇지","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"그렇지","audio":"/audio/66da57bd505cc1e1c679.mp3"}}],"words":[{"id":"398dfa639dfd0db8","term":"우리","zh":"我们，咱们","audio":"/audio/398dfa639dfd0db8f8e0.mp3","entryId":"17182","definition":"说话人指代自己和听话人在内的一些人。","pronunciation":["우리"]},{"id":"f7b9c878ccca829a","term":"학교","zh":"学校","audio":"/audio/f7b9c878ccca829ab6ab.mp3","entryId":"73276","definition":"按照一定的目标、教育课程、制度等，教师对学生进行教育的机构。","pronunciation":["학꾜"]},{"id":"15b3a52aa55bea03","term":"법대","zh":"法学院","audio":"/audio/15b3a52aa55bea030c0b.mp3","definition":"법과 대학 的简称。","pronunciation":[]},{"id":"4f5275b217d6318a","term":"역사","zh":"历史","audio":"/audio/4f5275b217d6318a8404.mp3","entryId":"62515","definition":"事物、事情或自然现象等变化来的过程。","pronunciation":["역싸"]},{"id":"8e09b5f4c09195e3","term":"참","zh":"真，实在，的确","audio":"/audio/8e09b5f4c09195e322ba.mp3","entryId":"71761","definition":"毫不违背事实或道理，真正地。","pronunciation":["참"]},{"id":"89e1deb137581102","term":"깊다","zh":"久，悠久，深","audio":"/audio/89e1deb137581102f2b2.mp3","entryId":"45157","definition":"时间久远。","pronunciation":["깁따"]},{"id":"66da57bd505cc1e1","term":"그렇지","zh":"是呀，就是","audio":"/audio/66da57bd505cc1e1c679.mp3","entryId":"26031","definition":"某个事实与自己所想的一致时，以感叹的语气所说的话。","pronunciation":["그러치"]}],"audio":"/audio/198da99d20019c3feeb9.mp3","speakerIndex":0},{"id":"n58742-1-7-2","ko":"응. 그동안 많은 법률가를 배출해 내었지.","zh":"对啊，至今已经培养出了很多法律人才呢。","note":"点不懂的词，看本句词义、助词和语尾；听词语后，再听整句。","parts":[{"text":"응.","meaning":"是，行","explanation":"응：是，行","readings":[{"term":"응","audio":"/audio/107dd01c3d38a368ad44.mp3"}],"sources":[{"entryId":"30205","senseId":"2","lemma":"응","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"응","audio":"/audio/107dd01c3d38a368ad44.mp3"}},{"text":"그동안","meaning":"近来，这段时间","explanation":"그동안：近来，这段时间","readings":[{"term":"그동안","audio":"/audio/d33dc138cdc9a561307b.mp3"}],"sources":[{"entryId":"60236","senseId":"1","lemma":"그동안","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"그동안","audio":"/audio/d33dc138cdc9a561307b.mp3"}},{"text":"많은","meaning":"多，丰富，强","explanation":"많다：多，丰富，强；은：修饰后面的名词。形容词后表示当前性质；动词后通常表示已完成的动作或结果状态。","readings":[{"term":"많다","audio":"/audio/b30b4bf6ab97d6a55225.mp3"}],"sources":[{"entryId":"69295","senseId":"1","lemma":"많다","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"많은","audio":"/audio/dac1aa733d550e544bce.mp3"}},{"text":"법률가를","meaning":"法律专家","explanation":"법률가：法律专家；를：宾格助词，标记动作对象。","readings":[{"term":"법률가","audio":"/audio/c831c930df7764351270.mp3"}],"sources":[{"entryId":"58742","senseId":"1","lemma":"법률가","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"법률가를","audio":"/audio/2a704c5e04d35b658865.mp3"}},{"text":"배출해","meaning":"培养出，培育出","explanation":"배출하다：培养出，培育出；어：连接后续动作或辅助表达；常与前面的词干缩合。","readings":[{"term":"배출하다","audio":"/audio/8023237aaf3f6fc27a12.mp3"}],"sources":[{"entryId":"93401","senseId":"1","lemma":"배출하다","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"배출해","audio":"/audio/10be456c7dd8901367b4.mp3"}},{"text":"내었지.","meaning":"表示前句中的行动依靠自己的力量最终得以实现。","explanation":"내다：表示前句中的行动依靠自己的力量最终得以实现。；었：过去或完成，常与词干缩合。；지：表示确认、提醒、意愿或自问等，非敬语句末。","readings":[{"term":"내다","audio":"/audio/3c7ab23f77767092623c.mp3"}],"sources":[{"entryId":"60625","senseId":"1","lemma":"내다","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"내었지","audio":"/audio/91b235175eae4d063676.mp3"}}],"words":[{"id":"107dd01c3d38a368","term":"응","zh":"是，行","audio":"/audio/107dd01c3d38a368ad44.mp3","entryId":"30205","definition":"用于肯定回答对方所提出的问题或命令等。","pronunciation":["응"]},{"id":"d33dc138cdc9a561","term":"그동안","zh":"近来，这段时间","audio":"/audio/d33dc138cdc9a561307b.mp3","entry