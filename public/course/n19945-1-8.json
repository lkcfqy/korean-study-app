L Korean-Chinese dictionary"}],"surfaceReading":{"term":"고리에","audio":"/audio/beaced0e39856dac62a0.mp3"}},{"text":"끼워서","meaning":"插进，夹入","explanation":"끼우다：插进，夹入；어서：连接原因与结果，或前后相接的动作。","readings":[{"term":"끼우다","audio":"/audio/2e5e463dcd04fed871e1.mp3"}],"sources":[{"entryId":"28299","senseId":"2","lemma":"끼우다","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"끼워서","audio":"/audio/51f0e025865a70668966.mp3"}},{"text":"가지고","meaning":"持，带，戴","explanation":"가지다：持，带，戴；고：连接并列或先后的动作、状态；也用于 -고 있다 等搭配。","readings":[{"term":"가지다","audio":"/audio/f3b684d86e5485ededb3.mp3"}],"sources":[{"entryId":"65234","senseId":"1","lemma":"가지다","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"가지고","audio":"/audio/2e847f33430d128ed48a.mp3"}},{"text":"다니잖아.","meaning":"常去","explanation":"다니다：常去；잖아：提醒对方已知的事实，非敬语：“不是……嘛”。","readings":[{"term":"다니다","audio":"/audio/02309ed22c9c36273e57.mp3"}],"sources":[{"entryId":"29702","senseId":"1","lemma":"다니다","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"다니잖아","audio":"/audio/a1a7989887c9bef60a79.mp3"}}],"words":[{"id":"734dae8e9d9a8f8b","term":"너","zh":"你","audio":"/audio/734dae8e9d9a8f8b763b.mp3","entryId":"64390","definition":"指代听者，用于朋友或晚辈。","pronunciation":["너"]},{"id":"5bebbcbf30ba30c0","term":"열쇠","zh":"钥匙","audio":"/audio/5bebbcbf30ba30c05971.mp3","entryId":"26888","definition":"可以锁上或打开门锁的工具。","pronunciation":["열ː쐬","열ː쒜"]},{"id":"4901a1242719de24","term":"한꺼번에","zh":"一下子","audio":"/audio/4901a1242719de241339.mp3","entryId":"72431","definition":"合起来一次就；或指全部都同时。","pronunciation":["한꺼버네"]},{"id":"201e252151b40586","term":"고리","zh":"环，圈","audio":"/audio/201e252151b4058637da.mp3","entryId":"19945","definition":"把铁条、绳子或带子弯曲连接而成的圆形的东西。","pronunciation":["고리"]},{"id":"2e5e463dcd04fed8","term":"끼우다","zh":"插进，夹入","audio":"/audio/2e5e463dcd04fed871e1.mp3","entryId":"28299","definition":"为了避免掉落，使其勾起来或别起来。","pronunciation":["끼우다"]},{"id":"f3b684d86e5485ed","term":"가지다","zh":"持，带，戴","audio":"/aud