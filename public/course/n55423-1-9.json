11.mp3"}],"sources":[{"entryId":"62171","senseId":"1","lemma":"보다","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"봐","audio":"/audio/fdcffec86114c54dd4e0.mp3"}}],"words":[{"id":"d2f51d1cd32c797e","term":"멜로디","zh":"旋律","audio":"/audio/d2f51d1cd32c797ecca3.mp3","entryId":"55423","definition":"抑扬顿挫的音的节奏。","pronunciation":[]},{"id":"9d4e17cb57a7915a","term":"무척","zh":"非常，很","audio":"/audio/9d4e17cb57a7915a0528.mp3","entryId":"55175","definition":"程度深得别的无法与之相比。","pronunciation":["무척"]},{"id":"86d0464f1c6da402","term":"좋다","zh":"喜爱，喜欢","audio":"/audio/86d0464f1c6da40233cd.mp3","entryId":"79033","definition":"某事或某个对象很称心、很满意。","pronunciation":["조ː타"]},{"id":"1098bbe54520ab2a","term":"나","zh":"我","audio":"/audio/1098bbe54520ab2a367c.mp3","entryId":"60931","definition":"说话人在朋友或晚辈面前用来指称自己。","pronunciation":["나"]},{"id":"20ef19694f337fd4","term":"모르다","zh":"不知不觉","audio":"/audio/20ef19694f337fd42539.mp3","entryId":"29712","definition":"在无意中不自觉地做出某种行为或说出某种话。","pronunciation":["모ː르다"]},{"id":"d4731f4f4e5bee64","term":"흥얼거리다","zh":"哼唱，哼哼","audio":"/audio/d4731f4f4e5bee6429f5.mp3","entryId":"89525","definition":"因兴致高或心情好而嘴里一直唱歌。","pronunciation":["흥얼거리다"]},{"id":"6a45cf834264a5ec","term":"보다","zh":"看来、好像（根据情况推测）","audio":"/audio/6a45cf834264a5ec3611.mp3","entryId":"62171","definition":"看来、好像（根据情况推测）","pronunciation":["보다"]}],"audio":"/audio/96590cca4a36a57202e6.mp3","speakerIndex":1}],"difficulty":2.953,"source":{"url":"https://krdict.korean.go.kr/chn/dicSearch/SearchView?ParaWordNo=55423","label":"国立国语院韩国语—汉语学习词典","license":"https://creativecommons.org/licenses/by-sa/2.0/kr/"},"sourceSenseId":"1","sourceLevel":"중급","day":106,"sequenceScore":2.7797,"questions":[{"lineIndex":0,"options":["因为旋律太好听了，所以不知不觉就跟着哼起来了吧。","你在那儿哼什么呀？","天气热得要命，根本什么都做不了。"],"answer":1},{"lineIndex":1,"options":["你在那儿哼什么呀？","天气热得要命，根本什么都做不了。","因为旋律太好听了，所以不知不觉就跟着哼起来了吧。"],"answer":2}]}
