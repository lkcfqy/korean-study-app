86532a073e7.mp3"}],"sources":[{"entryId":"32206","senseId":"1","lemma":"부부","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"부부입니다","audio":"/audio/925148e678e2e0ec32c5.mp3"}},{"text":"이쪽이","meaning":"这边，这位","explanation":"이쪽：这边，这位；이：主格助词，标记主语。","readings":[{"term":"이쪽","audio":"/audio/ceea9a2e61410973dfd8.mp3"}],"sources":[{"entryId":"71694","senseId":"3","lemma":"이쪽","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"이쪽이","audio":"/audio/ac05d24ccdfbd16f9dc5.mp3"}},{"text":"제","meaning":"我","explanation":"저：我；의：所属、关联或修饰，常对应“的”。","readings":[{"term":"저","audio":"/audio/ac0e9ef613fd92c84845.mp3"}],"sources":[{"entryId":"44506","senseId":"1","lemma":"저","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"제","audio":"/audio/b94e182b9a95d9dc2329.mp3"}},{"text":"파트너예요.","meaning":"配偶","explanation":"파트너：配偶；이다：表示“是”的判断形式。；예요：礼貌句末；可随语调表示陈述或询问。","readings":[{"term":"파트너","audio":"/audio/5f361cd1bcb7c7231109.mp3"}],"sources":[{"entryId":"80651","senseId":"3","lemma":"파트너","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"파트너예요","audio":"/audio/f4215c7d389fb886ae78.mp3"}}],"words":[{"id":"d6ce479be9ddc9b7","term":"아","zh":"咦","audio":"/audio/d6ce479be9ddc9b7de97.mp3","entryId":"16247","definition":"感到惊讶、慌张、焦急、急促时发出的声音。","pronunciation":["아"]},{"id":"75d5f0d25c8827a5","term":"저희","zh":"我们","audio":"/audio/75d5f0d25c8827a5d019.mp3","entryId":"71231","definition":"说话人亲切地指代与自己有关的一些对象。一般对比自己身份地位高的人使用。","pronunciation":["저히"]},{"id":"5b6b5a16786532a0","term":"부부","zh":"夫妻，夫妇","audio":"/audio/5b6b5a16786532a073e7.mp3","entryId":"32206","definition":"丈夫与妻子。","pronunciation":["부부"]},{"id":"ceea9a2e61410973","term":"이쪽","zh":"这边，这位","audio":"/audio/ceea9a2e61410973dfd8.mp3","entryId":"71694","definition":"指代离说话人近的人或人群。","pronunciation":["이쪽"]},{"id":"ac0e9ef613fd92c8","term":"저","zh":"我","audio":"/audio/ac0e9ef613fd92c84845.mp3","entryId":"44506","definition":"说话人在听话人面前对自己的谦称。","pronunciation":["저"]},{"id":"