":"1","lemma":"호텔","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"호텔","audio":"/audio/a8c93b78e5f25669c2a4.mp3"}},{"text":"뷔페에서","meaning":"自助餐","explanation":"뷔페：自助餐；에서：格助词，表示动作发生的地点或出发点。","readings":[{"term":"뷔페","audio":"/audio/6d0e2a824abd9d8a9048.mp3"}],"sources":[{"entryId":"61014","senseId":"1","lemma":"뷔페","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"뷔페에서","audio":"/audio/fb43d413de1c30bb2ef1.mp3"}},{"text":"한대.","meaning":"表示想法或推测。","explanation":"하다：表示想法或推测；ㄴ대：口语中转述听来的话，非敬语。","readings":[{"term":"하다","audio":"/audio/505de0a2f6be73fa7758.mp3"}],"sources":[{"entryId":"73277","senseId":"27","lemma":"하다","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"한대","audio":"/audio/ecbeb5d6ac1f114dc58c.mp3"}}],"words":[{"id":"3d92a9bd2ba3feb9","term":"큰아버지","zh":"伯父，伯伯，大爷","audio":"/audio/3d92a9bd2ba3feb9613e.mp3","entryId":"28175","definition":"用于指称或称呼父亲的哥哥。","pronunciation":["크나버지"]},{"id":"b28234f58fda0d85","term":"칠순","zh":"七旬，古稀","audio":"/audio/b28234f58fda0d85f6e6.mp3","entryId":"80695","definition":"七十岁。","pronunciation":["칠쑨"]},{"id":"e8a89a5a9e100e5f","term":"잔치","zh":"宴会，喜宴","audio":"/audio/e8a89a5a9e100e5f86cd.mp3","entryId":"69897","definition":"有喜事时，摆上食物许多人聚在一起享用。","pronunciation":["잔치"]},{"id":"a9a589172180b16e","term":"초대장","zh":"邀请函","audio":"/audio/a9a589172180b16ef930.mp3","entryId":"80507","definition":"为了邀请客人参加某项活动、聚会等而发的信函。","pronunciation":["초대짱"]},{"id":"5af01487318c0c57","term":"받다","zh":"收到 ，得到","audio":"/audio/5af01487318c0c571462.mp3","entryId":"66636","definition":"拿到他人给的或送来的东西。","pronunciation":["받따"]},{"id":"a8c93b78e5f25669","term":"호텔","zh":"酒店，饭店，宾馆","audio":"/audio/a8c93b78e5f25669c2a4.mp3","entryId":"30215","definition":"设施完备且规模较大的高级住宿业经营场所。","pronunciation":[]},{"id":"6d0e2a824abd9d8a","term":"뷔페","zh":"自助餐","audio":"/audio/6d0e2a824abd9d8a9048.mp3","entryId":"61014","definition":"摆放有多种饮食以供客人自己选择来享用的餐厅。","pronunciation":[]},{"id":"505de0a2f6be73fa","term":"하다","zh":