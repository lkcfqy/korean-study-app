unciation":["심장"]},{"id":"4d992de5a01a3d1b","term":"두근거리다","zh":"怦怦跳，忐忑不安","audio":"/audio/4d992de5a01a3d1ba196.mp3","entryId":"48261","definition":"因为惊恐、不安和期待等心脏总是快而强烈地跳动。","pronunciation":["두근거리다"]},{"id":"66bd3b1f27c0ee2e","term":"죽다","zh":"表示前面所指的状态或感觉等程度非常严重。","audio":"/audio/66bd3b1f27c0ee2e97b7.mp3","entryId":"77246","definition":"表示前面所指的状态或感觉等程度非常严重。","pronunciation":["죽따"]},{"id":"1443a6c090b12228","term":"것","zh":"表示某种行为、状态或事情。","audio":"/audio/1443a6c090b122289ad7.mp3","entryId":"62835","definition":"表示某种行为、状态或事情。","pronunciation":["걷"]},{"id":"962ae18a075d06e2","term":"같다","zh":"好像，可能","audio":"/audio/962ae18a075d06e2b7fd.mp3","entryId":"62076","definition":"推测出结果。","pronunciation":["갇따"]}],"audio":"/audio/1e7b4b3d63b4fe2a4dd9.mp3","speakerIndex":1}],"difficulty":3.142,"source":{"url":"https://krdict.korean.go.kr/chn/dicSearch/SearchView?ParaWordNo=48261","label":"国立国语院韩国语—汉语学习词典","license":"https://creativecommons.org/licenses/by-sa/2.0/kr/"},"sourceSenseId":"1","sourceLevel":"고급","day":174,"sequenceScore":3.6187,"questions":[{"lineIndex":0,"options":["嗯。我的心跳得厉害，感觉要死了。","听说要把这个地方改成绿地对吧？","大学录取结果要一个小时后才公布吗？"],"answer":2},{"lineIndex":1,"options":["嗯。我的心跳得厉害，感觉要死了。","大学录取结果要一个小时后才公布吗？","听说要把这个地方改成绿地对吧？"],"answer":0}]}
