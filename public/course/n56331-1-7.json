se dictionary"}],"surfaceReading":{"term":"여인은","audio":"/audio/1deefdb1515187e7bfd1.mp3"}},{"text":"누구냐?","meaning":"谁","explanation":"누구：谁；이다：表示“是”的判断形式；냐：非敬语疑问句末，用于亲近的人、晚辈或自问。","readings":[{"term":"누구","audio":"/audio/e9e6266b8035d7c474ee.mp3"}],"sources":[{"entryId":"62078","senseId":"1","lemma":"누구","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"누구냐","audio":"/audio/bb04ba8a1e5dbf73af5f.mp3"}}],"words":[{"id":"1c0ddfd005093840","term":"네","zh":"“너의(你的)”的缩略语。","audio":"/audio/1c0ddfd0050938404c35.mp3","entryId":"84427","definition":"“너의(你的)”的缩略语。","pronunciation":[]},{"id":"c140e1936b454b24","term":"옆","zh":"旁，旁边","audio":"/audio/c140e1936b454b24fb3a.mp3","entryId":"20243","definition":"指左右两侧中的一侧。","pronunciation":["엽"]},{"id":"96fe52db2531c9e7","term":"있다","zh":"有","audio":"/audio/96fe52db2531c9e73e53.mp3","entryId":"68797","definition":"人或动物、物体等存在的状态。","pronunciation":["읻따"]},{"id":"38c61820e786f234","term":"그","zh":"那个","audio":"/audio/38c61820e786f2346e96.mp3","entryId":"43883","definition":"指代与听话人较近或听话人所想的对象。","pronunciation":["그"]},{"id":"02fc885b61db44a8","term":"미모","zh":"美貌","audio":"/audio/02fc885b61db44a8b197.mp3","entryId":"56331","definition":"长得漂亮的容貌。","pronunciation":["미ː모"]},{"id":"49109dc3f86e1f6e","term":"여인","zh":"女人，女子","audio":"/audio/49109dc3f86e1f6e7c98.mp3","entryId":"15213","definition":"成年女性。","pronunciation":["여인"]},{"id":"e9e6266b8035d7c4","term":"누구","zh":"谁","audio":"/audio/e9e6266b8035d7c474ee.mp3","entryId":"62078","definition":"指不认识的人。","pronunciation":["누구"]}],"audio":"/audio/b2b1274d90fa00059b68.mp3","speakerIndex":0},{"id":"n56331-1-7-2","ko":"내 여동생이야.","zh":"是我妹妹。","note":"点不懂的词，看本句词义、助词和语尾；听词语后，再听整句。","parts":[{"text":"내","meaning":"我","explanation":"나：我；의：所属、关联或修饰，常对应“的”。","readings":[{"term":"나","audio":"/audio/1098bbe54520ab2a367c.mp3"}],"sources":[{"entryId":"60931","senseId":"1","lemma":"나","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"내","audio":"/audio/b3378685b76ee79fd0e