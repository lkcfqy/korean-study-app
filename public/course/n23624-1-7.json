se dictionary"}],"surfaceReading":{"term":"안","audio":"/audio/bc00bc8172c83d5fab70.mp3"}},{"text":"나?","meaning":"想起、记起（기억이 나다）","explanation":"나다：想起、记起（기억이 나다）；어：非敬语句末；与熟悉的人或晚辈交谈，语调决定陈述、询问等语气。","readings":[{"term":"나다","audio":"/audio/1a06e246c5fb49e2814c.mp3"}],"sources":[{"entryId":"62210","senseId":"21","lemma":"나다","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"나","audio":"/audio/1098bbe54520ab2a367c.mp3"}}],"words":[{"id":"2fd9e7d411752b46","term":"방금","zh":"刚才，方才","audio":"/audio/2fd9e7d411752b4601d9.mp3","entryId":"92065","definition":"比说话时刻稍微早一点的时间。","pronunciation":["방금"]},{"id":"734dae8e9d9a8f8b","term":"너","zh":"你","audio":"/audio/734dae8e9d9a8f8b763b.mp3","entryId":"64390","definition":"指代听者，用于朋友或晚辈。","pronunciation":["너"]},{"id":"f70cb61c1b19f138","term":"말하다","zh":"说，讲","audio":"/audio/f70cb61c1b19f1388e68.mp3","entryId":"62103","definition":"用话语表达某种事实、自己的想法或感觉等。","pronunciation":["말ː하다"]},{"id":"1443a6c090b12228","term":"것","zh":"表示某种行为、状态或事情。","audio":"/audio/1443a6c090b122289ad7.mp3","entryId":"62835","definition":"表示某种行为、状态或事情。","pronunciation":["걷"]},{"id":"603669bd762779d9","term":"기억","zh":"记着，记住","audio":"/audio/603669bd762779d98169.mp3","entryId":"38812","definition":"不忘记或重新想起以前的模样、事实、知识、经验等。","pronunciation":["기억"]},{"id":"bc00bc8172c83d5f","term":"안","zh":"不","audio":"/audio/bc00bc8172c83d5fab70.mp3","entryId":"71372","definition":"表示否定或反对。","pronunciation":["안"]},{"id":"1a06e246c5fb49e2","term":"나다","zh":"想起、记起（기억이 나다）","audio":"/audio/1a06e246c5fb49e2814c.mp3","entryId":"62210","definition":"想起、记起（기억이 나다）","pronunciation":["나다"]}],"audio":"/audio/8cd0d947ca101f903451.mp3","speakerIndex":0},{"id":"n23624-1-7-2","ko":"응, 나 건망증인가 봐.","zh":"嗯，我可能有点健忘。","note":"点不懂的词，看本句词义、助词和语尾；听词语后，再听整句。","parts":[{"text":"응,","meaning":"是，行","explanation":"응：是，行。","readings":[{"term":"응","audio":"/audio/107dd01c3d38a368ad44.mp3"}],"sources":[{"entryId":"30205","senseId":"2","lemma":"응","origin":"NIKL Korean-Chinese dictionary"}],"surf