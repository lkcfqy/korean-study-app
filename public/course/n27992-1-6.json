rfaceReading":{"term":"될","audio":"/audio/dc84eeabbbd47f74f20a.mp3"}},{"text":"것","meaning":"表示对未发生事情的预测、推测或计划。","explanation":"것：表示对未发生事情的预测、推测或计划。","readings":[{"term":"것","audio":"/audio/1443a6c090b122289ad7.mp3"}],"sources":[{"entryId":"62835","senseId":"6","lemma":"것","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"것","audio":"/audio/1443a6c090b122289ad7.mp3"}},{"text":"같아요.","meaning":"好像，可能","explanation":"같다：好像，可能；어요：礼貌句末；可随语调表示陈述或询问。","readings":[{"term":"같다","audio":"/audio/962ae18a075d06e2b7fd.mp3"}],"sources":[{"entryId":"62076","senseId":"8","lemma":"같다","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"같아요","audio":"/audio/d27f58354e12c6dc5616.mp3"}}],"words":[{"id":"a42eace37d0e6c18","term":"이러다","zh":"这么着","audio":"/audio/a42eace37d0e6c1863cb.mp3","entryId":"24838","definition":"这样做。","pronunciation":["이러다"]},{"id":"3d813865c018ad5e","term":"강물","zh":"江水，河水","audio":"/audio/3d813865c018ad5e2e1e.mp3","entryId":"62662","definition":"在江河里流淌的水。","pronunciation":["강물"]},{"id":"3e97e87ccea2bd9b","term":"고갈","zh":"干涸，枯竭","audio":"/audio/3e97e87ccea2bd9b8450.mp3","entryId":"27992","definition":"水枯干而消失。","pronunciation":["고갈"]},{"id":"91b4dc2748cba787","term":"되다","zh":"到","audio":"/audio/91b4dc2748cba787dd6f.mp3","entryId":"89858","definition":"到达某个时间、时期或状态。","pronunciation":["되다","뒈다"]},{"id":"1443a6c090b12228","term":"것","zh":"表示对未发生事情的预测、推测或计划。","audio":"/audio/1443a6c090b122289ad7.mp3","entryId":"62835","definition":"表示对未发生事情的预测、推测或计划。","pronunciation":["걷"]},{"id":"962ae18a075d06e2","term":"같다","zh":"好像，可能","audio":"/audio/962ae18a075d06e2b7fd.mp3","entryId":"62076","definition":"推测出结果。","pronunciation":["갇따"]}],"audio":"/audio/4923418bec5334e17b56.mp3","speakerIndex":1}],"difficulty":2.989,"source":{"url":"https://krdict.korean.go.kr/chn/dicSearch/SearchView?ParaWordNo=27992","label":"国立国语院韩国语—汉语学习词典","license":"https://creativecommons.org/licenses/by-sa/2.0/kr/"},"sourceSenseId":"1","sourceLevel":"고급","day":14