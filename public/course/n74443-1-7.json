f1.mp3"}},{"text":"안","meaning":"不","explanation":"안：不","readings":[{"term":"안","audio":"/audio/bc00bc8172c83d5fab70.mp3"}],"sources":[{"entryId":"71372","senseId":"1","lemma":"안","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"안","audio":"/audio/bc00bc8172c83d5fab70.mp3"}},{"text":"하세요?","meaning":"做，干","explanation":"하다：做，干；세요：包含尊敬形式的礼貌句末，可表示请求、劝告或询问等。","readings":[{"term":"하다","audio":"/audio/505de0a2f6be73fa7758.mp3"}],"sources":[{"entryId":"73277","senseId":"1","lemma":"하다","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"하세요","audio":"/audio/20c70a963b62c0806108.mp3"}}],"words":[{"id":"07dda968bf6b7241","term":"작가","zh":"作家","audio":"/audio/07dda968bf6b7241b33c.mp3","entryId":"58277","definition":"原创出诗歌、小说、剧本、画等的人。","pronunciation":["작까"]},{"id":"16ebe2403bccd648","term":"이제","zh":"今后","audio":"/audio/16ebe2403bccd648e89e.mp3","entryId":"61172","definition":"从今以后。","pronunciation":["이제"]},{"id":"eec1d8d2d561e94f","term":"작품","zh":"作品","audio":"/audio/eec1d8d2d561e94f9208.mp3","entryId":"24837","definition":"画、雕刻、小说、诗等通过艺术创作活动制成的东西。","pronunciation":["작품"]},{"id":"d4b47a5cf76094e9","term":"활동","zh":"活动","audio":"/audio/d4b47a5cf76094e95719.mp3","entryId":"74135","definition":"为在某事中取得好结果而努力。","pronunciation":["활똥"]},{"id":"1e2cb79b6970d021","term":"더","zh":"更，更加","audio":"/audio/1e2cb79b6970d0213fd9.mp3","entryId":"26829","definition":"与比较对象或某个标准相比，程度加深；在那之上。","pronunciation":["더"]},{"id":"e6e77b83100b28e7","term":"이상","zh":"既然","audio":"/audio/e6e77b83100b28e797f1.mp3","entryId":"66580","definition":"已经这样的话。","pronunciation":["이ː상"]},{"id":"bc00bc8172c83d5f","term":"안","zh":"不","audio":"/audio/bc00bc8172c83d5fab70.mp3","entryId":"71372","definition":"表示否定或反对。","pronunciation":["안"]},{"id":"505de0a2f6be73fa","term":"하다","zh":"做，干","audio":"/audio/505de0a2f6be73fa7758.mp3","entryId":"73277","definition":"进行某种行动、动作或活动。","pronunciation":["하다"]}],"audio":"/audio/610f251f299849416a0f.mp3","speakerIndex":0},{"id":"n74443-1-7-