0fdac.mp3"}],"sources":[{"entryId":"67048","senseId":"4","lemma":"어울리다","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"어울려","audio":"/audio/12c688c61bc1ff3e7d19.mp3"}}],"words":[{"id":"734dae8e9d9a8f8b","term":"너","zh":"你","audio":"/audio/734dae8e9d9a8f8b763b.mp3","entryId":"64390","definition":"指代听者，用于朋友或晚辈。","pronunciation":["너"]},{"id":"14112325e485b805","term":"환하다","zh":"鲜艳，鲜明","audio":"/audio/14112325e485b805f0e1.mp3","entryId":"87071","definition":"颜色明亮，干净。","pronunciation":["환ː하다"]},{"id":"4e0f2a64814ac0cd","term":"색","zh":"色，色彩","audio":"/audio/4e0f2a64814ac0cdc90a.mp3","entryId":"20231","definition":"物体吸收光后表现出的明暗或红、黄、蓝等颜色。","pronunciation":["색"]},{"id":"4bddf9b9203384c7","term":"옷","zh":"衣服，衣裳，服装","audio":"/audio/4bddf9b9203384c7b240.mp3","entryId":"30159","definition":"为遮掩身体、防晒抗寒以及追求美观而穿的遮挡物。","pronunciation":["옫"]},{"id":"8aff11a4aebdccdb","term":"잘","zh":"好看地，漂亮地","audio":"/audio/8aff11a4aebdccdbf05d.mp3","entryId":"58939","definition":"非常帅气而美丽地。","pronunciation":["잘"]},{"id":"e3eff4fbd4afe320","term":"어울리다","zh":"谐调，相配，般配","audio":"/audio/e3eff4fbd4afe320fdac.mp3","entryId":"67048","definition":"相互自然地达到和谐。","pronunciation":["어울리다"]}],"audio":"/audio/1cab8c4ca447fa67ec85.mp3","speakerIndex":1}],"difficulty":1.858,"source":{"url":"https://krdict.korean.go.kr/chn/dicSearch/SearchView?ParaWordNo=87071","label":"国立国语院韩国语—汉语学习词典","license":"https://creativecommons.org/licenses/by-sa/2.0/kr/"},"sourceSenseId":"6","sourceLevel":"중급","day":63,"sequenceScore":1.4556,"questions":[{"lineIndex":0,"options":["买哪种颜色的衬衫呢？","你穿亮色的衣服很合适。","还没找到钥匙吗？"],"answer":0},{"lineIndex":1,"options":["买哪种颜色的衬衫呢？","你穿亮色的衣服很合适。","还没找到钥匙吗？"],"answer":1}]}
