b7fd.mp3"}],"sources":[{"entryId":"62076","senseId":"8","lemma":"같다","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"같아요","audio":"/audio/d27f58354e12c6dc5616.mp3"}}],"words":[{"id":"b508d0255be0121e","term":"회식","zh":"聚餐，会餐，饭局","audio":"/audio/b508d0255be0121e8575.mp3","entryId":"88144","definition":"同属于某组织或团体的人聚在一起吃饭；或指这种聚会。","pronunciation":["회ː식","훼ː식"]},{"id":"96fe52db2531c9e7","term":"있다","zh":"有","audio":"/audio/96fe52db2531c9e73e53.mp3","entryId":"68797","definition":"事实或现象存在。","pronunciation":["읻따"]},{"id":"70ae9bc35b2d378b","term":"좀","zh":"一会儿","audio":"/audio/70ae9bc35b2d378b00ef.mp3","entryId":"75798","definition":"时间短暂地。","pronunciation":["좀"]},{"id":"8678e3dcf30b4fad","term":"늦다","zh":"晚，迟到","audio":"/audio/8678e3dcf30b4fad0aa5.mp3","entryId":"61181","definition":"过了已定的时间。","pronunciation":["늗따"]},{"id":"ffcedfda7558e5dc","term":"거","zh":"表示说话人的推测或信念等。","audio":"/audio/ffcedfda7558e5dc31fe.mp3","entryId":"62331","definition":"表示说话人的推测或信念等。","pronunciation":["거"]},{"id":"962ae18a075d06e2","term":"같다","zh":"好像，可能","audio":"/audio/962ae18a075d06e2b7fd.mp3","entryId":"62076","definition":"推测出结果。","pronunciation":["갇따"]}],"audio":"/audio/2f96670ad46c453e0aff.mp3","speakerIndex":1}],"difficulty":2.26,"source":{"url":"https://krdict.korean.go.kr/chn/dicSearch/SearchView?ParaWordNo=88144","label":"国立国语院韩国语—汉语学习词典","license":"https://creativecommons.org/licenses/by-sa/2.0/kr/"},"sourceSenseId":"1","sourceLevel":"중급","day":71,"sequenceScore":1.9134,"questions":[{"lineIndex":0,"options":["因为有聚餐，我可能会晚一点回来。","亲爱的！你今天什么时候回来？","承奎先生看起来应该有三十岁吧。"],"answer":1},{"lineIndex":1,"options":["亲爱的！你今天什么时候回来？","承奎先生看起来应该有三十岁吧。","因为有聚餐，我可能会晚一点回来。"],"answer":2}]}
