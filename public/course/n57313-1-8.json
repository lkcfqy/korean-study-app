ion":["늗따"]},{"id":"d57c47b0949440ff","term":"일어나다","zh":"起，起床，起来","audio":"/audio/d57c47b0949440ff623b.mp3","entryId":"71696","definition":"从睡眠中醒来。","pronunciation":["이러나다"]}],"audio":"/audio/4ecf937ffeca6901562d.mp3","speakerIndex":0},{"id":"n57313-1-8-2","ko":"잠깐 눈 좀 붙인다는 게 계속 자 버렸네요.","zh":"本来只是想小睡一会儿，结果却睡过头了。","note":"点不懂的词，看本句词义、助词和语尾；听词语后，再听整句。","parts":[{"text":"잠깐","meaning":"一下，暂时地","explanation":"잠깐：一下，暂时地","readings":[{"term":"잠깐","audio":"/audio/4e073566099677ea5e65.mp3"}],"sources":[{"entryId":"57313","senseId":"1","lemma":"잠깐","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"잠깐","audio":"/audio/4e073566099677ea5e65.mp3"}},{"text":"눈","meaning":"眼睛","explanation":"눈：眼睛","readings":[{"term":"눈","audio":"/audio/ab1b14816087979d2143.mp3"}],"sources":[{"entryId":"72704","senseId":"1","lemma":"눈","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"눈","audio":"/audio/ab1b14816087979d2143.mp3"}},{"text":"좀","meaning":"一下","explanation":"좀：一下","readings":[{"term":"좀","audio":"/audio/70ae9bc35b2d378b00ef.mp3"}],"sources":[{"entryId":"75798","senseId":"3","lemma":"좀","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"좀","audio":"/audio/70ae9bc35b2d378b00ef.mp3"}},{"text":"붙인다는","meaning":"产生","explanation":"붙이다：产生；ㄴ다는：引用陈述内容并修饰后面的名词。","readings":[{"term":"붙이다","audio":"/audio/f50e3cbdb3c8dd13b787.mp3"}],"sources":[{"entryId":"60293","senseId":"11","lemma":"붙이다","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"붙인다는","audio":"/audio/7444170336cb0ad8d2b3.mp3"}},{"text":"게","meaning":"表示对未发生事情的预测、推测或计划。","explanation":"것：表示对未发生事情的预测、推测或计划。；이：主格助词，标记主语。","readings":[{"term":"것","audio":"/audio/1443a6c090b122289ad7.mp3"}],"sources":[{"entryId":"62835","senseId":"6","lemma":"것","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"게","audio":"/audio/c7150cec89b60925ae40.mp3"}},{"text":"계속","meaning":"继续，持续","explanation":"계속：继续，持续","readings":[{"term":"계속","audio":"/audio/23a