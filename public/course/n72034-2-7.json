L Korean-Chinese dictionary"}]},{"text":"다른","meaning":"其他，别的","explanation":"다른：其他，别的","readings":[{"term":"다른","audio":"/audio/f1f4ce417552e1974311.mp3"}],"sources":[{"entryId":"64530","senseId":"1","lemma":"다른","origin":"NIKL Korean-Chinese dictionary"}]},{"text":"거","meaning":"那个","explanation":"거：那个","readings":[{"term":"거","audio":"/audio/ffcedfda7558e5dc31fe.mp3"}],"sources":[{"entryId":"66342","senseId":"1","lemma":"거","origin":"NIKL Korean-Chinese dictionary"}]},{"text":"보자.","meaning":"看，观看，观赏","explanation":"보다：看，观看，观赏；자：非敬语提议句末：“一起……吧”。","readings":[{"term":"보다","audio":"/audio/6a45cf834264a5ec3611.mp3"}],"sources":[{"entryId":"61190","senseId":"2","lemma":"보다","origin":"NIKL Korean-Chinese dictionary"}]}],"words":[{"id":"8bafb6b7d17ead49","term":"이","zh":"这个","audio":"/audio/8bafb6b7d17ead4985bf.mp3","entryId":"27527","definition":"指代离说话人较近的，或说话人所想的对象。","pronunciation":["이"]},{"id":"de7da9c17b53bd9d","term":"프로","zh":"节目，节目单","audio":"/audio/de7da9c17b53bd9d0788.mp3","entryId":"72395","definition":"在广播或电视等里，按时间段播放的内容；或指其顺序或目录。","pronunciation":[]},{"id":"b086b052fd147207","term":"재미없다","zh":"无趣，没意思，没劲儿","audio":"/audio/b086b052fd147207e465.mp3","entryId":"57315","definition":"没有欢欣愉悦的感觉。","pronunciation":["재미업따"]},{"id":"f1f4ce417552e197","term":"다른","zh":"其他，别的","audio":"/audio/f1f4ce417552e1974311.mp3","entryId":"64530","definition":"除相关之外的。","pronunciation":["다른"]},{"id":"ffcedfda7558e5dc","term":"거","zh":"那个","audio":"/audio/ffcedfda7558e5dc31fe.mp3","entryId":"66342","definition":"指代与听话人较近的或听话人所想的对象。","pronunciation":["거"]},{"id":"6a45cf834264a5ec","term":"보다","zh":"看，观看，观赏","audio":"/audio/6a45cf834264a5ec3611.mp3","entryId":"61190","definition":"用眼睛享受或欣赏某个对象。","pronunciation":["보다"]}],"audio":"/audio/9b8c2fbea36c1668facf.mp3","speakerIndex":1}],"difficulty":2.635,"source":{"url":"https://krdict.korean.go.kr/chn/dicSearch/SearchView?ParaWordNo=72034","label":"国立国语院韩国语—汉语学习词典","license":"https://creativecommons.org/licenses/by-sa/2.0/kr/"},"sourceSe