ings":[{"term":"아프다","audio":"/audio/912c6f176a189a346579.mp3"}],"sources":[{"entryId":"62239","senseId":"1","lemma":"아프다","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"아프니","audio":"/audio/29e7649e047935bbb17d.mp3"}},{"text":"앉아","meaning":"坐","explanation":"앉다：坐；어：连接后续动作或辅助表达；常与前面的词干缩合。","readings":[{"term":"앉다","audio":"/audio/17e77d3fb6b2dbdb6258.mp3"}],"sources":[{"entryId":"71463","senseId":"1","lemma":"앉다","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"앉아","audio":"/audio/709a1afa79c56d9a698a.mp3"}},{"text":"있으렴.","meaning":"某种结果状态持续着（-아/어 있다）","explanation":"있다：某种结果状态持续着（-아/어 있다）；으렴：向亲近的人或晚辈发出指示、劝告或请求。","readings":[{"term":"있다","audio":"/audio/96fe52db2531c9e73e53.mp3"}],"sources":[{"entryId":"62595","senseId":"3","lemma":"있다","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"있으렴","audio":"/audio/269800568713c6923a48.mp3"}}],"words":[{"id":"86ee58f45cccde99","term":"물론","zh":"当然，不用说","audio":"/audio/86ee58f45cccde9947f0.mp3","entryId":"89812","definition":"没有必要说的。","pronunciation":["물론"]},{"id":"734dae8e9d9a8f8b","term":"너","zh":"你","audio":"/audio/734dae8e9d9a8f8b763b.mp3","entryId":"64390","definition":"指代听者，用于朋友或晚辈。","pronunciation":["너"]},{"id":"982037b144c2b329","term":"다리","zh":"腿，下肢","audio":"/audio/982037b144c2b329e189.mp3","entryId":"62840","definition":"人或动物身体下的，做站、走、跳的动作的身体部位。","pronunciation":["다리"]},{"id":"912c6f176a189a34","term":"아프다","zh":"疼， 痛，不舒服","audio":"/audio/912c6f176a189a346579.mp3","entryId":"62239","definition":"因受伤或生病，而感到痛症或痛苦。","pronunciation":["아프다"]},{"id":"17e77d3fb6b2dbdb","term":"앉다","zh":"坐","audio":"/audio/17e77d3fb6b2dbdb6258.mp3","entryId":"71463","definition":"挺直上半身，将臀部置于别的物体或地上以支持身体的重量。","pronunciation":["안따"]},{"id":"96fe52db2531c9e7","term":"있다","zh":"某种结果状态持续着（-아/어 있다）","audio":"/audio/96fe52db2531c9e73e53.mp3","entryId":"62595","definition":"某种结果状态持续着（-아/어 있다）","pronunciation":["읻따"]}],"audio":"/audio/c8239e65c60a83a6f2e9.mp3","speakerIndex":1}],"dif