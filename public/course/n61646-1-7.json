ces":[{"entryId":"14687","senseId":"2","lemma":"아쉽다","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"아쉽겠어요","audio":"/audio/dcf7c85023bf44afdbbf.mp3"}}],"words":[{"id":"11cf51a3ca8b5108","term":"딸","zh":"女儿","audio":"/audio/11cf51a3ca8b5108ea09.mp3","entryId":"30210","definition":"由父母所生的子女中的女性；女性孩子。","pronunciation":["딸"]},{"id":"28ed1f7d8986d21d","term":"셋","zh":"三","audio":"/audio/28ed1f7d8986d21d30a5.mp3","entryId":"29602","definition":"二加一后所得的数目。","pronunciation":["섿ː"]},{"id":"65e567305972e652","term":"아들","zh":"儿子","audio":"/audio/65e567305972e652430e.mp3","entryId":"20240","definition":"男性子女。","pronunciation":["아들"]},{"id":"815560dcd5b82893","term":"없다","zh":"没有","audio":"/audio/815560dcd5b828930ac0.mp3","entryId":"89917","definition":"具有一定血缘关系的人不存在。","pronunciation":["업ː따"]},{"id":"1443a6c090b12228","term":"것","zh":"表示某种行为、状态或事情。","audio":"/audio/1443a6c090b122289ad7.mp3","entryId":"62835","definition":"表示某种行为、状态或事情。","pronunciation":["걷"]},{"id":"b90537aecebf988b","term":"아쉽다","zh":"可惜，舍不得，依依不舍","audio":"/audio/b90537aecebf988b4b9b.mp3","entryId":"14687","definition":"存有一些留恋而感到惋惜、遗憾。","pronunciation":["아쉽따"]}],"audio":"/audio/2610851578775b96af5e.mp3","speakerIndex":0},{"id":"n61646-1-7-2","ko":"사위들이 아들 노릇을 하니 괜찮답니다.","zh":"有女婿们顶替儿子的角色，所以也没关系呢。","note":"点不懂的词，看本句词义、助词和语尾；听词语后，再听整句。","parts":[{"text":"사위들이","meaning":"女婿","explanation":"사위：女婿；들：复数后缀，表示多个对象。；이：主格助词，标记主语。","readings":[{"term":"사위","audio":"/audio/2a37c291aebc6a8002f7.mp3"}],"sources":[{"entryId":"61646","senseId":"1","lemma":"사위","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"사위들이","audio":"/audio/1884a568e8a4357f3866.mp3"}},{"text":"아들","meaning":"儿子","explanation":"아들：儿子","readings":[{"term":"아들","audio":"/audio/65e567305972e652430e.mp3"}],"sources":[{"entryId":"20240","senseId":"1","lemma":"아들","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"아들","audio":"/audio/65e567305972e652430e.mp3"}},{"text":"노릇을","meaning":"角色，作为","exp