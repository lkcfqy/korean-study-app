nary"}],"surfaceReading":{"term":"배치됐었어","audio":"/audio/5efaf98f0c207a0cb350.mp3"}}],"words":[{"id":"107dd01c3d38a368","term":"응","zh":"是，行","audio":"/audio/107dd01c3d38a368ad44.mp3","entryId":"30205","definition":"用于肯定回答对方所提出的问题或命令等。","pronunciation":["응"]},{"id":"df3e04c4ad6f7065","term":"외세","zh":"外国势力，外部势力","audio":"/audio/df3e04c4ad6f7065de2d.mp3","entryId":"69113","definition":"其他国家的势力。","pronunciation":["외ː세","웨ː세"]},{"id":"a9da2cf43efac4bc","term":"침략","zh":"侵略，侵吞","audio":"/audio/a9da2cf43efac4bcae15.mp3","entryId":"80757","definition":"无正当理由就闯入其他国家。","pronunciation":["침ː냑"]},{"id":"c2579a1384721952","term":"대비하다","zh":"预备，应对，防备","audio":"/audio/c2579a13847219524316.mp3","entryId":"14339","definition":"提前为以后有可能发生的困难情况做准备。","pronunciation":["대ː비하다"]},{"id":"336963582ab921f0","term":"옛날","zh":"过去，昔日","audio":"/audio/336963582ab921f0c295.mp3","entryId":"57273","definition":"以前的某一时段。","pronunciation":["옌ː날"]},{"id":"4278861b2d06d0a8","term":"해안","zh":"海岸，海边","audio":"/audio/4278861b2d06d0a87aba.mp3","entryId":"85797","definition":"大海和陆地相接的地方。","pronunciation":["해ː안"]},{"id":"770eb9e292c17199","term":"지역","zh":"地域，地区，区域","audio":"/audio/770eb9e292c171999d24.mp3","entryId":"71487","definition":"根据某个特征或一定的标准划分其范围的地方。","pronunciation":["지역"]},{"id":"8dc5d9b0bbbc3611","term":"병사","zh":"士兵","audio":"/audio/8dc5d9b0bbbc36117479.mp3","entryId":"91305","definition":"(旧词)军人或军队。","pronunciation":["병사"]},{"id":"1af2aeb1be04021c","term":"많이","zh":"多","audio":"/audio/1af2aeb1be04021c7be5.mp3","entryId":"66030","definition":"数、量、程度等超过一定标准地。","pronunciation":["마ː니"]},{"id":"024d73f701c66998","term":"배치되다","zh":"被分配，被安排","audio":"/audio/024d73f701c66998efb9.mp3","entryId":"58591","definition":"人或物品等被分到合适的位置。","pronunciation":["배ː치되다","배ː치뒈다"]}],"audio":"/audio/6b109ba0dbdd475a8ba1.mp3","speakerIndex":1}],"difficulty":6.306,"source":{"url":"https://krdict.korean.go.kr/chn/dicSearch/SearchView?ParaWordNo=80757","label":"国立国语院韩国语—汉语学习词典","license":"https://creativecommons.org/lic