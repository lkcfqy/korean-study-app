nese dictionary"}],"surfaceReading":{"term":"경계","audio":"/audio/c290e6b068266a97fa0f.mp3"}},{"text":"상태가","meaning":"状态","explanation":"상태：状态；가：主格助词，标记主语。","readings":[{"term":"상태","audio":"/audio/e10195a1239fb321327b.mp3"}],"sources":[{"entryId":"16489","senseId":"1","lemma":"상태","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"상태가","audio":"/audio/a29279081b3f92fb60f5.mp3"}},{"text":"해제됐대.","meaning":"解除，解禁","explanation":"해제되다：解除，解禁；었：过去或完成，常与词干缩合；대：口语中转述听来的话，非敬语。","readings":[{"term":"해제되다","audio":"/audio/01f9b0c8cc8fb4a26d3b.mp3"}],"sources":[{"entryId":"84796","senseId":"2","lemma":"해제되다","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"해제됐대","audio":"/audio/eafc53662f78e58c56f9.mp3"}}],"words":[{"id":"107dd01c3d38a368","term":"응","zh":"是，行","audio":"/audio/107dd01c3d38a368ad44.mp3","entryId":"30205","definition":"用于肯定回答对方所提出的问题或命令等。","pronunciation":["응"]},{"id":"30c94182141ace2f","term":"그런데","zh":"可是，可","audio":"/audio/30c94182141ace2fd889.mp3","entryId":"70717","definition":"用于将话题与前面内容相连接的同时，又将话头转向其他方向。","pronunciation":["그런데"]},{"id":"3bc6235e1d18162f","term":"오늘","zh":"今天，今日","audio":"/audio/3bc6235e1d18162fb94c.mp3","entryId":"68206","definition":"现在正在度过的这一天。","pronunciation":["오늘"]},{"id":"d0a36389c6b198a1","term":"새벽","zh":"凌晨，早晨","audio":"/audio/d0a36389c6b198a158ee.mp3","entryId":"62740","definition":"很早的上午时间。","pronunciation":["새벽"]},{"id":"1c0ddfd005093840","term":"네","zh":"四","audio":"/audio/1c0ddfd0050938404c35.mp3","entryId":"64556","definition":"四的。","pronunciation":["네ː"]},{"id":"bfa42cf6a12e9123","term":"시","zh":"点，点钟","audio":"/audio/bfa42cf6a12e91233038.mp3","entryId":"65108","definition":"计时单位，表示一天二十四小时中的某一个。","pronunciation":["시"]},{"id":"d646ca3dbbb92e3c","term":"기하다","zh":"从……起","audio":"/audio/d646ca3dbbb92e3c8209.mp3","entryId":"38486","definition":"规定时期，并当作某事或某行动的契机。","pronunciation":["기하다"]},{"id":"29147ecc4b352fee","term":"비상","zh":"紧急，非常","audio":"/audio/29147ecc4b352feed878.mp3","entry