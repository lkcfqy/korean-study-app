onunciation":["만들다"]},{"id":"f1cd655a5837981f","term":"모양","zh":"样子，形状","audio":"/audio/f1cd655a5837981f96d3.mp3","entryId":"62397","definition":"与某物相同或相似的模样。","pronunciation":["모양"]},{"id":"962ae18a075d06e2","term":"같다","zh":"相同，一样，一致","audio":"/audio/962ae18a075d06e2b7fd.mp3","entryId":"62076","definition":"彼此并无差异。","pronunciation":["갇따"]}],"audio":"/audio/97f54331cf080482c194.mp3","speakerIndex":1}],"difficulty":2.909,"source":{"url":"https://krdict.korean.go.kr/chn/dicSearch/SearchView?ParaWordNo=56053","label":"国立国语院韩国语—汉语学习词典","license":"https://creativecommons.org/licenses/by-sa/2.0/kr/"},"sourceSenseId":"2","sourceLevel":"고급","day":132,"sequenceScore":2.5066,"questions":[{"lineIndex":0,"options":["用同一个模具做的，形状当然一样。","这些鲫鱼饼都一个样呢。","这位就是我的妻子。"],"answer":1},{"lineIndex":1,"options":["这些鲫鱼饼都一个样呢。","这位就是我的妻子。","用同一个模具做的，形状当然一样。"],"answer":2}]}
