":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"싸우셨어","audio":"/audio/a8dbc32e26f2e7a310a3.mp3"}}],"words":[{"id":"af4870c15b98485b","term":"아버지","zh":"父亲，爸爸","audio":"/audio/af4870c15b98485bf462.mp3","entryId":"71343","definition":"用于指称或称呼生育自己的男子。","pronunciation":["아버지"]},{"id":"a8f7e3b1e379f488","term":"어머니","zh":"母亲，妈妈","audio":"/audio/a8f7e3b1e379f4880b79.mp3","entryId":"74361","definition":"用于指称或称呼生育自己的女子。","pronunciation":["어머니"]},{"id":"c7c5916d2df73410","term":"또","zh":"又","audio":"/audio/c7c5916d2df73410dd21.mp3","entryId":"51887","definition":"某件事情或行为再次发生。","pronunciation":["또"]},{"id":"e27f0e273d4af17d","term":"싸우다","zh":"争吵；本句指父母吵架","audio":"/audio/e27f0e273d4af17d7ed1.mp3","entryId":"29732","definition":"争吵；本句指父母吵架","pronunciation":["싸우다"]}],"audio":"/audio/d5463b7ac984dedfa46e.mp3","speakerIndex":1}],"difficulty":1.816,"source":{"url":"https://krdict.korean.go.kr/chn/dicSearch/SearchView?ParaWordNo=93441","label":"国立国语院韩国语—汉语学习词典","license":"https://creativecommons.org/licenses/by-sa/2.0/kr/"},"sourceSenseId":"1","sourceLevel":"고급","day":121,"sequenceScore":1.6427,"questions":[{"lineIndex":0,"options":["爸爸和妈妈又吵架了。","发生什么事了？气氛怎么像丧家一样啊？","爷爷，您今年多大年纪了？"],"answer":1},{"lineIndex":1,"options":["发生什么事了？气氛怎么像丧家一样啊？","爷爷，您今年多大年纪了？","爸爸和妈妈又吵架了。"],"answer":2}]}
