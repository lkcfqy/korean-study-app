83d5fab70.mp3"}],"sources":[{"entryId":"71372","senseId":"1","lemma":"안","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"안","audio":"/audio/bc00bc8172c83d5fab70.mp3"}},{"text":"할","meaning":"做，干","explanation":"하다：做，干；ㄹ：修饰后面的名词，表示预定、意向、推测或可能；具体含义取决于后接表达。","readings":[{"term":"하다","audio":"/audio/505de0a2f6be73fa7758.mp3"}],"sources":[{"entryId":"73277","senseId":"1","lemma":"하다","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"할","audio":"/audio/3b4c012b3f82dedb34a0.mp3"}},{"text":"수가","meaning":"可以，可能","explanation":"수：可以，可能；가：主格助词，标记主语。","readings":[{"term":"수","audio":"/audio/dcd19f5b5caac9771378.mp3"}],"sources":[{"entryId":"15615","senseId":"1","lemma":"수","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"수가","audio":"/audio/6780a417c9a853af476b.mp3"}},{"text":"없어.","meaning":"不能（-ㄹ/을 수 없다）","explanation":"없다：不能（-ㄹ/을 수 없다）；어：非敬语句末；与熟悉的人或晚辈交谈，语调决定陈述、询问等语气。","readings":[{"term":"없다","audio":"/audio/815560dcd5b828930ac0.mp3"}],"sources":[{"entryId":"89917","senseId":"11","lemma":"없다","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"없어","audio":"/audio/d3275bf98baed4550c12.mp3"}}],"words":[{"id":"66da57bd505cc1e1","term":"그렇지","zh":"是呀，就是","audio":"/audio/66da57bd505cc1e1c679.mp3","entryId":"26031","definition":"某个事实与自己所想的一致时，以感叹的语气所说的话。","pronunciation":["그러치"]},{"id":"6a45cf834264a5ec","term":"보다","zh":"看","audio":"/audio/6a45cf834264a5ec3611.mp3","entryId":"61190","definition":"用眼睛识辨对象的存在或外观。","pronunciation":["보다"]},{"id":"96fe52db2531c9e7","term":"있다","zh":"正在做、持续进行（-고 있다）","audio":"/audio/96fe52db2531c9e73e53.mp3","entryId":"62595","definition":"正在做、持续进行（-고 있다）","pronunciation":["읻따"]},{"id":"f62ff8982d788e72","term":"예쁘다","zh":"漂亮，好看","audio":"/audio/f62ff8982d788e72028f.mp3","entryId":"89697","definition":"长相看起来美丽，让人喜欢。","pronunciation":["예ː쁘다"]},{"id":"fb908c093a783716","term":"뽀뽀","zh":"亲亲","audio":"/audio/fb908c093a783716fdd8.mp3","entryId":"61162","definition":"在身体的一部分贴上