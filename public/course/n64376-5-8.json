KL Korean-Chinese dictionary"}],"surfaceReading":{"term":"수","audio":"/audio/dcd19f5b5caac9771378.mp3"}},{"text":"있어서","meaning":"能、可以（-ㄹ/을 수 있다）","explanation":"있다：能、可以（-ㄹ/을 수 있다）；어서：连接原因与结果，或前后相接的动作。","readings":[{"term":"있다","audio":"/audio/96fe52db2531c9e73e53.mp3"}],"sources":[{"entryId":"68797","senseId":"5","lemma":"있다","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"있어서","audio":"/audio/8c518243ad11245b602e.mp3"}},{"text":"좋아요.","meaning":"喜爱，喜欢","explanation":"좋다：喜爱，喜欢；어요：礼貌句末；可随语调表示陈述或询问。","readings":[{"term":"좋다","audio":"/audio/86d0464f1c6da40233cd.mp3"}],"sources":[{"entryId":"79033","senseId":"10","lemma":"좋다","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"좋아요","audio":"/audio/4e89f12afd275d8a286b.mp3"}}],"words":[{"id":"1c0ddfd005093840","term":"네","zh":"是，行","audio":"/audio/1c0ddfd0050938404c35.mp3","entryId":"17294","definition":"用于肯定回答长辈所提出的问题或命令等。","pronunciation":["네"]},{"id":"9c844c75334ef579","term":"박물관","zh":"博物馆","audio":"/audio/9c844c75334ef5795590.mp3","entryId":"36677","definition":"搜集、保存和陈列文物或艺术品以供人们欣赏或研究的设施。","pronunciation":["방물관"]},{"id":"233cb510410b09d6","term":"가다","zh":"去","audio":"/audio/233cb510410b09d69cdc.mp3","entryId":"27500","definition":"从一个地方移动到另一个地方。","pronunciation":["가다"]},{"id":"4f5275b217d6318a","term":"역사","zh":"历史","audio":"/audio/4f5275b217d6318a8404.mp3","entryId":"62515","definition":"人类社会随着时间流逝兴衰存亡的变化过程；或指那个记录。","pronunciation":["역싸"]},{"id":"580bb8d061b97e66","term":"문화","zh":"文化","audio":"/audio/580bb8d061b97e66f221.mp3","entryId":"71460","definition":"社会共同体为了一定的目的或实现生活理想而制作、熟悉、共享并传达的物质性、精神性活动。","pronunciation":["문화"]},{"id":"11a4151b77b606b8","term":"느끼다","zh":"感受，体会","audio":"/audio/11a4151b77b606b85dcc.mp3","entryId":"64376","definition":"亲自体验某事物，并对此有所了解。","pronunciation":["느끼다"]},{"id":"dcd19f5b5caac977","term":"수","zh":"可以，可能","audio":"/audio/dcd19f5b5caac9771378.mp3","entryId":"15615","definition":"做某事的能力，或某事发生的可能性。","pronunciation":["수"]},{"id":"96fe52db2531