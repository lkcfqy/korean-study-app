ary"}],"surfaceReading":{"term":"감했지","audio":"/audio/760fb41351e93ce658cd.mp3"}}],"words":[{"id":"8a2a6ac758011971","term":"스웨터","zh":"毛衣","audio":"/audio/8a2a6ac758011971cccf.mp3","entryId":"65063","definition":"用毛线织成的厚厚的上衣。","pronunciation":[]},{"id":"e5e4a50ddf59a4bd","term":"소매","zh":"袖子","audio":"/audio/e5e4a50ddf59a4bddc00.mp3","entryId":"49236","definition":"上衣中覆盖两臂的部分。","pronunciation":["소매"]},{"id":"75aba55303fbffdf","term":"길이","zh":"长短，长度","audio":"/audio/75aba55303fbffdfc7bf.mp3","entryId":"62471","definition":"从某物的一端到另一端的距离。","pronunciation":["기리"]},{"id":"08b35eb63efd4aaa","term":"왜","zh":"为什么","audio":"/audio/08b35eb63efd4aaae44c.mp3","entryId":"67848","definition":"因什么原因；或指怎么。","pronunciation":["왜ː"]},{"id":"de3915c860a22269","term":"갑자기","zh":"突然，忽然，猛地，一下子","audio":"/audio/de3915c860a22269990f.mp3","entryId":"26797","definition":"来不及想，很快地。","pronunciation":["갑짜기"]},{"id":"7bc62a984968f494","term":"감하다","zh":"减少，减小","audio":"/audio/7bc62a984968f49443bd.mp3","entryId":"22745","definition":"长度、宽度、体积等变得比原来小。","pronunciation":["감ː하다"]}],"audio":"/audio/3342ba6a9fac722f42b7.mp3","speakerIndex":0},{"id":"n22745-3-7-2","ko":"빨래를 잘못했나 보다.","zh":"应该是洗衣服的时候弄错了吧。","note":"点不懂的词，看本句词义、助词和语尾；听词语后，再听整句。","parts":[{"text":"빨래를","meaning":"洗衣，洗衣服","explanation":"빨래：洗衣，洗衣服；를：宾格助词，标记动作对象。","readings":[{"term":"빨래","audio":"/audio/811f604d9f69b6be72e0.mp3"}],"sources":[{"entryId":"66638","senseId":"1","lemma":"빨래","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"빨래를","audio":"/audio/4700747c7baea59165eb.mp3"}},{"text":"잘못했나","meaning":"弄错，搞错","explanation":"잘못하다：弄错，搞错；었：过去或完成，常与词干缩合。；나：表示疑问或推测内容，常与 보다、싶다 等合用。","readings":[{"term":"잘못하다","audio":"/audio/c088e8817916a36c7669.mp3"}],"sources":[{"entryId":"69936","senseId":"2","lemma":"잘못하다","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"잘못했나","audio":"/audio/34271d3dd733b0c687f1.mp3"}},{"text":"보다.","meaning":"看来、好像（根据情况推测）","explanation":"보다：看来、好像（根据情况推测）；다：平叙句末，常用于书面叙述、自言自语或非