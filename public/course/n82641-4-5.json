67470","senseId":"24","lemma":"두다","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"둬야겠어","audio":"/audio/48b5201910dc9081595c.mp3"}}],"words":[{"id":"6d08580e9b088153","term":"맞다","zh":"对","audio":"/audio/6d08580e9b08815338a6.mp3","entryId":"66231","definition":"正是或没错。","pronunciation":["맏따"]},{"id":"70ae9bc35b2d378b","term":"좀","zh":"一点点，有一点","audio":"/audio/70ae9bc35b2d378b00ef.mp3","entryId":"75798","definition":"分量或程度稀少地。","pronunciation":["좀"]},{"id":"7a73d3320b5d8ca9","term":"틈","zh":"距离、隔阂（人际关系）","audio":"/audio/7a73d3320b5d8ca92720.mp3","entryId":"82641","definition":"距离、隔阂（人际关系）","pronunciation":["틈"]},{"id":"531b2c3977c491e8","term":"두다","zh":"隔开，保持","audio":"/audio/531b2c3977c491e8379e.mp3","entryId":"67470","definition":"与世界或人群不保持密切联系，维持距离。","pronunciation":["두다"]}],"audio":"/audio/293168954768f93d0467.mp3","speakerIndex":1}],"difficulty":2.12,"source":{"url":"https://krdict.korean.go.kr/chn/dicSearch/SearchView?ParaWordNo=82641","label":"国立国语院韩国语—汉语学习词典","license":"https://creativecommons.org/licenses/by-sa/2.0/kr/"},"sourceSenseId":"4","sourceLevel":"중급","day":71,"sequenceScore":1.9467,"questions":[{"lineIndex":0,"options":["那个朋友手脚不干净。","是啊，得和他保持点距离。","这两部电影的氛围真相似啊。"],"answer":0},{"lineIndex":1,"options":["那个朋友手脚不干净。","是啊，得和他保持点距离。","这两部电影的氛围真相似啊。"],"answer":1}]}
