00","senseId":"9","lemma":"가다","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"가자","audio":"/audio/9d6a16e0f490c47dce42.mp3"}}],"words":[{"id":"86d0464f1c6da402","term":"좋다","zh":"行，可以","audio":"/audio/86d0464f1c6da40233cd.mp3","entryId":"79033","definition":"某个行动或事情等不成问题。","pronunciation":["조ː타"]},{"id":"fac03210810d8611","term":"승승장구","zh":"乘胜长驱，乘胜追击","audio":"/audio/fac03210810d86110d0b.mp3","entryId":"65609","definition":"在打架或竞争中乘着赢的气势继续赢。","pronunciation":["승승장구"]},{"id":"c2cec1bf7ff0a600","term":"결승전","zh":"决赛","audio":"/audio/c2cec1bf7ff0a6007734.mp3","entryId":"31472","definition":"体育比赛中为了决定最终胜利者而在最后进行的比试。","pronunciation":["결씅전"]},{"id":"233cb510410b09d6","term":"가다","zh":"到达，迈向","audio":"/audio/233cb510410b09d69cdc.mp3","entryId":"27500","definition":"朝向某种状态或状况前进。","pronunciation":["가다"]}],"audio":"/audio/2dfc8f95751cf20eb371.mp3","speakerIndex":1}],"difficulty":2.87,"source":{"url":"https://krdict.korean.go.kr/chn/dicSearch/SearchView?ParaWordNo=65609","label":"国立国语院韩国语—汉语学习词典","license":"https://creativecommons.org/licenses/by-sa/2.0/kr/"},"sourceSenseId":"1","sourceLevel":"고급","day":138,"sequenceScore":2.6967,"questions":[{"lineIndex":0,"options":["好，一路高歌猛进，直奔决赛吧！","只要明天赢了这场比赛，我们就进半决赛了。","家里本来这么安静，这到底是怎么回事啊？"],"answer":1},{"lineIndex":1,"options":["只要明天赢了这场比赛，我们就进半决赛了。","家里本来这么安静，这到底是怎么回事啊？","好，一路高歌猛进，直奔决赛吧！"],"answer":2}]}
