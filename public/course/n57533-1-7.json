":[{"term":"진짜","audio":"/audio/79eea25f740b5721caae.mp3"}],"sources":[{"entryId":"71539","senseId":"1","lemma":"진짜","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"진짜","audio":"/audio/79eea25f740b5721caae.mp3"}},{"text":"오래","meaning":"好久，很久","explanation":"오래：好久，很久。","readings":[{"term":"오래","audio":"/audio/2f64811b687303a9be76.mp3"}],"sources":[{"entryId":"57308","senseId":"1","lemma":"오래","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"오래","audio":"/audio/2f64811b687303a9be76.mp3"}},{"text":"모았거든.","meaning":"积攒，储存，积蓄","explanation":"모으다：积攒，储存，积蓄；었：过去或完成，常与词干缩合；거든：补充理由或背景，非敬语句末。","readings":[{"term":"모으다","audio":"/audio/5ddf1bf1c10eabe3cc6f.mp3"}],"sources":[{"entryId":"74137","senseId":"3","lemma":"모으다","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"모았거든","audio":"/audio/add05dceb7788ae3ea5f.mp3"}}],"words":[{"id":"1098bbe54520ab2a","term":"나","zh":"我","audio":"/audio/1098bbe54520ab2a367c.mp3","entryId":"60931","definition":"说话人在朋友或晚辈面前用来指称自己。","pronunciation":["나"]},{"id":"cde4842b8ab41342","term":"동전","zh":"硬币","audio":"/audio/cde4842b8ab41342df40.mp3","entryId":"48655","definition":"用铜等金属制成的圆形货币。","pronunciation":["동전"]},{"id":"79eea25f740b5721","term":"진짜","zh":"真的","audio":"/audio/79eea25f740b5721caae.mp3","entryId":"71539","definition":"没有假装或虚假而真正地。","pronunciation":["진짜"]},{"id":"2f64811b687303a9","term":"오래","zh":"好久，很久","audio":"/audio/2f64811b687303a9be76.mp3","entryId":"57308","definition":"长时间。","pronunciation":["오래"]},{"id":"5ddf1bf1c10eabe3","term":"모으다","zh":"积攒，储存，积蓄","audio":"/audio/5ddf1bf1c10eabe3cc6f.mp3","entryId":"74137","definition":"不花掉钱财等，而是把它们存起来。","pronunciation":["모으다"]}],"audio":"/audio/bae75e0fcdbd685f6723.mp3","speakerIndex":1}],"difficulty":3.264,"source":{"url":"https://krdict.korean.go.kr/chn/dicSearch/SearchView?ParaWordNo=57533","label":"国立国语院韩国语—汉语学习词典","license":"https://creativecommons.org/licenses/by-sa/2.0/kr/"},"sourceSenseId":"1","sourceLevel":"고급","da