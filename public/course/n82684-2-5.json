inese dictionary"}],"surfaceReading":{"term":"어떻게","audio":"/audio/64e493d09f1b306ade0c.mp3"}},{"text":"되나?","meaning":"变得、最终处于某种情况（-게 되다）","explanation":"되다：变得、最终处于某种情况（-게 되다）；나：非敬语疑问句末，用于亲近的人、晚辈或自问。","readings":[{"term":"되다","audio":"/audio/91b4dc2748cba787dd6f.mp3"}],"sources":[{"entryId":"89858","senseId":"5","lemma":"되다","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"되나","audio":"/audio/892504cc7a72a81977bf.mp3"}}],"words":[{"id":"398dfa639dfd0db8","term":"우리","zh":"我们，咱们","audio":"/audio/398dfa639dfd0db8f8e0.mp3","entryId":"17182","definition":"说话人指代自己和听话人在内的一些人。","pronunciation":["우리"]},{"id":"fcabf64f5c78f2bd","term":"본관","zh":"籍贯","audio":"/audio/fcabf64f5c78f2bdb126.mp3","entryId":"59520","definition":"第一个开始使用家族姓氏的祖先的故乡。","pronunciation":["본관"]},{"id":"962ae18a075d06e2","term":"같다","zh":"相同，一样，一致","audio":"/audio/962ae18a075d06e2b7fd.mp3","entryId":"62076","definition":"彼此并无差异。","pronunciation":["갇따"]},{"id":"aa7a1b1564db7cda","term":"자네","zh":"你","audio":"/audio/aa7a1b1564db7cda8172.mp3","entryId":"70797","definition":"(敬语)听者为朋友或晚辈时用来指称听者。","pronunciation":["자네"]},{"id":"98aede974077c5c7","term":"파","zh":"派","audio":"/audio/98aede974077c5c77513.mp3","entryId":"82684","definition":"从同一个祖先分化出来的系统。","pronunciation":["파"]},{"id":"e0a8c114a77e0814","term":"어떻다","zh":"怎么样","audio":"/audio/e0a8c114a77e081454d1.mp3","entryId":"70482","definition":"想法、感觉、状态或境况等成为什么状况。","pronunciation":["어떠타"]},{"id":"91b4dc2748cba787","term":"되다","zh":"变得、最终处于某种情况（-게 되다）","audio":"/audio/91b4dc2748cba787dd6f.mp3","entryId":"89858","definition":"变得、最终处于某种情况（-게 되다）","pronunciation":["되다","뒈다"]}],"audio":"/audio/9500cf9c43a3ee104556.mp3","speakerIndex":0},{"id":"n82684-2-5-2","ko":"그게 기억이 잘 안 나네요.","zh":"这个我记不太清了。","note":"点不懂的词，看本句词义、助词和语尾；听词语后，再听整句。","parts":[{"text":"그게","meaning":"那个","explanation":"그것：那个；이：主格助词，标记主语。","readings":[{"term":"그것","audio":"/audio/49ef044188dcd25ecf37.mp3"}],"sources":[{"entryId":"31953","senseId":"2","lemma":"그것","origin":"NIKL