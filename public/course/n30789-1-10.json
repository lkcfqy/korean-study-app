277","senseId":"16","lemma":"하다","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"했어","audio":"/audio/76f3569b074c48dd5200.mp3"}}],"words":[{"id":"da78d4146f0588e8","term":"이번","zh":"这次，这回","audio":"/audio/da78d4146f0588e8450a.mp3","entryId":"29737","definition":"马上到来的顺序；或指刚过去的顺序。","pronunciation":["이번"]},{"id":"7626dbdf4beacffb","term":"명절","zh":"节日","audio":"/audio/7626dbdf4beacffb4c81.mp3","entryId":"55441","definition":"春节、中秋等每年固定的传统庆祝日或纪念日。","pronunciation":["명절"]},{"id":"c1ee1b7e560f9f3a","term":"어디","zh":"哪里，哪儿","audio":"/audio/c1ee1b7e560f9f3ac3bf.mp3","entryId":"60319","definition":"指代不知道的处所。","pronunciation":["어디"]},{"id":"233cb510410b09d6","term":"가다","zh":"通往，通向","audio":"/audio/233cb510410b09d69cdc.mp3","entryId":"27500","definition":"朝着或连着某个地方。","pronunciation":["가다"]},{"id":"505de0a2f6be73fa","term":"하다","zh":"决定","audio":"/audio/505de0a2f6be73fa7758.mp3","entryId":"73277","definition":"把某事定下来。","pronunciation":["하다"]}],"audio":"/audio/3c37e9fb4a726313e687.mp3","speakerIndex":0},{"id":"n30789-1-10-2","ko":"그냥 관행대로 시댁에 먼저 갔다가 친정에 가기로 했어.","zh":"按惯例，先去婆家，再回娘家。","note":"点不懂的词，看本句词义、助词和语尾；听词语后，再听整句。","parts":[{"text":"그냥","meaning":"就那样","explanation":"그냥：就那样","readings":[{"term":"그냥","audio":"/audio/e32fb95151ec34ccb0d2.mp3"}],"sources":[{"entryId":"36241","senseId":"1","lemma":"그냥","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"그냥","audio":"/audio/e32fb95151ec34ccb0d2.mp3"}},{"text":"관행대로","meaning":"习惯做法，惯例","explanation":"관행：习惯做法，惯例；대로：表示“按照、就……而言、各自”。","readings":[{"term":"관행","audio":"/audio/1c0a4076c8c3c99a6144.mp3"}],"sources":[{"entryId":"30789","senseId":"1","lemma":"관행","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"관행대로","audio":"/audio/9d037c8bbb21cb62e015.mp3"}},{"text":"시댁에","meaning":"婆家","explanation":"시댁：婆家；에：格助词，表示时间、位置、去向、对象等；需结合整句理解。","readings":[{"term":"시댁","audio":"/audio/f3ff8f8ed8f77ce044ff.mp3"}],"sources":[{"entryId":"13959","senseId":"1","lemma":"시댁","origin":"