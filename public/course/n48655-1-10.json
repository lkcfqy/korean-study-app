","senseId":"1","lemma":"저","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"제가","audio":"/audio/c1f551b0d681d02645e2.mp3"}},{"text":"동전으로","meaning":"硬币","explanation":"동전：硬币；으로：表示方向、方式、手段、材料、身份或原因等关系。","readings":[{"term":"동전","audio":"/audio/cde4842b8ab41342df40.mp3"}],"sources":[{"entryId":"48655","senseId":"1","lemma":"동전","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"동전으로","audio":"/audio/4453fd08f684f290320e.mp3"}},{"text":"바꿔","meaning":"更换，互换，对调","explanation":"바꾸다：更换，互换，对调；어：连接后续动作或辅助表达；常与前面的词干缩合。","readings":[{"term":"바꾸다","audio":"/audio/5cc3393b01c955d1c3fb.mp3"}],"sources":[{"entryId":"17198","senseId":"3","lemma":"바꾸다","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"바꿔","audio":"/audio/aaf9f253fd04921d1f86.mp3"}},{"text":"드릴게요.","meaning":"致，呈，献，奉上","explanation":"드리다：致，呈，献，奉上；ㄹ게요：向对方礼貌地表达自己的决定或承诺。","readings":[{"term":"드리다","audio":"/audio/e583f55bf1cfad46331c.mp3"}],"sources":[{"entryId":"61168","senseId":"1","lemma":"드리다","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"드릴게요","audio":"/audio/e61f9f5edc04f979cd3a.mp3"}}],"words":[{"id":"f7c6efa694aaef95","term":"그렇다","zh":"那样","audio":"/audio/f7c6efa694aaef9559bd.mp3","entryId":"61178","definition":"表示状态、样子、性质等与此相同。","pronunciation":["그러타"]},{"id":"86f87d3fb9919f14","term":"그럼","zh":"那么，既然那样","audio":"/audio/86f87d3fb9919f145d21.mp3","entryId":"60346","definition":"用于表示接受前文内容，或以前文为基础，提出新的主张。","pronunciation":["그럼"]},{"id":"36693e4ef4415624","term":"지폐","zh":"纸币","audio":"/audio/36693e4ef44156245eab.mp3","entryId":"28946","definition":"纸制货币。","pronunciation":["지폐","지페"]},{"id":"1b43f195318e9604","term":"주다","zh":"给予，给","audio":"/audio/1b43f195318e9604abd7.mp3","entryId":"82136","definition":"把东西等递给别人，让别人拥有或使用。","pronunciation":["주다"]},{"id":"ac0e9ef613fd92c8","term":"저","zh":"我","audio":"/audio/ac0e9ef613fd92c84845.mp3","entryId":"44506","definition":"说话人在听话人面前对自己的谦称。","pronunciation":["저"]},{"id":"cde4842b8ab41342","term":"동전","zh":"硬币","audio":"/audio/cde4842b8ab41342df40.mp3","entryId":"48655","definition":"用铜等金属制成的圆形货币。","pronunciation":["동전"]},{"id":"5cc3393b01c955d1","term":"바꾸다","zh":"更换，互换，对调","audio":"/audio/5cc3393b01c955d1c3fb.mp3","entryId":"17198","definition":"把自己的东西给别人，同时收取或得到其他东西。","pronunciation":["바꾸다"]},{"id":"e583f55bf1cfad46","term":"드리다","zh":"致，呈，献，奉上","audio":"/audio/e583f55bf1cfad46331c.mp3","entryId":"61168","definition":"(尊称)给。","pronunciation":["드리다"]}],"audio":"/audio/c9eb03ee4515911e9856.mp3","speakerIndex":1}],"difficulty":2.43,"source":{"url":"https://krdict.korean.go.kr/chn/dicSearch/SearchView?ParaWordNo=48655","label":"国立国语院韩国语—汉语学习词典","license":"https://creativecommons.org/licenses/by-sa/2.0/kr/"},"sourceSenseId":"1","sourceLevel":"초급","day":42,"sequenceScore":1.8807,"questions":[{"lineIndex":0,"options":["是吗？那请您给我纸币，我帮您换成硬币。","听说你找到了丢失的钱包？","那个，我现在没有硬币。"],"answer":2},{"lineIndex":1,"options":["是吗？那请您给我纸币，我帮您换成硬币。","那个，我现在没有硬币。","听说你找到了丢失的钱包？"],"answer":0}]}
