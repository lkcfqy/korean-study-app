3.mp3"}],"sources":[{"entryId":"62595","senseId":"2","lemma":"있다","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"있어요","audio":"/audio/499f8423f214354759ff.mp3"}}],"words":[{"id":"1202aff936337891","term":"친구","zh":"朋友，好友， 友人，故旧","audio":"/audio/1202aff936337891e079.mp3","entryId":"29742","definition":"关系亲近而交往甚密的人。","pronunciation":["친구"]},{"id":"1af2aeb1be04021c","term":"많이","zh":"多","audio":"/audio/1af2aeb1be04021c7be5.mp3","entryId":"66030","definition":"数、量、程度等超过一定标准地。","pronunciation":["마ː니"]},{"id":"cdf64a5f4a894678","term":"사귀다","zh":"交，结交，交往","audio":"/audio/cdf64a5f4a89467851be.mp3","entryId":"15656","definition":"相互了解并亲近地相处。","pronunciation":["사귀다"]},{"id":"b3eb1e6b0f18a5e0","term":"점차","zh":"越来越","audio":"/audio/b3eb1e6b0f18a5e08596.mp3","entryId":"70873","definition":"随着次序逐渐地。","pronunciation":["점ː차"]},{"id":"d47f2b93b27e999d","term":"익숙하다","zh":"熟悉，习惯","audio":"/audio/d47f2b93b27e999d9b44.mp3","entryId":"24991","definition":"经常看或经历某事而不陌生，感觉舒适。","pronunciation":["익쑤카다"]},{"id":"6fde84679c7f2c31","term":"지다","zh":"表示成为前面表达的状态。","audio":"/audio/6fde84679c7f2c315bb0.mp3","entryId":"77247","definition":"表示成为前面表达的状态。","pronunciation":["지다"]},{"id":"96fe52db2531c9e7","term":"있다","zh":"正在做、持续进行（-고 있다）","audio":"/audio/96fe52db2531c9e73e53.mp3","entryId":"62595","definition":"正在做、持续进行（-고 있다）","pronunciation":["읻따"]}],"audio":"/audio/24447518ab6ddfe73095.mp3","speakerIndex":1}],"difficulty":2.19,"source":{"url":"https://krdict.korean.go.kr/chn/dicSearch/SearchView?ParaWordNo=70873","label":"国立国语院韩国语—汉语学习词典","license":"https://creativecommons.org/licenses/by-sa/2.0/kr/"},"sourceSenseId":"1","sourceLevel":"중급","day":73,"sequenceScore":2.0167,"questions":[{"lineIndex":0,"options":["在美国留学的生活怎么样？","我交到了很多朋友，也渐渐适应了。","明明那么努力赚钱，为什么攒的钱一点都没有啊？"],"answer":0},{"lineIndex":1,"options":["在美国留学的生活怎么样？","我交到了很多朋友，也渐渐适应了。","明明那么努力赚钱，为什么攒的钱一点都没有啊？"],"answer":1}]}
