cd74af8e57.mp3"}},{"text":"전쟁이","meaning":"战争","explanation":"전쟁：战争；이：主格助词，标记主语。","readings":[{"term":"전쟁","audio":"/audio/83d1a46f11735a145b72.mp3"}],"sources":[{"entryId":"29551","senseId":"2","lemma":"전쟁","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"전쟁이","audio":"/audio/771db101d95f62a3e2d4.mp3"}},{"text":"끝이","meaning":"尽头，最后，终","explanation":"끝：尽头，最后，终；이：主格助词，标记主语。","readings":[{"term":"끝","audio":"/audio/fa22cdfb3221d82b98bd.mp3"}],"sources":[{"entryId":"48072","senseId":"1","lemma":"끝","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"끝이","audio":"/audio/187c73400143933cfe65.mp3"}},{"text":"날까...","meaning":"到，尽，完","explanation":"나다：到，尽，完；ㄹ까：非敬语地提出建议、自问或推测：“要不要、会不会”。","readings":[{"term":"나다","audio":"/audio/1a06e246c5fb49e2814c.mp3"}],"sources":[{"entryId":"62210","senseId":"25","lemma":"나다","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"날까","audio":"/audio/226dd51290d222d25293.mp3"}}],"words":[{"id":"87d7b69edce28452","term":"그러게","zh":"就是嘛，可不嘛","audio":"/audio/87d7b69edce28452d447.mp3","entryId":"36269","definition":"用于赞成或同意对方所说的话。","pronunciation":["그러게"]},{"id":"25f9ca42793d0a69","term":"언제","zh":"什么时候","audio":"/audio/25f9ca42793d0a69dee9.mp3","entryId":"17860","definition":"不知道的某时。","pronunciation":["언ː제"]},{"id":"8bafb6b7d17ead49","term":"이","zh":"这，这个","audio":"/audio/8bafb6b7d17ead4985bf.mp3","entryId":"71687","definition":"用于指示与话者离得近的物品，或用于指示话者所想的对象。","pronunciation":["이"]},{"id":"5eb36550b4cd74af","term":"교통","zh":"交通","audio":"/audio/5eb36550b4cd74af8e57.mp3","entryId":"64469","definition":"利用汽车、火车、船、飞机等工具运送人或货物。","pronunciation":["교통"]},{"id":"83d1a46f11735a14","term":"전쟁","zh":"战争","audio":"/audio/83d1a46f11735a145b72.mp3","entryId":"29551","definition":"(喻义)非常积极地对应某个问题或激烈竞争；或指由此引发的复杂情况。","pronunciation":["전ː쟁"]},{"id":"fa22cdfb3221d82b","term":"끝","zh":"尽头，最后，终","audio":"/audio/fa22cdfb3221d82b98bd.mp3","entryId":"48072","definition":"时间上的最后时刻。","pronunciation":["끋"]},{"id":"1