inese dictionary"}],"surfaceReading":{"term":"스타로","audio":"/audio/9f726d0fb59e9efc2003.mp3"}},{"text":"떠올랐어요.","meaning":"引人瞩目，崛起","explanation":"떠오르다：引人瞩目，崛起；었：过去或完成，常与词干缩合；어요：礼貌句末；可随语调表示陈述或询问。","readings":[{"term":"떠오르다","audio":"/audio/82013dc8d822f21e9506.mp3"}],"sources":[{"entryId":"53785","senseId":"4","lemma":"떠오르다","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"떠올랐어요","audio":"/audio/2ca559c3a58deab7d887.mp3"}}],"words":[{"id":"1c0ddfd005093840","term":"네","zh":"是，行","audio":"/audio/1c0ddfd0050938404c35.mp3","entryId":"17294","definition":"用于肯定回答长辈所提出的问题或命令等。","pronunciation":["네"]},{"id":"4e2a8844f69b923d","term":"그거","zh":"那个","audio":"/audio/4e2a8844f69b923decca.mp3","entryId":"62251","definition":"指代前面已提到过的对象。","pronunciation":["그거"]},{"id":"00ba802409e7703c","term":"계기","zh":"契机","audio":"/audio/00ba802409e7703c5bb4.mp3","entryId":"15267","definition":"某件事情发生或被决定的原因或机会。","pronunciation":["계ː기","게ː기"]},{"id":"c061b97872b29115","term":"스타","zh":"明星","audio":"/audio/c061b97872b2911540cd.mp3","entryId":"65066","definition":"人气高的艺人或运动员。","pronunciation":[]},{"id":"82013dc8d822f21e","term":"떠오르다","zh":"引人瞩目，崛起","audio":"/audio/82013dc8d822f21e9506.mp3","entryId":"53785","definition":"成为受关注的对象。","pronunciation":["떠오르다"]}],"audio":"/audio/0f9614190741d7d4af49.mp3","speakerIndex":1}],"difficulty":2.4,"source":{"url":"https://krdict.korean.go.kr/chn/dicSearch/SearchView?ParaWordNo=53785","label":"国立国语院韩国语—汉语学习词典","license":"https://creativecommons.org/licenses/by-sa/2.0/kr/"},"sourceSenseId":"4","sourceLevel":"중급","day":72,"sequenceScore":1.9976,"questions":[{"lineIndex":0,"options":["是的，从那以后她就成了明星。","大家都表现不错，就只有一个人有问题啊。","听说有位新人演员在国外获得了奖项？"],"answer":2},{"lineIndex":1,"options":["是的，借着这次获奖的契机，那位演员成为了明星。","听说有位新人演员在国外获得了奖项？","大家都表现不错，就只有一个人有问题啊。"],"answer":0}]}
