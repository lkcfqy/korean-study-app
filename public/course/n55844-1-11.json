858","senseId":"16","lemma":"되다","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"되었어","audio":"/audio/474adc172c09523843e4.mp3"}}],"words":[{"id":"38c61820e786f234","term":"그","zh":"那样，那个","audio":"/audio/38c61820e786f2346e96.mp3","entryId":"62250","definition":"指代前面已经讲过或听话人所想的对象。","pronunciation":["그"]},{"id":"29d23f06ebca35bd","term":"범인","zh":"犯人，罪犯","audio":"/audio/29d23f06ebca35bda654.mp3","entryId":"14455","definition":"违反法律、犯了错误的人。","pronunciation":["버ː민"]},{"id":"81e3f8d3325b407f","term":"목격자","zh":"目击者","audio":"/audio/81e3f8d3325b407faa95.mp3","entryId":"55844","definition":"亲眼看到某件事或事发现场的人。","pronunciation":["목껵짜"]},{"id":"df159f47a890ff65","term":"지금","zh":"现在，这会儿","audio":"/audio/df159f47a890ff655039.mp3","entryId":"62523","definition":"在说话的当时；或此时此刻。","pronunciation":["지금"]},{"id":"e0a8c114a77e0814","term":"어떻다","zh":"怎么样","audio":"/audio/e0a8c114a77e081454d1.mp3","entryId":"70482","definition":"想法、感觉、状态或境况等成为什么状况。","pronunciation":["어떠타"]},{"id":"91b4dc2748cba787","term":"되다","zh":"变得、最终处于某种情况（-게 되다）","audio":"/audio/91b4dc2748cba787dd6f.mp3","entryId":"89858","definition":"变得、最终处于某种情况（-게 되다）","pronunciation":["되다","뒈다"]}],"audio":"/audio/3ca9ba5d655bdd56fdd1.mp3","speakerIndex":0},{"id":"n55844-1-11-2","ko":"진술을 마치고 현재 경찰의 보호를 받고 있어.","zh":"做完陈述后，他目前正在接受警察的保护。","note":"点不懂的词，看本句词义、助词和语尾；听词语后，再听整句。","parts":[{"text":"진술을","meaning":"陈述","explanation":"진술：陈述；을：宾格助词，标记动作对象。","readings":[{"term":"진술","audio":"/audio/3a78ba87b0dad50e7fde.mp3"}],"sources":[{"entryId":"76824","senseId":"2","lemma":"진술","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"진술을","audio":"/audio/4ce3bdd88ffbb9a69e1e.mp3"}},{"text":"마치고","meaning":"结束，完成","explanation":"마치다：结束，完成；고：连接并列或先后的动作、状态；也用于 -고 있다 等搭配。","readings":[{"term":"마치다","audio":"/audio/48af85297dcba6b93058.mp3"}],"sources":[{"entryId":"61135","senseId":"1","lemma":"마치다","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"마치고","audio":"/audio/5de73d1fe00e69780ff4.mp3"}},{"text":"현재","meaning":"现在，目前，此时","explanation":"현재：现在，目前，此时","readings":[{"term":"현재","audio":"/audio/72d2bae2a744d54f0940.mp3"}],"sources":[{"entryId":"62446","senseId":"1","lemma":"현재","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"현재","audio":"/audio/72d2bae2a744d54f0940.mp3"}},{"text":"경찰의","meaning":"警方，警察当局","explanation":"경찰：警方，警察当局；의：所属、关联或修饰，常对应“的”。","readings":[{"term":"경찰","audio":"/audio/642315305ad781970c5b.mp3"}],"sources":[{"entryId":"25949","senseId":"1","lemma":"경찰","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"경찰의","audio":"/audio/5550412007cff082b1a9.mp3"}},{"text":"보호를","meaning":"保护","explanation":"보호：保护；를：宾格助词，标记动作对象。","readings":[{"term":"보호","audio":"/audio/d768523040084e56dcc3.mp3"}],"sources":[{"entryId":"62452","senseId":"1","lemma":"보호","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"보호를","audio":"/audio/ed5b1ff82096b57b40d8.mp3"}},{"text":"받고","meaning":"接受，遭受，经受，承蒙","explanation":"받다：接受，遭受，经受，承蒙；고：连接并列或先后的动作、状态；也用于 -고 있다 等搭配。","readings":[{"term":"받다","audio":"/audio/5af01487318c0c571462.mp3"}],"sources":[{"entryId":"66636","senseId":"3","lemma":"받다","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"받고","audio":"/audio/e32c6bc1baf2c63b758d.mp3"}},{"text":"있어.","meaning":"正在做、持续进行（-고 있다）","explanation":"있다：正在做、持续进行（-고 있다）；어：非敬语句末；与熟悉的人或晚辈交谈，语调决定陈述、询问等语气。","readings":[{"term":"있다","audio":"/audio/96fe52db2531c9e73e53.mp3"}],"sources":[{"entryId":"62595","senseId":"2","lemma":"있다","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"있어","audio":"/audio/675a95c70a831521b983.mp3"}}],"words":[{"id":"3a78ba87b0dad50e","term":"진술","zh":"陈述","audio":"/audio/3a78ba87b0dad50e7fde.mp3","entryId":"76824","definition":"在调查机关或法庭中，案件的当事人或涉案人员用言词或书面形式表达事实或看法；或指那样的事宜。","pronunciation":["진ː술"]},{"id":"48af85297dcba6b9","term":"마치다","zh":"结束，完成","audio":"/audio/48af85297dcba6b93058.mp3","entryId":"61135","definition":"做的事或过程完结；或指使其完结。","pronunciation":["마치다"]},{"id":"72d2bae2a744d54f","term":"현재","zh":"现在，目前，此时","audio":"/audio/72d2bae2a744d54f0940.mp3","entryId":"62446","definition":"现在这个时候。","pronunciation":["현ː재"]},{"id":"642315305ad78197","term":"경찰","zh":"警方，警察当局","audio":"/audio/642315305ad781970c5b.mp3","entryId":"25949","definition":"维持社会秩序、保护人民生命和财产安全；或指负责此事的国家机关。","pronunciation":["경ː찰"]},{"id":"d768523040084e56","term":"보호","zh":"保护","audio":"/audio/d768523040084e56dcc3.mp3","entryId":"62452","definition":"守护照顾以防止陷入危险或困难中。","pronunciation":["보ː호"]},{"id":"5af01487318c0c57","term":"받다","zh":"接受，遭受，经受，承蒙","audio":"/audio/5af01487318c0c571462.mp3","entryId":"66636","definition":"受到他人行为、心理作用等的影响。","pronunciation":["받따"]},{"id":"96fe52db2531c9e7","term":"있다","zh":"正在做、持续进行（-고 있다）","audio":"/audio/96fe52db2531c9e73e53.mp3","entryId":"62595","definition":"正在做、持续进行（-고 있다）","pronunciation":["읻따"]}],"audio":"/audio/e7620b7aed5f01ea3ce2.mp3","speakerIndex":1}],"difficulty":3.322,"source":{"url":"https://krdict.korean.go.kr/chn/dicSearch/SearchView?ParaWordNo=55844","label":"国立国语院韩国语—汉语学习词典","license":"https://creativecommons.org/licenses/by-sa/2.0/kr/"},"sourceSenseId":"1","sourceLevel":"고급","day":159,"sequenceScore":3.1487,"questions":[{"lineIndex":0,"options":["做完陈述后，他目前正在接受警察的保护。","哇，这里什么时候咖啡馆变这么多啦？","那个案犯的目击者现在怎么样了？"],"answer":2},{"lineIndex":1,"options":["做完陈述后，他目前正在接受警察的保护。","那个案犯的目击者现在怎么样了？","哇，这里什么时候咖啡馆变这么多啦？"],"answer":0}]}
