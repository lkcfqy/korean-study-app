62ccd6.mp3"}],"sources":[],"surfaceReading":{"term":"아니니","audio":"/audio/beb7172989a48b62ccd6.mp3"}}],"words":[{"id":"2483f8bd56cf84d9","term":"손발","zh":"手脚","audio":"/audio/2483f8bd56cf84d96e3d.mp3","entryId":"63970","definition":"手和脚。","pronunciation":["손발"]},{"id":"489db26a6bdebee8","term":"차갑다","zh":"凉，冰凉","audio":"/audio/489db26a6bdebee8cbe3.mp3","entryId":"71730","definition":"皮肤接触到的感觉很凉。","pronunciation":["차갑따"]},{"id":"c1ee1b7e560f9f3a","term":"어디","zh":"哪里，哪儿","audio":"/audio/c1ee1b7e560f9f3ac3bf.mp3","entryId":"60319","definition":"指代不确定的或难以准确表述的某个处所。","pronunciation":["어디"]},{"id":"912c6f176a189a34","term":"아프다","zh":"疼， 痛，不舒服","audio":"/audio/912c6f176a189a346579.mp3","entryId":"62239","definition":"因受伤或生病，而感到痛症或痛苦。","pronunciation":["아프다"]},{"id":"ffcedfda7558e5dc","term":"거","zh":"某种事物、现象或事实。","audio":"/audio/ffcedfda7558e5dc31fe.mp3","entryId":"62331","definition":"某种事物、现象或事实。","pronunciation":["거"]}],"audio":"/audio/2261ff7d136e1e9f1fec.mp3","speakerIndex":0},{"id":"n63970-1-7-2","ko":"아무래도 아까 먹은 음식이 체한 것 같아요.","zh":"可能是刚才吃的东西不消化，积食了。","note":"点不懂的词，看本句词义、助词和语尾；听词语后，再听整句。","parts":[{"text":"아무래도","meaning":"到底，还是","explanation":"아무래도：到底，还是","readings":[{"term":"아무래도","audio":"/audio/f5dbee1c946c5e6b1fa7.mp3"}],"sources":[{"entryId":"71330","senseId":"1","lemma":"아무래도","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"아무래도","audio":"/audio/f5dbee1c946c5e6b1fa7.mp3"}},{"text":"아까","meaning":"刚才，方才，刚刚","explanation":"아까：刚才，方才，刚刚","readings":[{"term":"아까","audio":"/audio/5dbe3d17e9e854897ec5.mp3"}],"sources":[{"entryId":"65974","senseId":"1","lemma":"아까","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"아까","audio":"/audio/5dbe3d17e9e854897ec5.mp3"}},{"text":"먹은","meaning":"吃","explanation":"먹다：吃；은：修饰后面的名词。形容词后表示当前性质；动词后通常表示已完成的动作或结果状态。","readings":[{"term":"먹다","audio":"/audio/9639f892bdddb53fc055.mp3"}],"sources":[{"entryId":"58272","senseId":"1","lemma":"먹다","origin":"NIKL Korean-Chinese dictionary"}],"surfaceR