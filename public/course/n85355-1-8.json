9919f145d21.mp3"}],"sources":[{"entryId":"60346","senseId":"2","lemma":"그럼","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"그럼","audio":"/audio/86f87d3fb9919f145d21.mp3"}},{"text":"내일","meaning":"明天，明日","explanation":"내일：明天，明日。","readings":[{"term":"내일","audio":"/audio/1e07b94ba5182a41e7de.mp3"}],"sources":[{"entryId":"30193","senseId":"1","lemma":"내일","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"내일","audio":"/audio/1e07b94ba5182a41e7de.mp3"}},{"text":"저녁에","meaning":"傍晚","explanation":"저녁：傍晚；에：格助词，表示时间、位置、去向、对象等；需结合整句理解。","readings":[{"term":"저녁","audio":"/audio/8d3c547011f433e6d259.mp3"}],"sources":[{"entryId":"71220","senseId":"1","lemma":"저녁","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"저녁에","audio":"/audio/adc9d30ae9de01c054e6.mp3"}},{"text":"해물탕","meaning":"海鲜汤","explanation":"해물탕：海鲜汤。","readings":[{"term":"해물탕","audio":"/audio/43e74453ea1e200be049.mp3"}],"sources":[{"entryId":"85356","senseId":"1","lemma":"해물탕","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"해물탕","audio":"/audio/43e74453ea1e200be049.mp3"}},{"text":"먹으러","meaning":"吃","explanation":"먹다：吃；으러：用于移动动词前，表示移动的目的：“去/来做……”。","readings":[{"term":"먹다","audio":"/audio/9639f892bdddb53fc055.mp3"}],"sources":[{"entryId":"58272","senseId":"1","lemma":"먹다","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"먹으러","audio":"/audio/3bc7725f95e57fc73de6.mp3"}},{"text":"가자.","meaning":"去，上","explanation":"가다：去，上；자：非敬语提议句末：“一起……吧”。","readings":[{"term":"가다","audio":"/audio/233cb510410b09d69cdc.mp3"}],"sources":[{"entryId":"27500","senseId":"6","lemma":"가다","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"가자","audio":"/audio/9d6a16e0f490c47dce42.mp3"}}],"words":[{"id":"1098bbe54520ab2a","term":"나","zh":"我","audio":"/audio/1098bbe54520ab2a367c.mp3","entryId":"60931","definition":"说话人在朋友或晚辈面前用来指称自己。","pronunciation":["나"]},{"id":"f7c6efa694aaef95","term":"그렇다","zh":"那样","audio":"/audio/f7