hn/dicSearch/SearchView?ParaWordNo=47145","label":"国立国语院韩国语—汉语学习词典","license":"https://creativecommons.org/licenses/by-sa/2.0/kr/"},"sourceSenseId":"1","sourceLevel":"고급","day":156,"sequenceScore":3.0907,"questions":[{"lineIndex":0,"options":["今天的游泳比赛怎么样了？拿到金牌了吗？","没有。很遗憾，只得了铜牌。","我住在国外的朋友给我寄了包裹。"],"answer":0},{"lineIndex":1,"options":["今天的游泳比赛怎么样了？拿到金牌了吗？","没有。很遗憾，只得了铜牌。","我住在国外的朋友给我寄了包裹。"],"answer":1}]}
