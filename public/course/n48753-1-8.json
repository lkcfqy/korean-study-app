234811588.mp3","entryId":"24055","definition":"制作出售食物的店铺。","pronunciation":["음ː식쩜"]},{"id":"233cb510410b09d6","term":"가다","zh":"去","audio":"/audio/233cb510410b09d69cdc.mp3","entryId":"27500","definition":"从一个地方移动到另一个地方。","pronunciation":["가다"]}],"audio":"/audio/8560bda2cfb00e861dff.mp3","speakerIndex":1}],"difficulty":2.675,"source":{"url":"https://krdict.korean.go.kr/chn/dicSearch/SearchView?ParaWordNo=48753","label":"国立国语院韩国语—汉语学习词典","license":"https://creativecommons.org/licenses/by-sa/2.0/kr/"},"sourceSenseId":"1","sourceLevel":"고급","day":131,"sequenceScore":2.5017,"questions":[{"lineIndex":0,"options":["快把车掉头，再回到餐厅去吧。","真搞不懂你姐姐是高中生还是大学生呢。","我好像把钱包落在餐厅里了。"],"answer":2},{"lineIndex":1,"options":["快把车掉头，再回到餐厅去吧。","我好像把钱包落在餐厅里了。","真搞不懂你姐姐是高中生还是大学生呢。"],"answer":0}]}
