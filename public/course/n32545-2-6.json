.mp3"}],"sources":[{"entryId":"87661","senseId":"1","lemma":"현실","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"현실이랑","audio":"/audio/516a4228f648dc5c5bc6.mp3"}},{"text":"구분이","meaning":"区分，划分，区别","explanation":"구분：区分，划分，区别；이：主格助词，标记主语。","readings":[{"term":"구분","audio":"/audio/d8ba487317ac4e370c54.mp3"}],"sources":[{"entryId":"24492","senseId":"1","lemma":"구분","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"구분이","audio":"/audio/a0dc3d436a57c84fa14a.mp3"}},{"text":"잘","meaning":"仔细地，专注地","explanation":"잘：仔细地，专注地","readings":[{"term":"잘","audio":"/audio/8aff11a4aebdccdbf05d.mp3"}],"sources":[{"entryId":"58939","senseId":"11","lemma":"잘","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"잘","audio":"/audio/8aff11a4aebdccdbf05d.mp3"}},{"text":"안","meaning":"不","explanation":"안：不","readings":[{"term":"안","audio":"/audio/bc00bc8172c83d5fab70.mp3"}],"sources":[{"entryId":"71372","senseId":"1","lemma":"안","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"안","audio":"/audio/bc00bc8172c83d5fab70.mp3"}},{"text":"될","meaning":"变得，弄得","explanation":"되다：变得，弄得；ㄹ：修饰后面的名词，表示预定、意向、推测或可能；具体含义取决于后接表达。","readings":[{"term":"되다","audio":"/audio/91b4dc2748cba787dd6f.mp3"}],"sources":[{"entryId":"89858","senseId":"16","lemma":"되다","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"될","audio":"/audio/dc84eeabbbd47f74f20a.mp3"}},{"text":"정도야.","meaning":"程度","explanation":"정도：程度；이다：表示“是”的判断形式。；야：非敬语判断或疑问句末，常与 이다 连用。","readings":[{"term":"정도","audio":"/audio/1a771e4b7f99176bc0a6.mp3"}],"sources":[{"entryId":"70876","senseId":"1","lemma":"정도","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"정도야","audio":"/audio/aecd4f30db558ef9a9d0.mp3"}}],"words":[{"id":"107dd01c3d38a368","term":"응","zh":"是，行","audio":"/audio/107dd01c3d38a368ad44.mp3","entryId":"30205","definition":"用于肯定回答对方所提出的问题或命令等。","pronunciation":["응"]},{"id":"1098bbe54520ab2a","term":"나","zh":"我","audio":"/audio/