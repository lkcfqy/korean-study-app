46e6c5f.mp3"}],"sources":[{"entryId":"90778","senseId":"1","lemma":"주소","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"주소를","audio":"/audio/e8fa907425f6015cd36a.mp3"}},{"text":"알려","meaning":"告知","explanation":"알리다：告知；어：连接后续动作或辅助表达；常与前面的词干缩合。","readings":[{"term":"알리다","audio":"/audio/c8eae4fd8a7a21d57d22.mp3"}],"sources":[{"entryId":"29770","senseId":"1","lemma":"알리다","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"알려","audio":"/audio/1418ba446b159cc48aac.mp3"}},{"text":"줄게.","meaning":"为别人做某事（-아/어 주다）","explanation":"주다：为别人做某事（-아/어 주다）；ㄹ게：向对方表达说话人的决定或承诺，非敬语。","readings":[{"term":"주다","audio":"/audio/1b43f195318e9604abd7.mp3"}],"sources":[{"entryId":"77245","senseId":"1","lemma":"주다","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"줄게","audio":"/audio/f81c77e211e7de437a74.mp3"}}],"words":[{"id":"7d3f1e161caf0a72","term":"지난주","zh":"上周","audio":"/audio/7d3f1e161caf0a7205ae.mp3","entryId":"58105","definition":"本周的前一周。","pronunciation":["지난주"]},{"id":"32a686e2d5809ce0","term":"쇼핑","zh":"购物","audio":"/audio/32a686e2d5809ce01f08.mp3","entryId":"58107","definition":"逛百货或商店，看并购买东西。","pronunciation":[]},{"id":"b2c8d45cf4a07057","term":"사이트","zh":"网站","audio":"/audio/b2c8d45cf4a07057a749.mp3","entryId":"61229","definition":"可供网络使用者随时上网并储存有信息的地方。","pronunciation":[]},{"id":"ee0ee072926e06fc","term":"사다","zh":"买，购买","audio":"/audio/ee0ee072926e06fcb4a4.mp3","entryId":"49419","definition":"用钱使某种东西或权利为己所有。","pronunciation":["사다"]},{"id":"b967dea5488a0b55","term":"치마","zh":"裙，裙子","audio":"/audio/b967dea5488a0b55846e.mp3","entryId":"57331","definition":"一种女性下身穿的没有裤腿部分的外衣。","pronunciation":["치마"]},{"id":"28e058c7cec8846e","term":"주소","zh":"地址，住址","audio":"/audio/28e058c7cec8846e6c5f.mp3","entryId":"90778","definition":"住所、单位、机关等所处的行政区域的名称。","pronunciation":["주ː소"]},{"id":"c8eae4fd8a7a21d5","term":"알리다","zh":"告知","audio":"/audio/c8eae4fd8a7a21d57d22.mp3","entryId":"29770","definition":"使醒悟或得知原本不知道或忘记的事情。","pronunciat