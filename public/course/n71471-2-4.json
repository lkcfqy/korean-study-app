":["하다"]}],"audio":"/audio/13a136d29da5cea573ca.mp3","speakerIndex":0},{"id":"n71471-2-4-2","ko":"네, 저는 십 회 졸업생입니다.","zh":"是的，我是十届的毕业生。","note":"点不懂的词，看本句词义、助词和语尾；听词语后，再听整句。","parts":[{"text":"네,","meaning":"是，是的，哎","explanation":"네：是，是的，哎","readings":[{"term":"네","audio":"/audio/1c0ddfd0050938404c35.mp3"}],"sources":[{"entryId":"17294","senseId":"1","lemma":"네","origin":"NIKL Korean-Chinese dictionary"}]},{"text":"저는","meaning":"我","explanation":"저：我；는：话题或对比助词。","readings":[{"term":"저","audio":"/audio/ac0e9ef613fd92c84845.mp3"}],"sources":[{"entryId":"44506","senseId":"1","lemma":"저","origin":"NIKL Korean-Chinese dictionary"}]},{"text":"십","meaning":"第十","explanation":"십：第十","readings":[{"term":"십","audio":"/audio/c7470d030eddae163a57.mp3"}],"sources":[{"entryId":"89595","senseId":"2","lemma":"십","origin":"NIKL Korean-Chinese dictionary"}]},{"text":"회","meaning":"届","explanation":"회：届","readings":[{"term":"회","audio":"/audio/0ef6c01e0a84b27b585e.mp3"}],"sources":[{"entryId":"73241","senseId":"2","lemma":"회","origin":"NIKL Korean-Chinese dictionary"}]},{"text":"졸업생입니다.","meaning":"毕业生","explanation":"졸업생：毕业生；이다：表示“是”的判断形式。；ㅂ니다：正式礼貌的陈述句末。","readings":[{"term":"졸업생","audio":"/audio/3b3c90578e48eccc6d2c.mp3"}],"sources":[{"entryId":"91754","senseId":"1","lemma":"졸업생","origin":"NIKL Korean-Chinese dictionary"}]}],"words":[{"id":"1c0ddfd005093840","term":"네","zh":"是，是的，哎","audio":"/audio/1c0ddfd0050938404c35.mp3","entryId":"17294","definition":"用于回应长辈的呼叫。","pronunciation":["네"]},{"id":"ac0e9ef613fd92c8","term":"저","zh":"我","audio":"/audio/ac0e9ef613fd92c84845.mp3","entryId":"44506","definition":"说话人在听话人面前对自己的谦称。","pronunciation":["저"]},{"id":"c7470d030eddae16","term":"십","zh":"第十","audio":"/audio/c7470d030eddae163a57.mp3","entryId":"89595","definition":"第十的。","pronunciation":["십"]},{"id":"0ef6c01e0a84b27b","term":"회","zh":"届","audio":"/audio/0ef6c01e0a84b27b585e.mp3","entryId":"73241","definition":"循环反复的次数。","pronunciation":["회","훼"]},{"id":"3b3c90578e48eccc","term":"졸업생