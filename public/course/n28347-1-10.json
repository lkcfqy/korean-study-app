/505de0a2f6be73fa7758.mp3"}],"sources":[{"entryId":"73277","senseId":"1","lemma":"하다","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"하곤","audio":"/audio/9aacd046b4459e854a95.mp3"}},{"text":"했었지.","meaning":"做，干","explanation":"하다：做，干；었었：回顾已经结束或与现在情况有区别的过去；지：表示确认、提醒、意愿或自问等，非敬语句末。","readings":[{"term":"하다","audio":"/audio/505de0a2f6be73fa7758.mp3"}],"sources":[{"entryId":"73277","senseId":"1","lemma":"하다","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"했었지","audio":"/audio/5b4ee0b3cfac90d36e80.mp3"}}],"words":[{"id":"398dfa639dfd0db8","term":"우리","zh":"我们，咱们","audio":"/audio/398dfa639dfd0db8f8e0.mp3","entryId":"17182","definition":"说话人指代自己和听话人在内的一些人。","pronunciation":["우리"]},{"id":"451696a98621dc5f","term":"다방","zh":"茶馆，咖啡馆","audio":"/audio/451696a98621dc5f4991.mp3","entryId":"28347","definition":"喝着茶、咖啡、饮料聊天或休息的场所。","pronunciation":["다방"]},{"id":"6ccd3f82b0317e51","term":"차","zh":"茶，茶水","audio":"/audio/6ccd3f82b0317e51da2a.mp3","entryId":"61117","definition":"将有香气或味道好的植物叶子、根或果实等熬制或泡制之后做成的可以喝的东西。","pronunciation":["차"]},{"id":"dbfc687cbb29318d","term":"마시다","zh":"喝，饮","audio":"/audio/dbfc687cbb29318d3ccd.mp3","entryId":"64682","definition":"使水等液体流入喉咙。","pronunciation":["마시다"]},{"id":"c247f4070c895eab","term":"데이트","zh":"约会","audio":"/audio/c247f4070c895eabe40b.mp3","entryId":"14381","definition":"男女想相互交往而见面。","pronunciation":[]},{"id":"505de0a2f6be73fa","term":"하다","zh":"做，干","audio":"/audio/505de0a2f6be73fa7758.mp3","entryId":"73277","definition":"进行某种行动、动作或活动。","pronunciation":["하다"]}],"audio":"/audio/174c40a523e37af8702e.mp3","speakerIndex":1}],"difficulty":2.848,"source":{"url":"https://krdict.korean.go.kr/chn/dicSearch/SearchView?ParaWordNo=28347","label":"国立国语院韩国语—汉语学习词典","license":"https://creativecommons.org/licenses/by-sa/2.0/kr/"},"sourceSenseId":"1","sourceLevel":"중급","day":101,"sequenceScore":2.6747,"questions":[{"lineIndex":0,"options":["妈妈和爸爸年轻的时候，主要在哪儿约会呢？","我们以前常在茶馆里边喝茶边约会。","智秀啊，妈妈去旅行的这段时间里，记得好好给花盆浇水哦。"],"a