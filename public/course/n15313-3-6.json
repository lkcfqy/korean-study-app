:"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"퍼지고","audio":"/audio/2ab1cd7970d4228ff170.mp3"}},{"text":"있어요.","meaning":"正在做、持续进行（-고 있다）","explanation":"있다：正在做、持续进行（-고 있다）；어요：礼貌句末；可随语调表示陈述或询问。","readings":[{"term":"있다","audio":"/audio/96fe52db2531c9e73e53.mp3"}],"sources":[{"entryId":"62595","senseId":"2","lemma":"있다","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"있어요","audio":"/audio/499f8423f214354759ff.mp3"}}],"words":[{"id":"21e91ac8a208ff9e","term":"맛있다","zh":"好吃，可口，香","audio":"/audio/21e91ac8a208ff9e520a.mp3","entryId":"70811","definition":"食物的味道好。","pronunciation":["마딛따","마싣따"]},{"id":"a67d0d1b921d4bc4","term":"냄새","zh":"气息，气味，气氛，迹象","audio":"/audio/a67d0d1b921d4bc49922.mp3","entryId":"58180","definition":"能从事物或现象等中感到的氛围。","pronunciation":["냄ː새"]},{"id":"dcc5631045195633","term":"온","zh":"全，整个","audio":"/audio/dcc56310451956332238.mp3","entryId":"67836","definition":"全部的；或全体的。","pronunciation":["온ː"]},{"id":"2474242906f4997e","term":"집안","zh":"家庭","audio":"/audio/2474242906f4997ecb89.mp3","entryId":"71361","definition":"以家人为成员生活的共同体；或指近亲。","pronunciation":["지반"]},{"id":"4dd9895ca1dc0b08","term":"가득히","zh":"满满地","audio":"/audio/4dd9895ca1dc0b080ee4.mp3","entryId":"15313","definition":"气味、光或声音等在空间里广为传播的状态。","pronunciation":["가드키"]},{"id":"a86003a36b481529","term":"퍼지다","zh":"扩散，散播","audio":"/audio/a86003a36b481529f116.mp3","entryId":"81118","definition":"物质或现象影响到很大的范围。","pronunciation":["퍼ː지다"]},{"id":"96fe52db2531c9e7","term":"있다","zh":"正在做、持续进行（-고 있다）","audio":"/audio/96fe52db2531c9e73e53.mp3","entryId":"62595","definition":"正在做、持续进行（-고 있다）","pronunciation":["읻따"]}],"audio":"/audio/c55bc5e0884eddfc954e.mp3","speakerIndex":0},{"id":"n15313-3-6-2","ko":"저녁 반찬으로 불고기를 만들었단다.","zh":"我做了烤牛肉当晚餐的配菜哦。","note":"点不懂的词，看本句词义、助词和语尾；听词语后，再听整句。","parts":[{"text":"저녁","meaning":"晚饭，晚餐","explanation":"저녁：晚饭，晚餐。","readings":[{"term":"저녁","audio":"/audio/8d3c547011f433e6d259.mp3"}],"sources":[{"entryId":"71220","senseId":"2","lemma":"저녁","