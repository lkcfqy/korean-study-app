ictionary"}],"surfaceReading":{"term":"다음부터는","audio":"/audio/fadf79ad6d68930569bb.mp3"}},{"text":"열심히","meaning":"认真地","explanation":"열심히：认真地。","readings":[{"term":"열심히","audio":"/audio/5be015e332c130d89835.mp3"}],"sources":[{"entryId":"67512","senseId":"1","lemma":"열심히","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"열심히","audio":"/audio/5be015e332c130d89835.mp3"}},{"text":"할게요.","meaning":"做，干","explanation":"하다：做，干；ㄹ게요：向对方礼貌地表达自己的决定或承诺。","readings":[{"term":"하다","audio":"/audio/505de0a2f6be73fa7758.mp3"}],"sources":[{"entryId":"73277","senseId":"1","lemma":"하다","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"할게요","audio":"/audio/4c64a4744f1b7d84309e.mp3"}}],"words":[{"id":"8df56b9bfbdae2fd","term":"그래서","zh":"因此，所以","audio":"/audio/8df56b9bfbdae2fd8463.mp3","entryId":"61169","definition":"用于表示前面内容是后面内容的原因、依据或条件等。","pronunciation":["그래서"]},{"id":"daac5ca7b302bd9b","term":"선생님","zh":"老师，教师","audio":"/audio/daac5ca7b302bd9b404a.mp3","entryId":"62818","definition":"(敬语)教授学生的人。","pronunciation":["선생님"]},{"id":"b4d47e56735ffcb5","term":"혼나다","zh":"被大骂，被怒斥","audio":"/audio/b4d47e56735ffcb5a8a4.mp3","entryId":"87966","definition":"被严重指责或受罚。","pronunciation":["혼나다"]},{"id":"aef613c6612d424a","term":"다음","zh":"以后，下次","audio":"/audio/aef613c6612d424ab454.mp3","entryId":"64531","definition":"一段时间后。","pronunciation":["다음"]},{"id":"5be015e332c130d8","term":"열심히","zh":"认真地","audio":"/audio/5be015e332c130d89835.mp3","entryId":"67512","definition":"对于某事专心诚意地。","pronunciation":["열씸히"]},{"id":"505de0a2f6be73fa","term":"하다","zh":"做，干","audio":"/audio/505de0a2f6be73fa7758.mp3","entryId":"73277","definition":"进行某种行动、动作或活动。","pronunciation":["하다"]}],"audio":"/audio/4e7839600fe0f31f3274.mp3","speakerIndex":1}],"difficulty":2.72,"source":{"url":"https://krdict.korean.go.kr/chn/dicSearch/SearchView?ParaWordNo=87966","label":"国立国语院韩国语—汉语学习词典","license":"https://creativecommons.org/licenses/by-sa/2.0/kr/"},"sourceSenseId":"2","sourceLevel":"중급","