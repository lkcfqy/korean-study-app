1","lemma":"고민","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"고민이야","audio":"/audio/6475e49d4e3257b3e98f.mp3"}}],"words":[{"id":"828c4030dd68aa7b","term":"요즘","zh":"最近，近来，这阵子","audio":"/audio/828c4030dd68aa7bc886.mp3","entryId":"20250","definition":"从非常近的过去到现在之间。","pronunciation":["요즘"]},{"id":"886ae927b512e2e4","term":"얼굴","zh":"容貌","audio":"/audio/886ae927b512e2e4bc7b.mp3","entryId":"17183","definition":"头部前面部分的整体长相或样子。","pronunciation":["얼굴"]},{"id":"5b53d08525a6cbca","term":"주름살","zh":"皱纹","audio":"/audio/5b53d08525a6cbcaaffd.mp3","entryId":"24658","definition":"皮肤老化而产生的条纹或细纹。","pronunciation":["주름쌀"]},{"id":"1af2aeb1be04021c","term":"많이","zh":"多","audio":"/audio/1af2aeb1be04021c7be5.mp3","entryId":"66030","definition":"数、量、程度等超过一定标准地。","pronunciation":["마ː니"]},{"id":"0a9915cd5915474e","term":"늘다","zh":"增加，延长","audio":"/audio/0a9915cd5915474e927c.mp3","entryId":"64492","definition":"时间或期限变得比原来长。","pronunciation":["늘다"]},{"id":"2d27a95090cbb680","term":"고민","zh":"苦闷，苦恼，烦恼","audio":"/audio/2d27a95090cbb6802399.mp3","entryId":"19225","definition":"心里有烦心事而痛苦，一直在意。","pronunciation":["고민"]}],"audio":"/audio/eee46490cb10a995c3ec.mp3","speakerIndex":0},{"id":"n24658-1-8-2","ko":"나도야. 나도 주름이 부쩍 많이 생겼어.","zh":"我也是。我的脸上也突然多了好多皱纹。","note":"点不懂的词，看本句词义、助词和语尾；听词语后，再听整句。","parts":[{"text":"나도야.","meaning":"我","explanation":"나：我；도：表示“也、连……也”；야：非敬语判断或疑问句末，常与 이다 连用。","readings":[{"term":"나","audio":"/audio/1098bbe54520ab2a367c.mp3"}],"sources":[{"entryId":"60931","senseId":"1","lemma":"나","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"나도야","audio":"/audio/fd9c93a2170109eecf50.mp3"}},{"text":"나도","meaning":"我","explanation":"나：我；도：表示“也、连……也”。","readings":[{"term":"나","audio":"/audio/1098bbe54520ab2a367c.mp3"}],"sources":[{"entryId":"60931","senseId":"1","lemma":"나","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"나도","audio":"/audio/9630a018a2b2bf43a396.mp3"}},{"text":"주름이","meaning":"皱纹","explanation":"주름：皱纹；이：主格