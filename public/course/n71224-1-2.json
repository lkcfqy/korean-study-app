361de82ac45.mp3"}],"sources":[{"entryId":"78071","senseId":"1","lemma":"쯧쯧","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"쯧쯧","audio":"/audio/a6d2526f9361de82ac45.mp3"}},{"text":"저런.","meaning":"啊，哎呀","explanation":"저런：啊，哎呀","readings":[{"term":"저런","audio":"/audio/2f66dcda6095507e43b6.mp3"}],"sources":[{"entryId":"71224","senseId":"1","lemma":"저런","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"저런","audio":"/audio/2f66dcda6095507e43b6.mp3"}},{"text":"가족들이","meaning":"家庭，家人","explanation":"가족：家庭，家人；들：复数后缀，表示多个对象。；이：主格助词，标记主语。","readings":[{"term":"가족","audio":"/audio/7659575fd72a872b8d05.mp3"}],"sources":[{"entryId":"44487","senseId":"1","lemma":"가족","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"가족들이","audio":"/audio/d69dfb967fbafe5f6083.mp3"}},{"text":"많이","meaning":"多","explanation":"많이：多","readings":[{"term":"많이","audio":"/audio/1af2aeb1be04021c7be5.mp3"}],"sources":[{"entryId":"66030","senseId":"1","lemma":"많이","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"많이","audio":"/audio/1af2aeb1be04021c7be5.mp3"}},{"text":"마음","meaning":"心情，心绪","explanation":"마음：心情，心绪","readings":[{"term":"마음","audio":"/audio/aa9cbf25b5381e2c30cd.mp3"}],"sources":[{"entryId":"20911","senseId":"3","lemma":"마음","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"마음","audio":"/audio/aa9cbf25b5381e2c30cd.mp3"}},{"text":"아파하시겠구나.","meaning":"疼痛","explanation":"아파하다：疼痛；시：主语敬语，尊敬动作或状态的主体。；겠：表示意愿、推测或礼貌委婉，结合整句判断。；구나：对新发现或新理解的情况表示感叹，非敬语。","readings":[{"term":"아파하다","audio":"/audio/48ec56b1b5790e709e73.mp3"}],"sources":[{"entryId":"66920","senseId":"1","lemma":"아파하다","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"아파하시겠구나","audio":"/audio/883ce4dd816b3e75b885.mp3"}}],"words":[{"id":"a6d2526f9361de82","term":"쯧쯧","zh":"啧啧","audio":"/audio/a6d2526f9361de82ac45.mp3","entryId":"78071","definition":"觉得很可怜或不满意而一直轻轻地咂嘴的声音。","pronunciation":["쯛쯛"]},{"id":"2f66dcda6095507e","te