.mp3"}}],"words":[{"id":"7d3f1e161caf0a72","term":"지난주","zh":"上周","audio":"/audio/7d3f1e161caf0a7205ae.mp3","entryId":"58105","definition":"本周的前一周。","pronunciation":["지난주"]},{"id":"7d57c92d078bf33a","term":"교수","zh":"教授","audio":"/audio/7d57c92d078bf33a0236.mp3","entryId":"31684","definition":"在大学里研究学问并讲授课程的人；或指其职位。","pronunciation":["교ː수"]},{"id":"01c1761e85dc638b","term":"수업","zh":"课、课程","audio":"/audio/01c1761e85dc638b63f3.mp3","entryId":"64597","definition":"教师和学生进行教学的课；本句指金教授上周的课程。","pronunciation":["수업"]},{"id":"b33db886cc66d392","term":"숙제","zh":"作业","audio":"/audio/b33db886cc66d3923b91.mp3","entryId":"65226","definition":"为了复习或预习，给学生布置的课后功课。","pronunciation":["숙쩨"]},{"id":"95b5c8cf1b249b7a","term":"뭐","zh":"什么","audio":"/audio/95b5c8cf1b249b7a376b.mp3","entryId":"84991","definition":"指代不知道的事实或事物。","pronunciation":["뭐ː"]}],"audio":"/audio/8ad19d8342f788d6f3b9.mp3","speakerIndex":0},{"id":"n36674-1-9-2","ko":"나도 그날 병원에 가느라 수업에 못 갔어.","zh":"我那天也因为要去医院，所以没去上课。","note":"点不懂的词，看本句词义、助词和语尾；听词语后，再听整句。","parts":[{"text":"나도","meaning":"我","explanation":"나：我；도：表示“也、连……也”。","readings":[{"term":"나","audio":"/audio/1098bbe54520ab2a367c.mp3"}],"sources":[{"entryId":"60931","senseId":"1","lemma":"나","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"나도","audio":"/audio/9630a018a2b2bf43a396.mp3"}},{"text":"그날","meaning":"那天，那日","explanation":"그날：那天，那日。","readings":[{"term":"그날","audio":"/audio/f243f3eadf4a87a81a35.mp3"}],"sources":[{"entryId":"36674","senseId":"1","lemma":"그날","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"그날","audio":"/audio/f243f3eadf4a87a81a35.mp3"}},{"text":"병원에","meaning":"医院","explanation":"병원：医院；에：格助词，表示时间、位置、去向、对象等；需结合整句理解。","readings":[{"term":"병원","audio":"/audio/4f4c2d79c47ca512edb7.mp3"}],"sources":[{"entryId":"62271","senseId":"1","lemma":"병원","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"병원에","audio":"/audio/2610e1319b7ca0517a20.mp3"}},{"text":"가느라","meaning":"因为去（医院）","explanat