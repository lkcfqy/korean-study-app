6","senseId":"1","lemma":"받다","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"받을","audio":"/audio/1ce65fb87a94df252095.mp3"}},{"text":"수","meaning":"可以，可能","explanation":"수：可以，可能。","readings":[{"term":"수","audio":"/audio/dcd19f5b5caac9771378.mp3"}],"sources":[{"entryId":"15615","senseId":"1","lemma":"수","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"수","audio":"/audio/dcd19f5b5caac9771378.mp3"}},{"text":"있을까요?","meaning":"能、可以（-ㄹ/을 수 있다）","explanation":"있다：能、可以（-ㄹ/을 수 있다）；을까요：礼貌地询问意见、提出建议或推测：“要不要、会不会”。","readings":[{"term":"있다","audio":"/audio/96fe52db2531c9e73e53.mp3"}],"sources":[{"entryId":"68797","senseId":"5","lemma":"있다","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"있을까요","audio":"/audio/ef6f1745d773e6085ac3.mp3"}}],"words":[{"id":"1c0ddfd005093840","term":"네","zh":"是，行","audio":"/audio/1c0ddfd0050938404c35.mp3","entryId":"17294","definition":"用于肯定回答长辈所提出的问题或命令等。","pronunciation":["네"]},{"id":"e9da00d63b62272d","term":"안녕하다","zh":"平安，安宁","audio":"/audio/e9da00d63b62272d4074.mp3","entryId":"72523","definition":"舒适而没有任何问题或担忧。","pronunciation":["안녕하다"]},{"id":"9948c1a693a36011","term":"명함","zh":"名片","audio":"/audio/9948c1a693a3601168ec.mp3","entryId":"55470","definition":"为向别人介绍自己而准备的，写有个人姓名、职业、地址、联系方式等的小纸片。","pronunciation":["명함"]},{"id":"70ae9bc35b2d378b","term":"좀","zh":"一下","audio":"/audio/70ae9bc35b2d378b00ef.mp3","entryId":"75798","definition":"主要用于委婉请求或征得同意。","pronunciation":["좀"]},{"id":"5af01487318c0c57","term":"받다","zh":"收到 ，得到","audio":"/audio/5af01487318c0c571462.mp3","entryId":"66636","definition":"拿到他人给的或送来的东西。","pronunciation":["받따"]},{"id":"dcd19f5b5caac977","term":"수","zh":"可以，可能","audio":"/audio/dcd19f5b5caac9771378.mp3","entryId":"15615","definition":"做某事的能力，或某事发生的可能性。","pronunciation":["수"]},{"id":"96fe52db2531c9e7","term":"있다","zh":"能、可以（-ㄹ/을 수 있다）","audio":"/audio/96fe52db2531c9e73e53.mp3","entryId":"68797","definition":"能、可以（-ㄹ/을 수 있다）","pronunciation":["읻따"]}],"audio":"/a