c3611.mp3","entryId":"62171","definition":"试着做（-아/어 보다）","pronunciation":["보다"]}],"audio":"/audio/31056616f87583bf6ab3.mp3","speakerIndex":1}],"difficulty":2.176,"source":{"url":"https://krdict.korean.go.kr/chn/dicSearch/SearchView?ParaWordNo=61612","label":"国立国语院韩国语—汉语学习词典","license":"https://creativecommons.org/licenses/by-sa/2.0/kr/"},"sourceSenseId":"2","sourceLevel":"중급","day":66,"sequenceScore":1.6561,"questions":[{"lineIndex":0,"options":["往这边轻轻扔扔看吧。","这个球还挺轻的啊。","明天早上要吃面包吗？"],"answer":1},{"lineIndex":1,"options":["这个球还挺轻的啊。","明天早上要吃面包吗？","往这边轻轻扔扔看吧。"],"answer":2}]}
