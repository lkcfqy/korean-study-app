cec3d4e03.mp3"}}],"words":[{"id":"c1ee1b7e560f9f3a","term":"어디","zh":"哪里、什么地方","audio":"/audio/c1ee1b7e560f9f3ac3bf.mp3","entryId":"60319","definition":"不确定的地点；这里指不清楚去了什么地方。","pronunciation":["어디"]},{"id":"233cb510410b09d6","term":"가다","zh":"去","audio":"/audio/233cb510410b09d69cdc.mp3","entryId":"27500","definition":"从一个地方移动到另一个地方。","pronunciation":["가다"]},{"id":"1443a6c090b12228","term":"것","zh":"表示某种行为、状态或事情。","audio":"/audio/1443a6c090b122289ad7.mp3","entryId":"62835","definition":"表示某种行为、状态或事情。","pronunciation":["걷"]},{"id":"962ae18a075d06e2","term":"같다","zh":"好像，可能","audio":"/audio/962ae18a075d06e2b7fd.mp3","entryId":"62076","definition":"推测出结果。","pronunciation":["갇따"]}],"audio":"/audio/5bac44ee638006abf66b.mp3","speakerIndex":1}],"difficulty":2.294,"source":{"url":"https://krdict.korean.go.kr/chn/dicSearch/SearchView?ParaWordNo=71343","label":"国立国语院韩国语—汉语学习词典","license":"https://creativecommons.org/licenses/by-sa/2.0/kr/"},"sourceSenseId":"3","sourceLevel":"초급","day":29,"sequenceScore":1.2832,"questions":[{"lineIndex":0,"options":["我看他好像跟智秀去了什么地方。","智秀的爸爸去哪儿了？","顾客您好，请看看这款产品。这是刚推出的新货哦。"],"answer":1},{"lineIndex":1,"options":["智秀的爸爸去哪儿了？","顾客您好，请看看这款产品。这是刚推出的新货哦。","我看他好像跟智秀去了什么地方。"],"answer":2}]}
