:[{"term":"같이","audio":"/audio/d44da011993f2a6e9ba5.mp3"}],"sources":[{"entryId":"26799","senseId":"2","lemma":"같이","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"같이","audio":"/audio/d44da011993f2a6e9ba5.mp3"}},{"text":"잘","meaning":"好好地，顺利地","explanation":"잘：好好地，顺利地","readings":[{"term":"잘","audio":"/audio/8aff11a4aebdccdbf05d.mp3"}],"sources":[{"entryId":"58939","senseId":"4","lemma":"잘","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"잘","audio":"/audio/8aff11a4aebdccdbf05d.mp3"}},{"text":"다녀.","meaning":"常去","explanation":"다니다：常去；어：非敬语句末；与熟悉的人或晚辈交谈，语调决定陈述、询问等语气。","readings":[{"term":"다니다","audio":"/audio/02309ed22c9c36273e57.mp3"}],"sources":[{"entryId":"29702","senseId":"1","lemma":"다니다","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"다녀","audio":"/audio/e3a1a0dcaf78067a8719.mp3"}}],"words":[{"id":"2e1177912c702a7a","term":"요새","zh":"近来，日来，最近","audio":"/audio/2e1177912c702a7aa0da.mp3","entryId":"67864","definition":"从不久前到现在的非常短的期间。","pronunciation":["요새"]},{"id":"81b0ce3160def2f0","term":"부쩍","zh":"猛地，一下子","audio":"/audio/81b0ce3160def2f0f1ac.mp3","entryId":"60036","definition":"某事物或某现象突然发生巨大变化的样子。","pronunciation":["부쩍"]},{"id":"0275722d7b511a47","term":"친하다","zh":"亲近，要好，亲密","audio":"/audio/0275722d7b511a470593.mp3","entryId":"80614","definition":"近交相知，感情深厚。","pronunciation":["친하다"]},{"id":"6fde84679c7f2c31","term":"지다","zh":"表示成为前面表达的状态。","audio":"/audio/6fde84679c7f2c315bb0.mp3","entryId":"77247","definition":"表示成为前面表达的状态。","pronunciation":["지다"]},{"id":"d44da011993f2a6e","term":"같이","zh":"一同，一块儿，共同","audio":"/audio/d44da011993f2a6e9ba5.mp3","entryId":"26799","definition":"和某物或某人一起。","pronunciation":["가치"]},{"id":"8aff11a4aebdccdb","term":"잘","zh":"好好地，顺利地","audio":"/audio/8aff11a4aebdccdbf05d.mp3","entryId":"58939","definition":"没有任何问题而舒服地。","pronunciation":["잘"]},{"id":"02309ed22c9c3627","term":"다니다","zh":"常去","audio":"/audio/02309ed22c9c36273e57.mp3","entryId":"29702","definition":"经常出入某个地方