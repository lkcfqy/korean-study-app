y"}],"surfaceReading":{"term":"다","audio":"/audio/822b7db6f6886f572413.mp3"}},{"text":"떨어진","meaning":"不足，短缺，耗尽","explanation":"떨어지다：不足，短缺，耗尽；ㄴ：修饰后面的名词。形容词后表示当前性质；动词后通常表示已完成的动作或结果状态。","readings":[{"term":"떨어지다","audio":"/audio/5360fef914150d393574.mp3"}],"sources":[{"entryId":"89796","senseId":"19","lemma":"떨어지다","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"떨어진","audio":"/audio/8d3dd164a68b845077aa.mp3"}},{"text":"것","meaning":"表示某种行为、状态或事情。","explanation":"것：表示某种行为、状态或事情。","readings":[{"term":"것","audio":"/audio/1443a6c090b122289ad7.mp3"}],"sources":[{"entryId":"62835","senseId":"4","lemma":"것","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"것","audio":"/audio/1443a6c090b122289ad7.mp3"}},{"text":"같습니다.","meaning":"好像，可能","explanation":"같다：好像，可能；습니다：正式礼貌的陈述句末。","readings":[{"term":"같다","audio":"/audio/962ae18a075d06e2b7fd.mp3"}],"sources":[{"entryId":"62076","senseId":"8","lemma":"같다","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"같습니다","audio":"/audio/70b461d79f2fe5361c43.mp3"}}],"words":[{"id":"ac0e9ef613fd92c8","term":"저","zh":"我","audio":"/audio/ac0e9ef613fd92c84845.mp3","entryId":"44506","definition":"说话人在听话人面前对自己的谦称。","pronunciation":["저"]},{"id":"6ac12a8f8e4e4c22","term":"생각","zh":"想法，念头，心思","audio":"/audio/6ac12a8f8e4e4c22657b.mp3","entryId":"58162","definition":"对某事持有意见或感受。","pronunciation":["생각"]},{"id":"5e29d5dcb84b4546","term":"배터리","zh":"电池","audio":"/audio/5e29d5dcb84b45469293.mp3","entryId":"58288","definition":"为汽车、手机、钟表等供给所需电力的装置。","pronunciation":[]},{"id":"822b7db6f6886f57","term":"다","zh":"全，都","audio":"/audio/822b7db6f6886f572413.mp3","entryId":"58175","definition":"无剩余或遗漏，所有的。","pronunciation":["다ː"]},{"id":"5360fef914150d39","term":"떨어지다","zh":"不足，短缺，耗尽","audio":"/audio/5360fef914150d393574.mp3","entryId":"89796","definition":"没进行补充，所以现在没有剩余。","pronunciation":["떠러지다"]},{"id":"1443a6c090b12228","term":"것","zh":"表示某种行为、状态或事情。","audio":"/audio/1443a6c090b122289ad7.mp3","entryId