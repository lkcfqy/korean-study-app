00ef.mp3"}},{"text":"더","meaning":"再，多","explanation":"더：再，多。","readings":[{"term":"더","audio":"/audio/1e2cb79b6970d0213fd9.mp3"}],"sources":[{"entryId":"26829","senseId":"1","lemma":"더","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"더","audio":"/audio/1e2cb79b6970d0213fd9.mp3"}},{"text":"풀어","meaning":"化开","explanation":"풀다：化开；어：连接后续动作或辅助表达；常与前面的词干缩合。","readings":[{"term":"풀다","audio":"/audio/cada9014a11f228c9dfe.mp3"}],"sources":[{"entryId":"29761","senseId":"12","lemma":"풀다","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"풀어","audio":"/audio/5a537899b7ec8fb4557b.mp3"}},{"text":"넣어.","meaning":"放入，加入","explanation":"넣다：放入，加入；어：非敬语句末；与熟悉的人或晚辈交谈，语调决定陈述、询问等语气。","readings":[{"term":"넣다","audio":"/audio/c0bd6058bd724000a75e.mp3"}],"sources":[{"entryId":"64509","senseId":"2","lemma":"넣다","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"넣어","audio":"/audio/5917140fe7e2cfbda3f8.mp3"}}],"words":[{"id":"e756c665f973bc6d","term":"에이","zh":"嗨","audio":"/audio/e756c665f973bc6dc4c1.mp3","entryId":"70946","definition":"伤心或不满意时发出的声音。","pronunciation":["에이"]},{"id":"8710536623905dfc","term":"싱겁다","zh":"淡，清淡","audio":"/audio/8710536623905dfce5e1.mp3","entryId":"16472","definition":"食物的咸味少。","pronunciation":["싱겁따"]},{"id":"3d09660e62955de5","term":"소금","zh":"盐，咸盐","audio":"/audio/3d09660e62955de5ce0d.mp3","entryId":"61167","definition":"有咸味的白色粉末。","pronunciation":["소금"]},{"id":"70ae9bc35b2d378b","term":"좀","zh":"一下","audio":"/audio/70ae9bc35b2d378b00ef.mp3","entryId":"75798","definition":"主要用于委婉请求或征得同意。","pronunciation":["좀"]},{"id":"1e2cb79b6970d021","term":"더","zh":"再，多","audio":"/audio/1e2cb79b6970d0213fd9.mp3","entryId":"26829","definition":"添补而继续。","pronunciation":["더"]},{"id":"cada9014a11f228c","term":"풀다","zh":"化开","audio":"/audio/cada9014a11f228c9dfe.mp3","entryId":"29761","definition":"把东西放进液体里搅拌均匀或使之溶化。","pronunciation":["풀다"]},{"id":"c0bd6058bd724000","term":"넣다","zh":"放入，加入","audio":"/audio/c0bd6058bd724000a75e.mp3","entryId":"64509","definition":"使跟别的东西混合或参杂在一起。","pronunciation":["너ː타"]}],"audio":"/audio/46af940cdd5ce6b41f46.mp3","speakerIndex":1}],"difficulty":2.845,"source":{"url":"https://krdict.korean.go.kr/chn/dicSearch/SearchView?ParaWordNo=29761","label":"国立国语院韩国语—汉语学习词典","license":"https://creativecommons.org/licenses/by-sa/2.0/kr/"},"sourceSenseId":"12","sourceLevel":"초급","day":51,"sequenceScore":2.2238,"questions":[{"lineIndex":0,"options":["哎，太淡了，再加点盐吧。","我煮的汤味道怎么样？","看，这道题只要用这种方法解，就很容易解决了。"],"answer":1},{"lineIndex":1,"options":["我煮的汤味道怎么样？","看，这道题只要用这种方法解，就很容易解决了。","哎，太淡了，再加点盐吧。"],"answer":2}]}
