6e6b.mp3"}},{"text":"감자도","meaning":"马铃薯，土豆","explanation":"감자：马铃薯，土豆；도：表示“也、连……也”。","readings":[{"term":"감자","audio":"/audio/33f260e0ceece725d98e.mp3"}],"sources":[{"entryId":"85863","senseId":"1","lemma":"감자","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"감자도","audio":"/audio/51561848f07ff54fc7b1.mp3"}},{"text":"캐고","meaning":"挖掘，开采","explanation":"캐다：挖掘，开采；고：连接并列或先后的动作、状态；也用于 -고 있다 等搭配。","readings":[{"term":"캐다","audio":"/audio/7f7153d224edae86409e.mp3"}],"sources":[{"entryId":"81755","senseId":"1","lemma":"캐다","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"캐고","audio":"/audio/13f5f3d2a544f4cdda71.mp3"}},{"text":"옥수수도","meaning":"玉米，苞米，棒子","explanation":"옥수수：玉米，苞米，棒子；도：表示“也、连……也”。","readings":[{"term":"옥수수","audio":"/audio/acc93fc5f905327ebe71.mp3"}],"sources":[{"entryId":"67589","senseId":"1","lemma":"옥수수","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"옥수수도","audio":"/audio/78b8e0d4d4ce01c0503c.mp3"}},{"text":"땄어.","meaning":"摘，采","explanation":"따다：摘，采；었：过去或完成，常与词干缩合。；어：非敬语句末；与熟悉的人或晚辈交谈，语调决定陈述、询问等语气。","readings":[{"term":"따다","audio":"/audio/2568b45d590064759f23.mp3"}],"sources":[{"entryId":"61395","senseId":"1","lemma":"따다","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"땄어","audio":"/audio/e350f172109fec952d50.mp3"}}],"words":[{"id":"8d3efc29ac663a71","term":"시골","zh":"乡下，农村，乡村","audio":"/audio/8d3efc29ac663a719491.mp3","entryId":"62488","definition":"离城市较远、人口稀少且开发不充分的地区。","pronunciation":["시골"]},{"id":"6600340ce9e158e7","term":"할아버지","zh":"爷爷，姥爷","audio":"/audio/6600340ce9e158e7d903.mp3","entryId":"74121","definition":"用于指称或称呼父亲的父亲或母亲的父亲。","pronunciation":["하라버지"]},{"id":"1ad485c2f73968fd","term":"댁","zh":"府，贵府","audio":"/audio/1ad485c2f73968fd25de.mp3","entryId":"64392","definition":"(敬语)别人的家或家庭。","pronunciation":["댁"]},{"id":"233cb510410b09d6","term":"가다","zh":"去","audio":"/audio/233cb510410b09d69cdc.mp3","entryId":"27500","definition":"从一个地方移动到另一个地方。","pronunciation":["가다"]},{"id":"33f260e0ceece725","term":"감자","zh":"马铃薯，土豆","audio":"/audio/33f260e0ceece725d98e.mp3","entryId":"85863","definition":"外皮呈淡褐色、里面呈淡黄色，生长在地下的圆形块茎。","pronunciation":["감자"]},{"id":"7f7153d224edae86","term":"캐다","zh":"挖掘，开采","audio":"/audio/7f7153d224edae86409e.mp3","entryId":"81755","definition":"把埋在地里的东西挖开拿出来。","pronunciation":["캐ː다"]},{"id":"acc93fc5f905327e","term":"옥수수","zh":"玉米，苞米，棒子","audio":"/audio/acc93fc5f905327ebe71.mp3","entryId":"67589","definition":"植株高大，叶长，顶部长有须状的疏松团簇，颗粒紧凑的植物。","pronunciation":["옥쑤수"]},{"id":"2568b45d59006475","term":"따다","zh":"摘，采","audio":"/audio/2568b45d590064759f23.mp3","entryId":"61395","definition":"抓住摘下或撕下挂着或粘着的东西。","pronunciation":["따다"]}],"audio":"/audio/67dd93915c4b036e91df.mp3","speakerIndex":1}],"difficulty":2.949,"source":{"url":"https://krdict.korean.go.kr/chn/dicSearch/SearchView?ParaWordNo=81755","label":"国立国语院韩国语—汉语学习词典","license":"https://creativecommons.org/licenses/by-sa/2.0/kr/"},"sourceSenseId":"1","sourceLevel":"고급","day":141,"sequenceScore":2.7757,"questions":[{"lineIndex":0,"options":["我去了乡下爷爷家，既挖了土豆，又收了玉米。","看到了吗？我进球了哦！","这次假期你做了什么？"],"answer":2},{"lineIndex":1,"options":["我去了乡下爷爷家，既挖了土豆，又收了玉米。","这次假期你做了什么？","看到了吗？我进球了哦！"],"answer":0}]}
