6023168f260.mp3"}}],"words":[{"id":"1202aff936337891","term":"친구","zh":"朋友","audio":"/audio/1202aff936337891e079.mp3","entryId":"29742","definition":"朋友","pronunciation":["친구"]},{"id":"e27f0e273d4af17d","term":"싸우다","zh":"打架，争斗","audio":"/audio/e27f0e273d4af17d7ed1.mp3","entryId":"29732","definition":"想要获胜而用语言或力气等进行较量。","pronunciation":["싸우다"]},{"id":"b4049b7414b62d9b","term":"조금","zh":"一点点，稍微，略微","audio":"/audio/b4049b7414b62d9bee5d.mp3","entryId":"61176","definition":"微量或微小的程度。","pronunciation":["조금"]},{"id":"128510caa5a5a0b6","term":"다치다","zh":"受伤，负伤，弄伤","audio":"/audio/128510caa5a5a0b67924.mp3","entryId":"73400","definition":"被撞到或被打后身上或身体的一部分出现伤口；或指使出现伤口。","pronunciation":["다치다"]}],"audio":"/audio/d6a89391224e7ec5b06e.mp3","speakerIndex":1}],"difficulty":1.44,"source":{"url":"https://krdict.korean.go.kr/chn/dicSearch/SearchView?ParaWordNo=62397","label":"国立国语院韩国语—汉语学习词典","license":"https://creativecommons.org/licenses/by-sa/2.0/kr/"},"sourceSenseId":"4","sourceLevel":"초급","day":17,"sequenceScore":0.6255,"questions":[{"lineIndex":0,"options":["你的脸怎么成这样了？","跟朋友打架时受了点伤。","您夫人去哪儿了？"],"answer":0},{"lineIndex":1,"options":["你的脸怎么成这样了？","跟朋友打架时受了点伤。","您夫人去哪儿了？"],"answer":1}]}
