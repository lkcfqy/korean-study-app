88c4e3.mp3"}},{"text":"연관이","meaning":"关联，相关，有关，联系","explanation":"연관：关联，相关，有关，联系；이：主格助词，标记主语。","readings":[{"term":"연관","audio":"/audio/2ca18b72760744f3da5b.mp3"}],"sources":[{"entryId":"13974","senseId":"1","lemma":"연관","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"연관이","audio":"/audio/500dd93a991635f375ee.mp3"}},{"text":"있나","meaning":"有、存在（关联）","explanation":"있다：有、存在（关联）；나：表示疑问或推测内容，常与 보다、싶다 等合用。","readings":[{"term":"있다","audio":"/audio/96fe52db2531c9e73e53.mp3"}],"sources":[{"entryId":"68797","senseId":"2","lemma":"있다","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"있나","audio":"/audio/54242f507cd667676232.mp3"}},{"text":"봐.","meaning":"看来、好像（根据情况推测）","explanation":"보다：看来、好像（根据情况推测）；어：非敬语句末；与熟悉的人或晚辈交谈，语调决定陈述、询问等语气。","readings":[{"term":"보다","audio":"/audio/6a45cf834264a5ec3611.mp3"}],"sources":[{"entryId":"62249","senseId":"1","lemma":"보다","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"봐","audio":"/audio/fdcffec86114c54dd4e0.mp3"}}],"words":[{"id":"da78d4146f0588e8","term":"이번","zh":"这次，这回","audio":"/audio/da78d4146f0588e8450a.mp3","entryId":"29737","definition":"马上到来的顺序；或指刚过去的顺序。","pronunciation":["이번"]},{"id":"d04be92d4a8150be","term":"사건","zh":"事件，案件","audio":"/audio/d04be92d4a8150be63c8.mp3","entryId":"15654","definition":"能够引发关心或瞩目的事情。","pronunciation":["사ː껀"]},{"id":"38c61820e786f234","term":"그","zh":"那个","audio":"/audio/38c61820e786f2346e96.mp3","entryId":"43883","definition":"指代与听话人较近或听话人所想的对象。","pronunciation":["그"]},{"id":"389e7564ae2551b4","term":"사람","zh":"人","audio":"/audio/389e7564ae2551b4f94d.mp3","entryId":"58161","definition":"可以思考，会制造并使用语言和工具、构成社会而生活的存在。","pronunciation":["사ː람"]},{"id":"2ca18b72760744f3","term":"연관","zh":"关联，相关，有关，联系","audio":"/audio/2ca18b72760744f3da5b.mp3","entryId":"13974","definition":"两个以上的事物或现象等相互缔结关系的事情。","pronunciation":["연관"]},{"id":"96fe52db2531c9e7","term":"있다","zh":"有、存在（关联）","audio":"/audio/96fe52db2531c9e73e53.mp3","entryId":"68797","definitio