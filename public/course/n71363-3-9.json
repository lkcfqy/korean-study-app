y"}]}],"words":[{"id":"1098bbe54520ab2a","term":"나","zh":"我","audio":"/audio/1098bbe54520ab2a367c.mp3","entryId":"60931","definition":"说话人在朋友或晚辈面前用来指称自己。","pronunciation":["나"]},{"id":"4692cef5ac69eb37","term":"시간","zh":"时间，空儿","audio":"/audio/4692cef5ac69eb37bd53.mp3","entryId":"62841","definition":"做某事的空闲。","pronunciation":["시간"]},{"id":"815560dcd5b82893","term":"없다","zh":"没有","audio":"/audio/815560dcd5b828930ac0.mp3","entryId":"89917","definition":"不具有某物，或不具备资格、能力。","pronunciation":["업ː따"]},{"id":"6dab7d40289b180d","term":"짧다","zh":"短","audio":"/audio/6dab7d40289b180d0cb0.mp3","entryId":"71363","definition":"文章的字数或说的话少。","pronunciation":["짤따"]},{"id":"f70cb61c1b19f138","term":"말하다","zh":"说，讲","audio":"/audio/f70cb61c1b19f1388e68.mp3","entryId":"62103","definition":"用话语表达某种事实、自己的想法或感觉等。","pronunciation":["말ː하다"]}],"audio":"/audio/0a3761d77f517d1cb458.mp3","speakerIndex":1}],"difficulty":2.65,"source":{"url":"https://krdict.korean.go.kr/chn/dicSearch/SearchView?ParaWordNo=71363","label":"国立国语院韩国语—汉语学习词典","license":"https://creativecommons.org/licenses/by-sa/2.0/kr/"},"sourceSenseId":"3","sourceLevel":"초급","day":47,"sequenceScore":2.1007,"questions":[{"lineIndex":0,"options":["我没时间，长话短说吧。","姐姐，麻烦你稍微和我说几句话吧。","智秀学习可真用功啊。"],"answer":1},{"lineIndex":1,"options":["姐姐，麻烦你稍微和我说几句话吧。","智秀学习可真用功啊。","我没时间，长话短说吧。"],"answer":2}]}
