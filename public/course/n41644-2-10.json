Reading":{"term":"같던데요","audio":"/audio/b8bdd6b7069cec3d4e03.mp3"}}],"words":[{"id":"79c5ada11647bce6","term":"어제","zh":"昨天，昨日","audio":"/audio/79c5ada11647bce64407.mp3","entryId":"67075","definition":"今天的前一天。","pronunciation":["어제"]},{"id":"c6a3b6d97217b4d8","term":"남자","zh":"男性（남자 친구 合指“男朋友”）","audio":"/audio/c6a3b6d97217b4d81661.mp3","entryId":"60865","definition":"男性（남자 친구 合指“男朋友”）","pronunciation":["남자"]},{"id":"1202aff936337891","term":"친구","zh":"朋友，好友， 友人，故旧","audio":"/audio/1202aff936337891e079.mp3","entryId":"29742","definition":"关系亲近而交往甚密的人。","pronunciation":["친구"]},{"id":"e27f0e273d4af17d","term":"싸우다","zh":"打架，争斗","audio":"/audio/e27f0e273d4af17d7ed1.mp3","entryId":"29732","definition":"想要获胜而用语言或力气等进行较量。","pronunciation":["싸우다"]},{"id":"e2d6245630ee85fa","term":"눈치","zh":"眼色，神色，样子","audio":"/audio/e2d6245630ee85fa9b86.mp3","entryId":"41644","definition":"可以让猜测到内心或状况的态度或表情。","pronunciation":["눈치"]},{"id":"962ae18a075d06e2","term":"같다","zh":"好像、看来（推测）","audio":"/audio/962ae18a075d06e2b7fd.mp3","entryId":"62076","definition":"好像、看来（推测）","pronunciation":["갇따"]}],"audio":"/audio/753f3a328bbd63aa5a4b.mp3","speakerIndex":1}],"difficulty":2.593,"source":{"url":"https://krdict.korean.go.kr/chn/dicSearch/SearchView?ParaWordNo=41644","label":"国立国语院韩国语—汉语学习词典","license":"https://creativecommons.org/licenses/by-sa/2.0/kr/"},"sourceSenseId":"2","sourceLevel":"중급","day":78,"sequenceScore":2.1906,"questions":[{"lineIndex":0,"options":["看来她是昨天和男朋友吵架了。","智秀怎么这么闷闷不乐的？","这个钥匙扣真漂亮！是在哪儿买的呀？"],"answer":1},{"lineIndex":1,"options":["智秀怎么这么闷闷不乐的？","这个钥匙扣真漂亮！是在哪儿买的呀？","看来她是昨天和男朋友吵架了。"],"answer":2}]}
