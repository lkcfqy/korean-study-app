9f145d21.mp3"}},{"text":"좀","meaning":"一点点，有一点","explanation":"좀：一点点，有一点。","readings":[{"term":"좀","audio":"/audio/70ae9bc35b2d378b00ef.mp3"}],"sources":[{"entryId":"75798","senseId":"1","lemma":"좀","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"좀","audio":"/audio/70ae9bc35b2d378b00ef.mp3"}},{"text":"더","meaning":"更，更加","explanation":"더：更，更加。","readings":[{"term":"더","audio":"/audio/1e2cb79b6970d0213fd9.mp3"}],"sources":[{"entryId":"26829","senseId":"2","lemma":"더","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"더","audio":"/audio/1e2cb79b6970d0213fd9.mp3"}},{"text":"짙은","meaning":"深","explanation":"짙다：深；은：修饰后面的名词。形容词后表示当前性质；动词后通常表示已完成的动作或结果状态。","readings":[{"term":"짙다","audio":"/audio/534980e3f6bb292a26ba.mp3"}],"sources":[{"entryId":"71362","senseId":"1","lemma":"짙다","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"짙은","audio":"/audio/b1191b7442c62a813a50.mp3"}},{"text":"색으로","meaning":"色，色彩","explanation":"색：色，色彩；으로：表示方向、方式、手段、材料、身份或原因等关系。","readings":[{"term":"색","audio":"/audio/4e0f2a64814ac0cdc90a.mp3"}],"sources":[{"entryId":"20231","senseId":"1","lemma":"색","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"색으로","audio":"/audio/f36b209daf51415c8a7e.mp3"}},{"text":"입을까?","meaning":"穿","explanation":"입다：穿；을까：非敬语地提出建议、自问或推测：“要不要、会不会”。","readings":[{"term":"입다","audio":"/audio/5e126f454a274733cfa2.mp3"}],"sources":[{"entryId":"17174","senseId":"1","lemma":"입다","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"입을까","audio":"/audio/b4a6a3ace5ccd69382bb.mp3"}}],"words":[{"id":"86f87d3fb9919f14","term":"그럼","zh":"那么，既然那样","audio":"/audio/86f87d3fb9919f145d21.mp3","entryId":"60346","definition":"用于表示接受前文内容，或以前文为基础，提出新的主张。","pronunciation":["그럼"]},{"id":"70ae9bc35b2d378b","term":"좀","zh":"一点点，有一点","audio":"/audio/70ae9bc35b2d378b00ef.mp3","entryId":"75798","definition":"分量或程度稀少地。","pronunciation":["좀"]},{"id":"1e2cb79b6970d021","term":"더","zh":"更，更加","audio":"/audi