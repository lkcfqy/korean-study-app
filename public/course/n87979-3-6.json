nese dictionary"}],"surfaceReading":{"term":"월드컵","audio":"/audio/d0bd7c9c7885ea24880f.mp3"}},{"text":"축구","meaning":"足球","explanation":"축구：足球","readings":[{"term":"축구","audio":"/audio/c21dee4a35ad739ca03e.mp3"}],"sources":[{"entryId":"36700","senseId":"1","lemma":"축구","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"축구","audio":"/audio/c21dee4a35ad739ca03e.mp3"}},{"text":"얘기죠.","meaning":"聊天","explanation":"얘기：聊天；이다：表示“是”的判断形式。；죠：礼貌地确认、提醒或表达意愿；죠 是 지요 的缩略。","readings":[{"term":"얘기","audio":"/audio/cbb7c3fe2dd88ddc7d2b.mp3"}],"sources":[{"entryId":"74194","senseId":"2","lemma":"얘기","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"얘기죠","audio":"/audio/3732b9491692361824fc.mp3"}}],"words":[{"id":"828c4030dd68aa7b","term":"요즘","zh":"最近，近来，这阵子","audio":"/audio/828c4030dd68aa7bc886.mp3","entryId":"20250","definition":"从非常近的过去到现在之间。","pronunciation":["요즘"]},{"id":"97b8be84b3d009c4","term":"최고","zh":"最；最佳","audio":"/audio/97b8be84b3d009c4b9b1.mp3","entryId":"47976","definition":"最好或最出色的。","pronunciation":["최ː고","췌ː고"]},{"id":"1fec9cf26820bfd4","term":"화두","zh":"话头，话题","audio":"/audio/1fec9cf26820bfd4f87d.mp3","entryId":"87979","definition":"感兴趣、觉得很重要或值得说的东西。","pronunciation":["화두"]},{"id":"d0bd7c9c7885ea24","term":"월드컵","zh":"世界杯","audio":"/audio/d0bd7c9c7885ea24880f.mp3","entryId":"69987","definition":"每四年举行一次的国际体育大会；或指此大会的奖杯。","pronunciation":[]},{"id":"c21dee4a35ad739c","term":"축구","zh":"足球","audio":"/audio/c21dee4a35ad739ca03e.mp3","entryId":"36700","definition":"由11人组成一队，主要用脚或头把球打入对方球门的比赛，进球多的一方获胜。","pronunciation":["축꾸"]},{"id":"cbb7c3fe2dd88ddc","term":"얘기","zh":"聊天","audio":"/audio/cbb7c3fe2dd88ddc7d2b.mp3","entryId":"74194","definition":"和他人交替着说话。","pronunciation":["얘ː기"]}],"audio":"/audio/39827ba05390e6a23c1f.mp3","speakerIndex":1}],"difficulty":2.582,"source":{"url":"https://krdict.korean.go.kr/chn/dicSearch/SearchView?ParaWordNo=87979","label":"国立国语院韩国语—汉语学习词典","license":"https://creativecommons.org/licenses/by-sa/2.0/kr