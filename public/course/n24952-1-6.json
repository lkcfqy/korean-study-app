":["넘ː따"]}],"audio":"/audio/24855fe03e7b3d33094f.mp3","speakerIndex":1}],"difficulty":2.959,"source":{"url":"https://krdict.korean.go.kr/chn/dicSearch/SearchView?ParaWordNo=24952","label":"国立国语院韩国语—汉语学习词典","license":"https://creativecommons.org/licenses/by-sa/2.0/kr/"},"sourceSenseId":"1","sourceLevel":"중급","day":102,"sequenceScore":2.6843,"questions":[{"lineIndex":0,"options":["哎呀，我们女儿都懂事了。还会替妈妈操心呢。","那当然啦。我现在也已经二十多岁了呀。","妈妈，我肚子疼得厉害，还一直在腹泻。"],"answer":0},{"lineIndex":1,"options":["哎呀，我们女儿都懂事了。还会替妈妈操心呢。","那当然啦。我现在也已经二十多岁了呀。","妈妈，我肚子疼得厉害，还一直在腹泻。"],"answer":1}]}
