ronunciation":["대ː하다"]},{"id":"a705e43b436456e8","term":"교육열","zh":"教育热，教育积极性","audio":"/audio/a705e43b436456e8d688.mp3","entryId":"35117","definition":"对教育的热情。","pronunciation":["교ː융녈"]},{"id":"a89a72f50dfdf2da","term":"대단하다","zh":"很出色，很杰出","audio":"/audio/a89a72f50dfdf2daf4dc.mp3","entryId":"46607","definition":"非常突出。","pronunciation":["대ː단하다"]}],"audio":"/audio/7cff8687ab624bf453de.mp3","speakerIndex":1}],"difficulty":3.47,"source":{"url":"https://krdict.korean.go.kr/chn/dicSearch/SearchView?ParaWordNo=35117","label":"国立国语院韩国语—汉语学习词典","license":"https://creativecommons.org/licenses/by-sa/2.0/kr/"},"sourceSenseId":"1","sourceLevel":"고급","day":167,"sequenceScore":3.2967,"questions":[{"lineIndex":0,"options":["您对子女的教育投入真是非常大啊。","听说财产税的缴纳截止日期是30号呢。","就算经济形势多困难，孩子的教育费用也是不能削减的。"],"answer":2},{"lineIndex":1,"options":["您对子女的教育投入真是非常大啊。","就算经济形势多困难，孩子的教育费用也是不能削减的。","听说财产税的缴纳截止日期是30号呢。"],"answer":0}]}
