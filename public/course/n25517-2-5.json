dc.mp3"}],"sources":[{"entryId":"27500","senseId":"12","lemma":"가다","origin":"NIKL Korean-Chinese dictionary"}]},{"text":"맛이","meaning":"味，味道","explanation":"맛：味，味道；이：主格助词，标记主语。","readings":[{"term":"맛","audio":"/audio/2bc64d401ca15bdf9987.mp3"}],"sources":[{"entryId":"66228","senseId":"1","lemma":"맛","origin":"NIKL Korean-Chinese dictionary"}]},{"text":"괜찮아.","meaning":"不错","explanation":"괜찮다：不错；어：非敬语句末；与熟悉的人或晚辈交谈，语调决定陈述、询问等语气。","readings":[{"term":"괜찮다","audio":"/audio/b9a2699f824000e36e45.mp3"}],"sources":[{"entryId":"60097","senseId":"1","lemma":"괜찮다","origin":"NIKL Korean-Chinese dictionary"}]}],"words":[{"id":"1a8b5723b01cfd93","term":"저기","zh":"那里，那儿","audio":"/audio/1a8b5723b01cfd9368f8.mp3","entryId":"71218","definition":"指代离说话人或听话人很远的地方。","pronunciation":["저기"]},{"id":"9436efc2c3513615","term":"모퉁이","zh":"转角，拐角","audio":"/audio/9436efc2c3513615fd9f.mp3","entryId":"16148","definition":"转弯或折过去的地方。","pronunciation":["모퉁이"]},{"id":"96fe52db2531c9e7","term":"있다","zh":"有","audio":"/audio/96fe52db2531c9e73e53.mp3","entryId":"68797","definition":"人或动物、物体等存在的状态。","pronunciation":["읻따"]},{"id":"c013538e549a4ded","term":"가게","zh":"店，店铺，商店","audio":"/audio/c013538e549a4dedbd4a.mp3","entryId":"17287","definition":"铺放着东西来售卖的小规模铺子。","pronunciation":["가ː게"]},{"id":"1098bbe54520ab2a","term":"나","zh":"我","audio":"/audio/1098bbe54520ab2a367c.mp3","entryId":"60931","definition":"说话人在朋友或晚辈面前用来指称自己。","pronunciation":["나"]},{"id":"b977a98206ae1f48","term":"곧잘","zh":"时常","audio":"/audio/b977a98206ae1f485e78.mp3","entryId":"25517","definition":"常常，经常。","pronunciation":["곧짤"]},{"id":"233cb510410b09d6","term":"가다","zh":"持续，维续","audio":"/audio/233cb510410b09d69cdc.mp3","entryId":"27500","definition":"维持某种现象或状态。","pronunciation":["가다"]},{"id":"2bc64d401ca15bdf","term":"맛","zh":"味，味道","audio":"/audio/2bc64d401ca15bdf9987.mp3","entryId":"66228","definition":"用舌头接触食物等时得到的感觉。","pronunciation":["맏"]},{"id":"b9a2699f824000e3","term":"괜찮다","zh":"不错","audio":"/audio/b9a2699f824000e36e45.mp3",