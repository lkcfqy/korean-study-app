inese dictionary"}],"surfaceReading":{"term":"응","audio":"/audio/107dd01c3d38a368ad44.mp3"}},{"text":"교통비가","meaning":"交通费，车费","explanation":"교통비：交通费，车费；가：主格助词，标记主语。","readings":[{"term":"교통비","audio":"/audio/61a6f8353ab350bb85f9.mp3"}],"sources":[{"entryId":"35967","senseId":"1","lemma":"교통비","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"교통비가","audio":"/audio/516abb769968cae594bb.mp3"}},{"text":"그","meaning":"那个","explanation":"그：那个。","readings":[{"term":"그","audio":"/audio/38c61820e786f2346e96.mp3"}],"sources":[{"entryId":"43883","senseId":"1","lemma":"그","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"그","audio":"/audio/38c61820e786f2346e96.mp3"}},{"text":"정도밖에","meaning":"程度","explanation":"정도：程度；밖에：与否定表达合用，表示“只有、除……之外没有”。","readings":[{"term":"정도","audio":"/audio/1a771e4b7f99176bc0a6.mp3"}],"sources":[{"entryId":"70876","senseId":"1","lemma":"정도","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"정도밖에","audio":"/audio/6f93a133a38ee9676cea.mp3"}},{"text":"안","meaning":"不","explanation":"안：不。","readings":[{"term":"안","audio":"/audio/bc00bc8172c83d5fab70.mp3"}],"sources":[{"entryId":"71372","senseId":"1","lemma":"안","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"안","audio":"/audio/bc00bc8172c83d5fab70.mp3"}},{"text":"드는","meaning":"需要，花费","explanation":"들다：需要，花费；-는：将前面的动作或状态转为修饰名词的形式。","readings":[{"term":"들다","audio":"/audio/7ff37822e89462ea5014.mp3"}],"sources":[{"entryId":"71686","senseId":"6","lemma":"들다","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"드는","audio":"/audio/1e872f3e070346684a65.mp3"}},{"text":"셈이지.","meaning":"算是","explanation":"셈：算是；이다：表示“是”的判断形式；지：表示确认、提醒、意愿或自问等，非敬语句末。","readings":[{"term":"셈","audio":"/audio/8251fcfdf37bbf0e6a18.mp3"}],"sources":[{"entryId":"90338","senseId":"1","lemma":"셈","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"셈이지","audio":"/audio/c657e584cafc77302d71.mp3"}}],"words":[{"id":"107dd01c3d