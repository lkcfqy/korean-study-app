e73e53.mp3"}],"sources":[{"entryId":"68797","senseId":"2","lemma":"있다","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"있을까요","audio":"/audio/ef6f1745d773e6085ac3.mp3"}}],"words":[{"id":"a109dcd7f6f11c2e","term":"회사","zh":"公司，企业，会社","audio":"/audio/a109dcd7f6f11c2e1703.mp3","entryId":"31668","definition":"想要通过事业获得利益的许多人一起建立的法人团体。","pronunciation":["회ː사","훼ː사"]},{"id":"e44b07ac25b977cc","term":"근처","zh":"附近，近处","audio":"/audio/e44b07ac25b977cc36e5.mp3","entryId":"62061","definition":"以某场所、东西或人为中心，较近的地方。","pronunciation":["근ː처"]},{"id":"653161c326427f17","term":"깨끗하다","zh":"洁净，干净","audio":"/audio/653161c326427f17a781.mp3","entryId":"60323","definition":"事物不脏。","pronunciation":["깨끄타다"]},{"id":"c3522148de6accd3","term":"저렴하다","zh":"便宜","audio":"/audio/c3522148de6accd3068c.mp3","entryId":"74099","definition":"价格低廉。","pronunciation":["저ː렴하다"]},{"id":"9dc94a9d71345356","term":"아파트","zh":"公寓","audio":"/audio/9dc94a9d71345356674e.mp3","entryId":"29610","definition":"为使多家住户可以独立地居住在同一栋高大的建筑物内而建造的住宅。","pronunciation":[]},{"id":"96fe52db2531c9e7","term":"있다","zh":"有","audio":"/audio/96fe52db2531c9e73e53.mp3","entryId":"68797","definition":"事实或现象存在。","pronunciation":["읻따"]}],"audio":"/audio/234405b7aafad0811579.mp3","speakerIndex":0},{"id":"n65843-2-8-2","ko":"근처 부동산에 한번 가 보세요.","zh":"去附近的房产中介看看吧。","note":"点不懂的词，看本句词义、助词和语尾；听词语后，再听整句。","parts":[{"text":"근처","meaning":"附近，近处","explanation":"근처：附近，近处。","readings":[{"term":"근처","audio":"/audio/e44b07ac25b977cc36e5.mp3"}],"sources":[{"entryId":"62061","senseId":"1","lemma":"근처","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"근처","audio":"/audio/e44b07ac25b977cc36e5.mp3"}},{"text":"부동산에","meaning":"房地产中介","explanation":"부동산：房地产中介；에：格助词，表示时间、位置、去向、对象等；需结合整句理解。","readings":[{"term":"부동산","audio":"/audio/94a50d40a977f2418c4e.mp3"}],"sources":[{"entryId":"65843","senseId":"2","lemma":"부동산","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"부동산에","audio":"/audio/ebb9b09937e31800