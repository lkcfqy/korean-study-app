/507d49525969631fdfb3.mp3"}],"sources":[{"entryId":"73842","senseId":"1","lemma":"자손","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"자손들이","audio":"/audio/389cc3c9825c4522a847.mp3"}},{"text":"대대로","meaning":"世代，祖传","explanation":"대대로：世代，祖传","readings":[{"term":"대대로","audio":"/audio/44ccd1066ad6081f8656.mp3"}],"sources":[{"entryId":"48467","senseId":"1","lemma":"대대로","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"대대로","audio":"/audio/44ccd1066ad6081f8656.mp3"}},{"text":"잘된다는","meaning":"有出息","explanation":"잘되다：有出息；ㄴ다는：引用陈述内容并修饰后面的名词。","readings":[{"term":"잘되다","audio":"/audio/2bf32329a9311a6d9b04.mp3"}],"sources":[{"entryId":"62302","senseId":"3","lemma":"잘되다","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"잘된다는","audio":"/audio/68a10ff0585e97db7a89.mp3"}},{"text":"명당이죠.","meaning":"风水宝地","explanation":"명당：风水宝地；이다：表示“是”的判断形式。；죠：礼貌地确认、提醒或表达意愿；죠 是 지요 的缩略。","readings":[{"term":"명당","audio":"/audio/34f31624e52ec8b8e672.mp3"}],"sources":[{"entryId":"55267","senseId":"1","lemma":"명당","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"명당이죠","audio":"/audio/62862cc24604c12b30ac.mp3"}}],"words":[{"id":"507d49525969631f","term":"자손","zh":"子孙","audio":"/audio/507d49525969631fdfb3.mp3","entryId":"73842","definition":"子女和孙子。","pronunciation":["자손"]},{"id":"44ccd1066ad6081f","term":"대대로","zh":"世代，祖传","audio":"/audio/44ccd1066ad6081f8656.mp3","entryId":"48467","definition":"从古至今已过好几代，一直在持续。","pronunciation":["대ː대로"]},{"id":"2bf32329a9311a6d","term":"잘되다","zh":"有出息","audio":"/audio/2bf32329a9311a6d9b04.mp3","entryId":"62302","definition":"人非常优秀或成功。","pronunciation":["잘되다","잘뒈다"]},{"id":"34f31624e52ec8b8","term":"명당","zh":"风水宝地","audio":"/audio/34f31624e52ec8b8e672.mp3","entryId":"55267","definition":"在风水地理学中，认为能给子孙带来好运的宅子或墓地的位置。","pronunciation":["명당"]}],"audio":"/audio/ae9bf41672f21a5d7485.mp3","speakerIndex":1}],"difficulty":3.303,"source":{"url":"https://krdict.korean.go.kr/chn/dicSearch/Search