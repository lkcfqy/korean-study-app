":"있다","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"있었어요","audio":"/audio/7e975037a8edd21f2556.mp3"}}],"words":[{"id":"dcc5631045195633","term":"온","zh":"全，整个","audio":"/audio/dcc56310451956332238.mp3","entryId":"67836","definition":"全部的；或全体的。","pronunciation":["온ː"]},{"id":"f97ccdfe641c2837","term":"동네","zh":"小区，社区，村庄","audio":"/audio/f97ccdfe641c28373e6c.mp3","entryId":"62417","definition":"多户人家聚集在一起生活的地方。","pronunciation":["동ː네"]},{"id":"c8538160095642a2","term":"어수선하다","zh":"纷乱、不安定（周围气氛）","audio":"/audio/c8538160095642a2a5bd.mp3","entryId":"67032","definition":"纷乱、不安定（周围气氛）","pronunciation":["어수선하다"]},{"id":"41abb599007a8f8a","term":"무슨","zh":"什么","audio":"/audio/41abb599007a8f8a3050.mp3","entryId":"66237","definition":"用于询问不确定或不知道的事情、对象、东西等。","pronunciation":["무슨"]},{"id":"dfc76879e2f5c3ea","term":"일","zh":"事情","audio":"/audio/dfc76879e2f5c3ead091.mp3","entryId":"91895","definition":"所处的情形或状况。","pronunciation":["일ː"]},{"id":"96fe52db2531c9e7","term":"있다","zh":"有","audio":"/audio/96fe52db2531c9e73e53.mp3","entryId":"68797","definition":"事实或现象存在。","pronunciation":["읻따"]}],"audio":"/audio/18d13559ceb0fc6d3193.mp3","speakerIndex":0},{"id":"n67836-1-11-2","ko":"아까 큰길 앞 가게에 불이 났었어요.","zh":"刚才大马路前的商店着火了。","note":"点不懂的词，看本句词义、助词和语尾；听词语后，再听整句。","parts":[{"text":"아까","meaning":"刚才，方才，刚刚","explanation":"아까：刚才，方才，刚刚。","readings":[{"term":"아까","audio":"/audio/5dbe3d17e9e854897ec5.mp3"}],"sources":[{"entryId":"65974","senseId":"1","lemma":"아까","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"아까","audio":"/audio/5dbe3d17e9e854897ec5.mp3"}},{"text":"큰길","meaning":"大道","explanation":"큰길：大道。","readings":[{"term":"큰길","audio":"/audio/319688b45ab65c19f38d.mp3"}],"sources":[{"entryId":"72173","senseId":"2","lemma":"큰길","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"큰길","audio":"/audio/319688b45ab65c19f38d.mp3"}},{"text":"앞","meaning":"前，前面","explanation":"앞：前，前面。","readings":[{"term":"앞","audio":"/audio/ec1a6b96ce