dio/f8352cb996e01c9597d9.mp3"}},{"text":"수","meaning":"可以，可能","explanation":"수：可以，可能","readings":[{"term":"수","audio":"/audio/dcd19f5b5caac9771378.mp3"}],"sources":[{"entryId":"15615","senseId":"1","lemma":"수","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"수","audio":"/audio/dcd19f5b5caac9771378.mp3"}},{"text":"있나요?","meaning":"能、可以（-ㄹ/을 수 있다）","explanation":"있다：能、可以（-ㄹ/을 수 있다）；나요：礼貌、委婉地询问。","readings":[{"term":"있다","audio":"/audio/96fe52db2531c9e73e53.mp3"}],"sources":[{"entryId":"68797","senseId":"5","lemma":"있다","origin":"NIKL Korean-Chinese dictionary"}],"surfaceReading":{"term":"있나요","audio":"/audio/0eb260e471116d837abb.mp3"}}],"words":[{"id":"f7c6efa694aaef95","term":"그렇다","zh":"那样","audio":"/audio/f7c6efa694aaef9559bd.mp3","entryId":"61178","definition":"表示状态、样子、性质等与此相同。","pronunciation":["그러타"]},{"id":"86f87d3fb9919f14","term":"그럼","zh":"那么，既然那样","audio":"/audio/86f87d3fb9919f145d21.mp3","entryId":"60346","definition":"用于表示接受前文内容，或以前文为基础，提出新的主张。","pronunciation":["그럼"]},{"id":"c1ee1b7e560f9f3a","term":"어디","zh":"哪里，哪儿","audio":"/audio/c1ee1b7e560f9f3ac3bf.mp3","entryId":"60319","definition":"指代不知道的处所。","pronunciation":["어디"]},{"id":"10c7c905412d5254","term":"담배","zh":"烟，香烟","audio":"/audio/10c7c905412d52542ee4.mp3","entryId":"63662","definition":"把晒干的烟叶切成细条用纸卷起，制成点火后供吸入其烟雾的物品。","pronunciation":["담ː배"]},{"id":"6e1ba3221dbae36d","term":"피우다","zh":"吸，抽","audio":"/audio/6e1ba3221dbae36d0573.mp3","entryId":"73272","definition":"给某个物质点上火，把冒出的烟吸入之后又吐出来。","pronunciation":["피우다"]},{"id":"dcd19f5b5caac977","term":"수","zh":"可以，可能","audio":"/audio/dcd19f5b5caac9771378.mp3","entryId":"15615","definition":"做某事的能力，或某事发生的可能性。","pronunciation":["수"]},{"id":"96fe52db2531c9e7","term":"있다","zh":"能、可以（-ㄹ/을 수 있다）","audio":"/audio/96fe52db2531c9e73e53.mp3","entryId":"68797","definition":"能、可以（-ㄹ/을 수 있다）","pronunciation":["읻따"]}],"audio":"/audio/7458120df2cced637834.mp3","speakerIndex":1}],"difficulty":3.15,"source":{"url":"https://krdict.korean.go.kr/chn/dic